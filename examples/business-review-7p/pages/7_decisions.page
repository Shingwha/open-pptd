    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 15
      bold: true
      color: "$text"
      align: [left, middle]
      text: 批准 2026 年研发预算追加 800 万元

  - elementId: a2-desc
    elementType: text
    bounds: [138, 332, 520, 18]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 10.5
      color: "$muted"
      align: [left, top]
      text: 投入订阅产品线 V4.0 与客户成功系统建设

  - elementId: a2-owner
    elementType: text
    bounds: [680, 306, 220, 42]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 10.5
      color: "$muted"
      lineHeight: 1.6
      align: [right, top]
      text: |
        <p style="text-align:right"><span style="color:$text;"><strong>决策:董事会</strong></span></p>
        <p style="text-align:right">截止:2 月 20 日</p>

  - elementId: sep-2
    elementType: shape
    bounds: [60, 372, 840, 1]
