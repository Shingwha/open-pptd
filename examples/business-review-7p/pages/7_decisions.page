  - elementId: a3-owner
    elementType: text
    bounds: [680, 390, 220, 42]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 10.5
      color: "$muted"
      lineHeight: 1.6
      align: [right, top]
      text: |
        <p style="text-align:right"><span style="color:$text;"><strong>决策:经管会</strong></span></p>
        <p style="text-align:right">截止:3 月 1 日</p>

  # —— 页脚 ——
  - elementId: footer-line
    elementType: shape
    bounds: [60, 462, 840, 1]
    shapeName: rect
    fill: { type: solid, color: "$line" }

  - elementId: footer-left
    elementType: text
    bounds: [60, 474, 560, 16]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 9.5
      color: "$muted"
      align: [left, middle]
      text: 下一次复盘:2026 年 7 月 8 日 · Q2 经营复盘会|演示占位数据 · 请替换为实际口径

  - elementId: thanks
    elementType: text
    bounds: [640, 470, 260, 24]
    content:
      fontFamily: "Alimama ShuHeiTi"
      fontSize: 16
      bold: true
      color: "$primary"
      align: [right, middle]
      text: 感谢审议 · THANK YOU
