    fill: { type: solid, color: "$line" }

  # —— 请求 03 ——
  - elementId: a3-number
    elementType: text
    bounds: [60, 388, 44, 28]
    content:
      fontFamily: "Alimama ShuHeiTi"
      fontSize: 22
      bold: true
      color: "$accent"
      align: [left, top]
      text: 03

  - elementId: a3-icon
    elementType: icon
    bounds: [110, 392, 18, 18]
    iconName: "fas:handshake"
    fill: { type: solid, color: "$accent" }

  - elementId: a3-title
    elementType: text
    bounds: [138, 390, 500, 24]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 15
      bold: true
      color: "$text"
