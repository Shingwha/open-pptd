  - elementId: river-active
    elementType: shape
    bounds: [413, 496, 10, 10]
    shapeName: diamond
    fill: { type: solid, color: "$gold" }

  - elementId: river-station
    elementType: text
    bounds: [348, 512, 140, 15]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 10.5
      bold: true
      color: "$gold"
      align: [center, top]
      text: K3 · 干流与支流
