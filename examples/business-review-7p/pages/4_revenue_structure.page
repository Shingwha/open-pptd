pageType: content
background:
  type: solid
  color: "$paper"
notes: |
  讲解建议：左图是流域图——干流（SaaS 订阅）承载 58% 的水量且仍在涨水（+9pct），两条支流主动收窄；右下分河段水位表把华东续约率 78% 的问题点透，为下一站险滩勘测做铺垫。
elements:
  - elementId: eyebrow
    elementType: text
    bounds: [60, 40, 400, 18]
    content:
      style: "$eyebrow"
      align: [left, middle]
      text: 远川 2025 · 水文年报

  - elementId: meta-right
    elementType: text
    bounds: [600, 40, 300, 18]
    content:
      style: "$small"
      fontSize: 10
      align: [right, middle]
      text: 里程 K3 / K7

  - elementId: station-title
    elementType: text
    bounds: [60, 62, 600, 46]
    content:
      fontFamily: "Source Han Serif CN"
      fontSize: 30
      bold: true
      color: "$ink"
      align: [left, middle]
      wrap: false
      text: |
        <p><span style="color:$gold;">K3</span>　干流与支流</p>

  - elementId: conclusion
    elementType: text
    bounds: [60, 116, 840, 24]
    content:
      style: "$subtitle"
      align: [left, middle]
      text: 干流（SaaS 订阅）承载 58% 水量且持续涨水；支流（项目制、专业服务）主动收窄，水质优于水量。

  - elementId: header-rule
    elementType: shape
    bounds: [60, 152, 840, 1]
    shapeName: rect
    fill: { type: solid, color: "$line" }

  # —— 左：流域图（收入结构环形图）——
  - elementId: left-heading
    elementType: text
    bounds: [60, 164, 400, 26]
    content:
      fontFamily: "Source Han Serif CN"
      fontSize: 15
      bold: true
      color: "$ink"
      align: [left, middle]
      text: 流域图：水量构成（收入占比）

  - elementId: revenue-mix
    elementType: chart
    bounds: [60, 194, 400, 280]
    fill: { type: solid, color: "$paper" }
    data:
      cols: [收入类型, 占比]
      rows:
        - [干流 · SaaS订阅, 58]
        - [支流 · 项目交付, 27]
        - [支流 · 专业服务, 15]
    legend:
      show: true
      position: bottom
      fontSize: 11
      color: "$ink"
    fontFamily: "LXGW Neo XiHei"
    series:
      - type: pie
        encode: { category: 收入类型, value: 占比 }
        innerRadius: 0.62
        fill: ["$deep", "$aqua", "$gold"]
        border: { style: solid, width: 2, color: "$paper" }
        dataLabels: { show: true, content: percentage, numberFormat: "0%", color: "$ink", fontSize: 12 }

  # —— 右：同比水位变化 + 分河段水位表 ——
  - elementId: right-heading
    elementType: text
    bounds: [500, 164, 400, 26]
    content:
      fontFamily: "Source Han Serif CN"
      fontSize: 15
      bold: true
      color: "$ink"
      align: [left, middle]
      text: 水文观测：同比水位变化

  - elementId: mix-detail
    elementType: text
    bounds: [500, 198, 400, 122]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 12
      color: "$ink"
      lineHeight: 1.9
      align: [left, top]
      text: |
        <p><span style="font-size:20px; color:$deep; font-family:Source Han Serif CN;">58%</span>　干流 · SaaS 订阅　<span style="color:$aqua;">+9pct</span></p>
        <p><span style="font-size:20px; color:$aqua; font-family:Source Han Serif CN;">27%</span>　支流 · 项目交付　<span style="color:$muted;">-4pct</span></p>
        <p><span style="font-size:20px; color:$gold; font-family:Source Han Serif CN;">15%</span>　支流 · 专业服务　<span style="color:$muted;">-5pct</span></p>

  - elementId: table-heading
    elementType: text
    bounds: [500, 336, 400, 24]
    content:
      fontFamily: "Source Han Serif CN"
      fontSize: 15
      bold: true
      color: "$ink"
      align: [left, middle]
      text: 分河段水位：区域续约率实测

  - elementId: renewal-table
    elementType: table
    bounds: [500, 366, 400, 108]
    columnWidths: [0.34, 0.33, 0.33]
    rowHeights: [0.25, 0.25, 0.25, 0.25]
    style: "$default"
    rows:
      - - text: 河段
        - text: 实测水位
        - text: 警戒线
      - - text: 华东
        - text: 78%
          color: "$rust"
          bold: true
        - text: 85%
          color: "$muted"
      - - text: 华南
        - text: 86%
          color: "$deep"
          bold: true
        - text: 85%
          color: "$muted"
      - - text: 华北
        - text: 91%
          color: "$deep"
          bold: true
        - text: 85%
          color: "$muted"

  # —— 河流里程线 K0–K7 ——
  - elementId: river-base
    elementType: shape
    bounds: [48, 501, 864, 1]
    shapeName: rect
    fill: { type: solid, color: "$line" }

  - elementId: river-tick-0
    elementType: shape
    bounds: [48, 497, 1, 8]
    shapeName: rect
    fill: { type: solid, color: "$muted" }
    opacity: 0.55
  - elementId: river-tick-1
    elementType: shape
    bounds: [171, 497, 1, 8]
    shapeName: rect
    fill: { type: solid, color: "$muted" }
    opacity: 0.55
  - elementId: river-tick-2
    elementType: shape
    bounds: [295, 497, 1, 8]
    shapeName: rect
    fill: { type: solid, color: "$muted" }
    opacity: 0.55
  - elementId: river-tick-4
    elementType: shape
    bounds: [542, 497, 1, 8]
    shapeName: rect
    fill: { type: solid, color: "$muted" }
    opacity: 0.55
  - elementId: river-tick-5
    elementType: shape
    bounds: [665, 497, 1, 8]
    shapeName: rect
    fill: { type: solid, color: "$muted" }
    opacity: 0.55
  - elementId: river-tick-6
    elementType: shape
    bounds: [789, 497, 1, 8]
    shapeName: rect
    fill: { type: solid, color: "$muted" }
    opacity: 0.55
  - elementId: river-tick-7
    elementType: shape
    bounds: [912, 497, 1, 8]
    shapeName: rect
    fill: { type: solid, color: "$muted" }
    opacity: 0.55

  - elementId: river-label-0
    elementType: text
    bounds: [28, 480, 40, 12]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 9
      color: "$muted"
      align: [center, bottom]
      text: K0
  - elementId: river-label-1
    elementType: text
    bounds: [151, 480, 40, 12]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 9
      color: "$muted"
      align: [center, bottom]
      text: K1
  - elementId: river-label-2
    elementType: text
    bounds: [275, 480, 40, 12]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 9
      color: "$muted"
      align: [center, bottom]
      text: K2
  - elementId: river-label-4
    elementType: text
    bounds: [522, 480, 40, 12]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 9
      color: "$muted"
      align: [center, bottom]
      text: K4
  - elementId: river-label-5
    elementType: text
    bounds: [645, 480, 40, 12]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 9
      color: "$muted"
      align: [center, bottom]
