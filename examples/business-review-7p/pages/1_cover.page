pageType: cover
background:
  type: solid
  color: "$deep"
notes: |
  开场建议：把公司比作一条河，今天汇报的是它 2025 年的水文年报。先给三个读数：流量（收入）达成 96.8%，水位（经营性现金流）三年来首次回正 +3,200 万，险滩在华东——续约率 78%，距 85% 警戒线差 7 个刻度。底部这条线是河流里程线，从 K0 源头出发，到 K7 入海口结束，每一站对应一页。
elements:
  # —— 背景层次：巨型「川」字 ——
  - elementId: bg-chuan
    elementType: text
    bounds: [524, 18, 420, 440]
    opacity: 0.55
    content:
      fontFamily: "Source Han Serif CN"
      fontSize: 330
      bold: true
      color: "#1B4A3E"
      align: [center, middle]
      wrap: false
      text: 川

  # —— 水文站铭牌框 ——
  - elementId: plate-frame
    elementType: shape
    bounds: [28, 28, 904, 446]
    shapeName: rect
    border: { style: solid, width: 1, color: "$gold" }
    opacity: 0.55

  - elementId: eyebrow
    elementType: text
    bounds: [64, 56, 520, 20]
    content:
      style: "$eyebrow"
      letterSpacing: 4
      align: [left, middle]
      text: 远川科技 · 2025 水文年报

  - elementId: meta-right
    elementType: text
    bounds: [560, 56, 336, 20]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 10
      color: "$foam"
      letterSpacing: 1
      align: [right, middle]
