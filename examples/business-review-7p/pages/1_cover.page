pageType: cover
background:
  type: solid
  color: "$bg"
notes: |
  开场:今天用一份高密度简报向各位汇报远川 2025。先给四个读数——收入达成 96.8%、增速 +14.2%、经营性现金流三年来首次转正 +3,200 万,以及唯一低于警戒线的读数:华东续约率 78%。全篇七页,先讲清全年怎么样,再讲三个结构性问题和 2026 怎么打,最后一页是三项待决议事项。
elements:
  # —— 背景层次:巨号 2025(浅青水印) ——
  - elementId: bg-year
    elementType: text
    bounds: [470, 96, 430, 360]
    content:
      fontFamily: "Alimama ShuHeiTi"
      fontSize: 185
      bold: true
      color: "#E8F3F0"
      align: [right, middle]
      wrap: false
      text: 2025

  # —— 页眉 ——
  - elementId: eyebrow
    elementType: text
    bounds: [60, 40, 420, 18]
    content:
      style: "$eyebrow"
      align: [left, middle]
      text: 远川科技 · YUANCHUAN TECH

  - elementId: meta-right
    elementType: text
    bounds: [560, 41, 300, 14]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 9.5
      color: "$muted"
      letterSpacing: 2
      align: [right, middle]
      text: 董事会简报 · BOARD BRIEF

  - elementId: badge-rect
    elementType: shape
    bounds: [874, 34, 26, 26]
    shapeName: rect
    fill: { type: solid, color: "$primary" }

  - elementId: badge-num
    elementType: text
    bounds: [874, 34, 26, 26]
    content:
      fontFamily: "Alimama ShuHeiTi"
      fontSize: 11
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: 01

  # —— 主标题区 ——
  - elementId: gold-rule
    elementType: shape
    bounds: [60, 96, 48, 4]
    shapeName: rect
    fill: { type: solid, color: "$accent" }

  - elementId: hero-title
    elementType: text
    bounds: [56, 118, 720, 92]
    content:
      fontFamily: "Alimama ShuHeiTi"
      fontSize: 62
      bold: true
      color: "$primary"
      letterSpacing: 2
      align: [left, middle]
      wrap: false
      text: 2025 年度经营复盘

  - elementId: hero-subtitle
    elementType: text
    bounds: [60, 216, 480, 30]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 18
      color: "$text"
      letterSpacing: 1
      align: [left, middle]
      text: 与 2026 年增长策略

  - elementId: hero-note
    elementType: text
    bounds: [60, 248, 480, 18]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 11
      color: "$accent"
      align: [left, middle]
      text: 经营管理层汇报 · 报告期 2025.01 — 2025.12

