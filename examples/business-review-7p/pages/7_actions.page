      lineHeight: 1.5
      align: [left, top]
      text: |
        <p><strong>批准华东客户成功团队扩编（3 → 8 人）</strong></p>
        <p style="margin-top:3px"><span style="font-size:11.5px; color:$foam;">新增年化成本约 240 万元，预计拉动续约率 +7 个百分点</span></p>

  - elementId: a1-owner
    elementType: text
