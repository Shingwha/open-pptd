pageType: final
background:
  type: solid
  color: "$deep"
notes: |
  收尾建议：河流抵达入海口，回到“需要管理层做什么”。三项请求逐项确认责任人与截止时间：扩编（2月10日）、研发预算追加 800 万（2月20日）、渠道佣金方案（3月1日），避免汇报结束但没有决策。下一次水文观测定在 7月8日 Q2 复盘会。
elements:
  # —— 背景层次：巨型「海」字，呼应封面「川」——
  - elementId: bg-hai
    elementType: text
    bounds: [524, 18, 420, 440]
    opacity: 0.55
    content:
      fontFamily: "Source Han Serif CN"
      fontSize: 330
      bold: true
      color: "#1B4A3E"
      align: [center, middle]
      wrap: false
      text: 海

  # —— 铭牌框（与封面同位）——
  - elementId: plate-frame
    elementType: shape
    bounds: [28, 28, 904, 446]
    shapeName: rect
    border: { style: solid, width: 1, color: "$gold" }
    opacity: 0.55

  - elementId: eyebrow
    elementType: text
    bounds: [64, 56, 520, 20]
    content:
      style: "$eyebrow"
      letterSpacing: 4
      align: [left, middle]
      text: 远川科技 · 2025 水文年报

  - elementId: meta-right
    elementType: text
    bounds: [560, 56, 336, 20]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 10
      color: "$foam"
      letterSpacing: 1
      align: [right, middle]
      text: 里程 K7 / K7 · 抵达入海口

  - elementId: station-title
    elementType: text
    bounds: [64, 90, 620, 52]
    content:
      fontFamily: "Source Han Serif CN"
      fontSize: 34
      bold: true
      color: "$paper"
      align: [left, middle]
      wrap: false
      text: |
        <p><span style="color:$gold;">K7</span>　入海口 · 灯塔下的请求</p>

  - elementId: conclusion
    elementType: text
    bounds: [64, 152, 760, 24]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 13
      color: "$foam"
      align: [left, middle]
      text: 河流抵达入海口。请管理层为三项资源请求放行，让 2026 的水继续向前。

  - elementId: header-rule
    elementType: shape
    bounds: [64, 192, 832, 1]
    shapeName: rect
    fill: { type: solid, color: "$gold" }
    opacity: 0.5

  # —— 请求壹 ——
  - elementId: a1-number
    elementType: text
    bounds: [64, 208, 56, 46]
    content:
      fontFamily: "Source Han Serif CN"
      fontSize: 24
      bold: true
