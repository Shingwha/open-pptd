      fontFamily: "Source Han Serif CN"
      fontSize: 20
      bold: true
      color: "$text"
      lineHeight: 1.5
      align: [left, middle]
      text: 经营性现金流转正

  - elementId: detail-3
    elementType: text
    bounds: [680, 370, 220, 52]
