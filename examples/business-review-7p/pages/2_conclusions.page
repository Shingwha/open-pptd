  - elementId: headline-4
    elementType: text
    bounds: [326, 462, 336, 62]
    content:
      fontFamily: "Source Han Serif CN"
      fontSize: 20
      bold: true
      color: "$text"
      lineHeight: 1.5
      align: [left, middle]
      text: 华东区续约率

  - elementId: detail-4
