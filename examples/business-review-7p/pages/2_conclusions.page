    bounds: [680, 274, 220, 52]
    content:
      style: "$small"
      lineHeight: 1.55
      align: [left, top]
      text: 增长主要由高毛利 SaaS 订阅驱动，项目制收入主动收缩。

  - elementId: badge-3
