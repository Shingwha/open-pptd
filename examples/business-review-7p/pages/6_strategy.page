    columnWidths: [0.24, 0.19, 0.19, 0.19, 0.19]
    rowHeights: [0.22, 0.26, 0.26, 0.26]
    style: "$default"
    rows:
      - - text: 工程
        - text: Q1
        - text: Q2
        - text: Q3
        - text: Q4
      - - text: 续约攻坚
          bold: true
        - text: 团队 3→8 到位
        - text: 续约率 82%
        - text: 续约率 85%
        - text: 续约率 88%
      - - text: 订阅深耕
          bold: true
        - text: 新定价上线
        - text: V4.0 发布
        - text: ARR +20%
        - text: ARR +35%
      - - text: 获客提效
          bold: true
        - text: 渠道结构审计
        - text: CAC ≤1.6万
        - text: 人效 +10%
        - text: 人效 +15%

