      fontFamily: "Source Han Serif CN"
      fontSize: 17
      bold: true
      color: "$ink"
      align: [left, middle]
      text: 订阅深耕：让干流承载更多水量
  - elementId: p2-detail
    elementType: text
    bounds: [60, 336, 400, 36]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 12
      color: "$muted"
      lineHeight: 1.5
      align: [left, top]
      text: SaaS ARR 增长 35%；订阅收入占比 58% → 65%。

  - elementId: p-rule-2
    elementType: shape
