version: v2
title: "远川 2025 · 一条河的水文年报"
size: [960, 540]
fonts:
  思源宋体: { family: "Source Han Serif CN" }
  霞鹜新晰黑: { family: "LXGW Neo XiHei" }
theme:
  colors:
    primaryDeep: "#0B2921"        # 深潭墨绿：封面/收尾深底、强调块
    bg: "#FCFCFA"       # 纸米：内容页底
    text: "#1C2B25"         # 墨色：正文
    primary: "#C9A45C"        # 鎏金：高亮、里程桩、关键数字
    accent: "#6FA797"        # 水青：次级数据
    accent3: "#B5533A"        # 暗红：问题/缺口警示
    muted: "#6E7D72"       # 纸米底上的次级文字
    line: "#DCD4BE"        # 纸米底上的细分隔线
    primarySoft: "#F7F6F1"   # 表格隔行
    primaryTint: "#A9C3B4"        # 深潭底上的次级文字
  textStyles:
    eyebrow: { fontFamily: "LXGW Neo XiHei", fontSize: 11, color: "$primary", bold: true, letterSpacing: 3, lineHeight: 1.3 }
    title: { fontFamily: "Source Han Serif CN", fontSize: 28, color: "$text", bold: true, lineHeight: 1.25 }
    subtitle: { fontFamily: "LXGW Neo XiHei", fontSize: 13, color: "$muted", lineHeight: 1.55 }
    body: { fontFamily: "LXGW Neo XiHei", fontSize: 13, color: "$text", lineHeight: 1.6 }
    small: { fontFamily: "LXGW Neo XiHei", fontSize: 10.5, color: "$muted", lineHeight: 1.5 }
    reading: { fontFamily: "Source Han Serif CN", fontSize: 56, color: "$text", bold: true, lineHeight: 1.05 }
  tableStyles:
    default:
      cellStyle: { fontFamily: "LXGW Neo XiHei", fontSize: 11, color: "$text", fill: { type: "solid", color: "$bg" }, border: [null, null, { style: "solid", width: 1, color: "$line" }, null], align: ["center", "middle"] }
      firstRowStyle: { fill: { type: "solid", color: "$primaryDeep" }, color: "$bg", bold: true }
      bodyStyles:
        - { fill: { type: "solid", color: "$primarySoft" } }
        - { fill: { type: "solid", color: "$bg" } }
      rowOverColumn: true
pages:
  - pages/1_cover.page
  - pages/2_conclusions.page
  - pages/3_results.page
  - pages/4_revenue_structure.page
  - pages/5_issues.page
  - pages/6_strategy.page
  - pages/7_actions.page
