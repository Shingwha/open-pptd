version: v2
title: "远川科技 2025年度经营复盘与2026年增长策略"
size: [960, 540]
fonts:
  思源宋体: { family: "Source Han Serif CN" }
  霞鹜新晰黑: { family: "LXGW Neo XiHei" }
theme:
  colors:
    primary: "#123B2F"
    accent: "#B08D3E"
    bg: "#F7F3E8"
    text: "#1F2A25"
    muted: "#6C7A72"
    line: "#E4DED0"
    success: "#3F7C55"
    warning: "#C18A2D"
    danger: "#B5533A"
    primarySoft: "#EDF2ED"
    primaryTint: "#D6E5DC"
    primaryDeep: "#081B16"
    accent3: "#2F6B58"
    accent4: "#5B8F7D"
    accent5: "#9DB7AA"
    accent6: "#D9C58A"
  textStyles:
    eyebrow: { fontFamily: "LXGW Neo XiHei", fontSize: 12, color: "$accent", bold: true, letterSpacing: 3, lineHeight: 1.3 }
    title: { fontFamily: "Source Han Serif CN", fontSize: 30, color: "$text", bold: true, lineHeight: 1.25 }
    subtitle: { fontFamily: "LXGW Neo XiHei", fontSize: 15, color: "$muted", lineHeight: 1.6 }
    body: { fontFamily: "LXGW Neo XiHei", fontSize: 15, color: "$text", lineHeight: 1.65 }
    small: { fontFamily: "LXGW Neo XiHei", fontSize: 12, color: "$muted", lineHeight: 1.5 }
    metric: { fontFamily: "Source Han Serif CN", fontSize: 34, color: "$text", bold: true, lineHeight: 1.1 }
  tableStyles:
    default:
      cellStyle: { fontFamily: "LXGW Neo XiHei", fontSize: 12, color: "$text", fill: { type: "solid", color: "#F7F3E8" }, border: [null, null, { style: "solid", width: 1, color: "$line" }, null], align: ["center", "middle"] }
      firstRowStyle: { fill: { type: "solid", color: "$primary" }, color: "#FFFFFF", bold: true }
      bodyStyles:
        - { fill: { type: "solid", color: "$primarySoft" } }
        - { fill: { type: "solid", color: "#F7F3E8" } }
      rowOverColumn: true
pages:
  - pages/1_cover.page
  - pages/2_conclusions.page
  - pages/3_results.page
  - pages/4_revenue_structure.page
  - pages/5_issues.page
  - pages/6_strategy.page
  - pages/7_actions.page
