pageType: content
background: { type: solid, color: "$bg" }
elements:
  - elementId: header-marker
    elementType: shape
    bounds: [36, 24, 8, 30]
    shapeName: rect
    fill: { type: solid, color: "$primary" }
  - elementId: header-title
    elementType: text
    bounds: [54, 22, 680, 34]
    content: { style: "$pageTitle", wrap: false, text: "02. 数据与方法 —— 驾驶行为量化因子" }
  - elementId: header-brand
    elementType: text
    bounds: [730, 30, 194, 14]
    content: { style: "$label", fontSize: 9, align: [right, top], wrap: false, text: EV RANGE · RESEARCH }
  - elementId: header-rule
    elementType: shape
    bounds: [36, 66, 888, 2]
    shapeName: rect
    fill: { type: solid, color: "$primaryDeep" }
  - elementId: statement
    elementType: text
    bounds: [52, 78, 856, 42]
    content:
      style: "$statement"
      align: [center, middle]
      text: |-
        <p>Q = 趋势反向化 · 归一化 · <span style="color:$danger">加权求和</span></p>
  - elementId: step-1-frame
    elementType: shape
    bounds: [36, 132, 290, 78]
    shapeName: rect
    fill: { type: solid, color: "#FFFFFF" }
    border: { style: solid, width: 1, color: "$line" }
  - elementId: step-1-title
    elementType: text
    bounds: [52, 142, 258, 18]
    content: { style: "$heading", fontSize: 12, wrap: false, text: 01 · 趋势反向化 }
  - elementId: step-1-text
    elementType: text
    bounds: [52, 164, 258, 38]
    content: { style: "$caption", fontSize: 10, color: "$text", text: 对 Pᵣ 取 i′ = 1 − i，使其与其余六项指标同向反映能耗强度。 }
  - elementId: step-2-frame
    elementType: shape
    bounds: [36, 222, 290, 78]
    shapeName: rect
    fill: { type: solid, color: "$primarySoft" }
    border: { style: solid, width: 1, color: "$primaryTint" }
  - elementId: step-2-title
    elementType: text
    bounds: [52, 232, 258, 18]
    content: { style: "$heading", fontSize: 12, wrap: false, text: 02 · 归一化处理 }
  - elementId: step-2-text
    elementType: text
    bounds: [52, 254, 258, 38]
    content: { style: "$caption", fontSize: 10, color: "$text", text: 占比指标无需处理；仅对车速、加速度均值与标准差消除量纲。 }
  - elementId: step-3-frame
    elementType: shape
    bounds: [36, 312, 290, 78]
    shapeName: rect
    fill: { type: solid, color: "#FFFFFF" }
    border: { style: solid, width: 1, color: "$line" }
  - elementId: step-3-title
    elementType: text
    bounds: [52, 322, 258, 18]
    content: { style: "$heading", fontSize: 12, wrap: false, text: 03 · 加权求和 }
  - elementId: step-3-text
    elementType: text
    bounds: [52, 344, 258, 38]
    content: { style: "$caption", fontSize: 10, color: "$text", text: f(i) 为归一化指标，wᵢ 为随机森林权重，n = 7；每片获得唯一 Q。 }
  - elementId: formula-frame
    elementType: shape
    bounds: [36, 402, 290, 32]
    shapeName: rect
    fill: { type: solid, color: "$primaryDeep" }
  - elementId: formula
    elementType: text
    bounds: [48, 402, 266, 32]
    content:
      fontSize: 13
      color: "#FFFFFF"
      align: [center, middle]
      text: |-
        <p>\(Q = \sum_{i=1}^{n} f(i) \cdot w_i\)</p>
  - elementId: fig-frame
    elementType: shape
    bounds: [342, 132, 582, 244]
    shapeName: rect
    fill: { type: solid, color: "#FFFFFF" }
    border: { style: solid, width: 1, color: "$line" }
  - elementId: fig-12
    elementType: image
    bounds: [346, 136, 574, 236]
    src: media/fig12_consumption.jpg
    fit: { mode: contain }
  - elementId: fig-caption
    elementType: text
    bounds: [342, 382, 582, 28]
    content:
      style: "$caption"
      fontSize: 9
      text: |-
        <p><span style="color:$primary"><strong>图 12</strong></span>　不同速度工况下 Q 与驱动电机能耗均值；来源：陈默等（2024），图 12</p>
  - elementId: reading
    elementType: text
    bounds: [342, 414, 582, 20]
    content:
      style: "$body"
      fontSize: 11.5
      align: [center, top]
      wrap: false
      text: Q 越大，能耗均值越高；同一 Q 下速度工况越高，能耗越大。
  - elementId: takeaway-bar
    elementType: shape
    bounds: [36, 452, 888, 40]
    shapeName: rect
    fill: { type: solid, color: "$primary" }
  - elementId: wave-left
    elementType: line
    bounds: [50, 464, 48, 14]
    viewBox: [48, 14]
    points: "0,7 8,7 12,2 17,12 23,5 28,7 48,7"
    curve: sharp
    border: { style: solid, width: 1, color: "$accent4" }
  - elementId: wave-right
    elementType: line
    bounds: [862, 464, 48, 14]
    viewBox: [48, 14]
    points: "0,7 20,7 25,5 31,12 36,2 40,7 48,7"
    curve: sharp
    border: { style: solid, width: 1, color: "$accent4" }
  - elementId: takeaway
    elementType: text
    bounds: [100, 456, 760, 30]
    content: { style: "$takeaway", align: [center, middle], wrap: false, text: 七项指标被压缩为一个连续数值，驾驶越激烈，剩余续驶里程越短 }
  - elementId: footer-source
    elementType: text
    bounds: [36, 510, 680, 12]
    content: { style: "$nav", fontSize: 8.2, wrap: false, text: 来源：陈默等（2024），驾驶行为量化因子定义与图 12 }
  - elementId: footer-page
    elementType: text
    bounds: [836, 510, 88, 12]
    content: { style: "$nav", color: "$primary", bold: true, align: [right, top], wrap: false, text: 08 / 15 }
