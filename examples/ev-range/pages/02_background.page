    bounds: [336, 344, 272, 118]
    shapeName: roundRect
    adjustments: [9000]
    fill: { type: solid, color: "#FFFFFF" }
    border: { style: solid, width: 1, color: "$line" }
    shadow: { blur: 10, color: "#1F5FBF14", offset: [0, 2] }
  - elementId: stat-2-num
    elementType: text
    bounds: [356, 358, 232, 36]
    content:
      style: "$stat"
      wrap: false
      text: |-
        <p><span style="font-size:26px;">78.9</span><span style="font-size:12px;color:$muted;">%</span></p>
  - elementId: stat-2-label
    elementType: text
    bounds: [356, 400, 232, 34]
    content:
      style: "$caption"
      fontSize: 9
      text: 电动汽车占新能源汽车销量的比重
  - elementId: stat-3-card
    elementType: shape
    bounds: [624, 344, 288, 118]
    shapeName: roundRect
    adjustments: [9000]
    fill: { type: solid, color: "#FFFFFF" }
    border: { style: solid, width: 1, color: "$line" }
    shadow: { blur: 10, color: "#1F5FBF14", offset: [0, 2] }
  - elementId: stat-3-num
    elementType: text
    bounds: [644, 358, 248, 36]
    content:
      style: "$stat"
      wrap: false
      text: |-
        <p><span style="font-size:25px;">20,300,600</span><span style="font-size:12px;color:$muted;"> 条</span></p>
  - elementId: stat-3-label
    elementType: text
    bounds: [644, 400, 248, 34]
