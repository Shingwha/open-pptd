  - elementId: takeaway-bar
    elementType: shape
    bounds: [48, 472, 864, 26]
    shapeName: roundRect
    adjustments: [50000]
    fill: { type: solid, color: "$primary" }
  - elementId: takeaway-text
    elementType: text
    bounds: [64, 476, 832, 18]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 9.4
      color: "#FFFFFF"
