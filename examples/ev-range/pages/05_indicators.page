pageType: content
background: { type: solid, color: "$bg" }
elements:
  - elementId: header-marker
    elementType: shape
    bounds: [36, 24, 8, 30]
    shapeName: rect
    fill: { type: solid, color: "$primary" }
  - elementId: header-title
    elementType: text
    bounds: [54, 22, 680, 34]
    content: { style: "$pageTitle", wrap: false, text: "02. 数据与方法 —— 七项驾驶行为指标" }
  - elementId: header-brand
    elementType: text
    bounds: [730, 30, 194, 14]
    content: { style: "$label", fontSize: 9, align: [right, top], wrap: false, text: EV RANGE · RESEARCH }
  - elementId: header-rule
    elementType: shape
    bounds: [36, 66, 888, 2]
    shapeName: rect
    fill: { type: solid, color: "$primaryDeep" }
  - elementId: statement
    elementType: text
    bounds: [52, 78, 856, 42]
    content:
      style: "$statement"
      align: [center, middle]
      text: |-
        <p>不描述“风格”，只量化<span style="color:$danger">可赋权的行为强度</span></p>
  - elementId: logic-frame
    elementType: shape
    bounds: [36, 132, 260, 302]
    shapeName: rect
    fill: { type: solid, color: "#FFFFFF" }
    border: { style: solid, width: 1, color: "$line" }
  - elementId: logic-label
    elementType: text
    bounds: [52, 144, 228, 20]
    content: { style: "$heading", align: [center, top], wrap: false, text: 指标选取逻辑 }
  - elementId: logic-box-1
    elementType: shape
    bounds: [62, 176, 208, 42]
    shapeName: rect
    fill: { type: solid, color: "$primarySoft" }
    border: { style: solid, width: 1, color: "$primaryTint" }
  - elementId: logic-text-1
    elementType: text
    bounds: [68, 176, 196, 42]
    content: { style: "$heading", fontSize: 12, align: [center, middle], wrap: false, text: 驾驶行为变化 }
  - elementId: logic-arrow-1
    elementType: line
    bounds: [160, 218, 12, 24]
    viewBox: [12, 24]
    points: "6,0 6,22"
    curve: sharp
    arrow: [null, arrow]
    border: { style: solid, width: 1.5, color: "$accent" }
  - elementId: logic-box-2
    elementType: shape
    bounds: [62, 242, 208, 42]
    shapeName: rect
    fill: { type: solid, color: "#FFFFFF" }
    border: { style: solid, width: 1, color: "$line" }
  - elementId: logic-text-2
    elementType: text
    bounds: [68, 242, 196, 42]
    content: { style: "$heading", fontSize: 12, align: [center, middle], wrap: false, text: 车速与加速度变化 }
  - elementId: logic-arrow-2
    elementType: line
    bounds: [160, 284, 12, 24]
    viewBox: [12, 24]
    points: "6,0 6,22"
    curve: sharp
    arrow: [null, arrow]
    border: { style: solid, width: 1.5, color: "$accent" }
  - elementId: logic-box-3
    elementType: shape
    bounds: [62, 308, 208, 42]
    shapeName: rect
    fill: { type: solid, color: "$primarySoft" }
    border: { style: solid, width: 1, color: "$primaryTint" }
  - elementId: logic-text-3
    elementType: text
    bounds: [68, 308, 196, 42]
    content: { style: "$heading", fontSize: 12, align: [center, middle], wrap: false, text: 驱动电机能耗变化 }
  - elementId: logic-note
    elementType: text
    bounds: [54, 362, 224, 58]
    content:
      style: "$caption"
      fontSize: 10
      color: "$text"
      text: 以片段内的均值、占比与标准差刻画行为，兼顾可获取性与可操作性；7 项加权求和形成连续标签 Q。
  - elementId: table-caption
    elementType: text
    bounds: [316, 132, 608, 18]
    content:
      style: "$caption"
      fontSize: 10
      wrap: false
      text: |-
        <p><span style="color:$primary"><strong>表 3</strong></span>　七项驾驶行为评价指标与计算式</p>
  - elementId: table-3
    elementType: table
    bounds: [316, 156, 608, 250]
    columnWidths: [0.08, 0.16, 0.28, 0.48]
    rowHeights: [0.10, 0.12, 0.12, 0.12, 0.12, 0.12, 0.12, 0.18]
    style: "$formula"
    rows:
      - - text: 序号
        - text: 符号
        - text: 评价指标
        - text: 计算公式
      - - text: "1"
        - text: |-
            <p>\(P_{\mathrm{a}}\)</p>
        - text: 急加速时长占比
        - text: |-
            <p>\(P_{\mathrm{a}} = \frac{t_{\mathrm{a}}}{T}\)</p>
      - - text: "2"
        - text: |-
            <p>\(P_{\mathrm{h}}\)</p>
        - text: 高速时长占比
        - text: |-
            <p>\(P_{\mathrm{h}} = \frac{t_{\mathrm{h}}}{T}\)</p>
      - - text: "3"
        - text: |-
            <p>\(P_{\mathrm{r}}\)</p>
        - text: 能量回收占比
        - text: |-
            <p>\(P_{\mathrm{r}} = \frac{E_{\mathrm{r}}}{E}\)</p>
      - - text: "4"
        - text: |-
            <p>\(V_{\mathrm{m}}\)</p>
        - text: 车速均值
        - text: |-
            <p>\(V_{\mathrm{m}} = \frac{\sum_{i=1}^{n} v_i}{n}\)</p>
      - - text: "5"
        - text: |-
            <p>\(V_{\mathrm{std}}\)</p>
        - text: 车速标准差
        - text: |-
            <p>\(V_{\mathrm{std}} = \sqrt{\frac{\sum_{i=1}^{n} (v_i - V_{\mathrm{m}})^2}{n}}\)</p>
      - - text: "6"
        - text: |-
            <p>\(a_{\mathrm{m}}\)</p>
        - text: 加速度均值
        - text: |-
            <p>\(a_{\mathrm{m}} = \frac{\sum_{i=1}^{n} a_i}{n}\)</p>
      - - text: "7"
        - text: |-
            <p>\(a_{\mathrm{std}}\)</p>
        - text: 加速度标准差
        - text: |-
            <p>\(a_{\mathrm{std}} = \sqrt{\frac{\sum_{i=1}^{n} (a_i - a_{\mathrm{m}})^2}{n}}\)</p>
  - elementId: table-note
    elementType: text
    bounds: [316, 412, 608, 22]
    content:
      style: "$caption"
      fontSize: 8.5
      text: T 为片段总时长；Pᵣ 与能耗正相关，其余六项负相关，计算因子前先对 Pᵣ 作趋势反向化。来源：陈默等（2024），表 3。
  - elementId: takeaway-bar
    elementType: shape
    bounds: [36, 452, 888, 40]
    shapeName: rect
    fill: { type: solid, color: "$primary" }
  - elementId: wave-left
    elementType: line
    bounds: [50, 464, 48, 14]
    viewBox: [48, 14]
    points: "0,7 8,7 12,2 17,12 23,5 28,7 48,7"
    curve: sharp
    border: { style: solid, width: 1, color: "$accent4" }
  - elementId: wave-right
    elementType: line
    bounds: [862, 464, 48, 14]
    viewBox: [48, 14]
    points: "0,7 20,7 25,5 31,12 36,2 40,7 48,7"
    curve: sharp
    border: { style: solid, width: 1, color: "$accent4" }
  - elementId: takeaway
    elementType: text
    bounds: [100, 456, 760, 30]
    content: { style: "$takeaway", align: [center, middle], wrap: false, text: 均值、占比、标准差共同覆盖车速与加速度两个行为维度 }
  - elementId: footer-source
    elementType: text
    bounds: [36, 510, 680, 12]
    content: { style: "$nav", fontSize: 8.2, wrap: false, text: 来源：陈默等（2024），原文表 3 与第 2 节 }
  - elementId: footer-page
    elementType: text
    bounds: [836, 510, 88, 12]
    content: { style: "$nav", color: "$primary", bold: true, align: [right, top], wrap: false, text: 05 / 15 }
