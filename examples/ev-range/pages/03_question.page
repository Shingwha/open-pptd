pageType: content
background: { type: solid, color: "$bg" }
elements:
  - elementId: header-marker
    elementType: shape
    bounds: [36, 24, 8, 30]
    shapeName: rect
    fill: { type: solid, color: "$primary" }
  - elementId: header-title
    elementType: text
    bounds: [54, 22, 680, 34]
    content: { style: "$pageTitle", wrap: false, text: "01. 研究问题 —— 假设与范围" }
  - elementId: header-brand
    elementType: text
    bounds: [730, 30, 194, 14]
    content: { style: "$label", fontSize: 9, align: [right, top], wrap: false, text: EV RANGE · RESEARCH }
  - elementId: header-rule
    elementType: shape
    bounds: [36, 66, 888, 2]
    shapeName: rect
    fill: { type: solid, color: "$primaryDeep" }
  - elementId: statement
    elementType: text
    bounds: [52, 78, 856, 42]
    content:
      style: "$statement"
      align: [center, middle]
      text: |-
        <p>一个连续的<span style="color:$danger">驾驶行为因子</span>，能否降低逐时刻预测误差？</p>
  - elementId: question-frame
    elementType: shape
    bounds: [36, 132, 550, 218]
    shapeName: rect
    fill: { type: solid, color: "#FFFFFF" }
    border: { style: solid, width: 1.2, color: "$primary" }
  - elementId: question-label
    elementType: text
    bounds: [56, 146, 510, 16]
    content: { style: "$label", align: [center, top], wrap: false, text: RESEARCH QUESTION · 核心问题 }
  - elementId: question-text
    elementType: text
    bounds: [66, 176, 490, 88]
    content:
      fontFamily: "Source Han Serif CN"
      fontSize: 22
      color: "$primaryDeep"
      bold: true
      lineHeight: 1.45
      align: [center, middle]
      text: 用量化因子 Q 替代聚类标签，能否降低电动汽车剩余续驶里程预测的 RMSE 与 MAE？
  - elementId: question-sep
    elementType: shape
    bounds: [66, 278, 490, 1]
    shapeName: rect
    fill: { type: solid, color: "$line" }
  - elementId: question-scope
    elementType: text
    bounds: [66, 292, 490, 42]
    content:
      style: "$body"
      fontSize: 12.5
      align: [center, top]
      text: 4 辆实车 · 3,622 个驾驶事件 · 20 s 短行驶片段；训练集 9:1 比较 RMSE / MAE，单事件验证比较 R²。
  - elementId: hypothesis-frame
    elementType: shape
    bounds: [606, 132, 318, 218]
    shapeName: rect
    fill: { type: solid, color: "$primarySoft" }
    border: { style: solid, width: 1, color: "$primaryTint" }
  - elementId: h1-label
    elementType: text
    bounds: [624, 144, 282, 18]
    content: { style: "$heading", fontSize: 12, wrap: false, text: H1 · 特征有效性 }
  - elementId: h1-text
    elementType: text
    bounds: [624, 164, 282, 40]
    content: { style: "$body", fontSize: 12, text: 含 Q 模型的 RMSE 与 MAE 低于不含 Q 的同类模型。 }
  - elementId: h-sep-1
    elementType: shape
    bounds: [624, 205, 282, 1]
    shapeName: rect
    fill: { type: solid, color: "$primaryTint" }
  - elementId: h2-label
    elementType: text
    bounds: [624, 214, 282, 18]
    content: { style: "$heading", fontSize: 12, wrap: false, text: H2 · 模型优越性 }
  - elementId: h2-text
    elementType: text
    bounds: [624, 234, 282, 40]
    content: { style: "$body", fontSize: 12, text: 在 SVR、BP、RNN、LSTM 中，LSTM 的预测误差最低。 }
  - elementId: h-sep-2
    elementType: shape
    bounds: [624, 275, 282, 1]
    shapeName: rect
    fill: { type: solid, color: "$primaryTint" }
  - elementId: h3-label
    elementType: text
    bounds: [624, 284, 282, 18]
    content: { style: "$heading", fontSize: 12, wrap: false, text: H3 · 实车有效性 }
  - elementId: h3-text
    elementType: text
    bounds: [624, 304, 282, 40]
    content: { style: "$body", fontSize: 12, text: 单事件验证中，含 Q 的 LSTM 其 R² 高于对照模型与仪表。 }
  - elementId: falsify-frame
    elementType: shape
    bounds: [36, 366, 888, 68]
    shapeName: rect
    fill: { type: solid, color: "#FFFFFF" }
    border: { style: solid, width: 1, color: "$line" }
  - elementId: falsify-label
    elementType: text
    bounds: [54, 378, 130, 18]
    content: { style: "$heading", fontSize: 12, wrap: false, text: 可证伪条件 }
  - elementId: falsify-text
    elementType: text
    bounds: [184, 376, 500, 44]
    content:
      style: "$body"
      fontSize: 12
      text: 若含 Q 与不含 Q 的误差无系统差异，或 LSTM 未优于 SVR / BP / RNN，则 H1 与 H2 不成立。
  - elementId: evidence-map
    elementType: text
    bounds: [700, 376, 206, 44]
    content: { style: "$caption", fontSize: 10, align: [left, middle], text: 对应证据：表 3 指标 · 表 7 误差 · 表 8 确定系数 }
  - elementId: takeaway-bar
    elementType: shape
    bounds: [36, 452, 888, 40]
    shapeName: rect
    fill: { type: solid, color: "$primary" }
  - elementId: wave-left
    elementType: line
    bounds: [50, 464, 48, 14]
    viewBox: [48, 14]
    points: "0,7 8,7 12,2 17,12 23,5 28,7 48,7"
    curve: sharp
    border: { style: solid, width: 1, color: "$accent4" }
  - elementId: wave-right
    elementType: line
    bounds: [862, 464, 48, 14]
    viewBox: [48, 14]
    points: "0,7 20,7 25,5 31,12 36,2 40,7 48,7"
    curve: sharp
    border: { style: solid, width: 1, color: "$accent4" }
  - elementId: takeaway
    elementType: text
    bounds: [100, 456, 760, 30]
    content: { style: "$takeaway", align: [center, middle], wrap: false, text: 若 H1–H3 成立，驾驶行为差异应成为续驶里程预测的一等输入 }
  - elementId: footer-source
    elementType: text
    bounds: [36, 510, 680, 12]
    content: { style: "$nav", fontSize: 8.2, wrap: false, text: 研究设计：陈默等（2024），原文第 2–4 节 }
  - elementId: footer-page
    elementType: text
    bounds: [836, 510, 88, 12]
    content: { style: "$nav", color: "$primary", bold: true, align: [right, top], wrap: false, text: 03 / 15 }
