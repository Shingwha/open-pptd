    elementType: text
    bounds: [344, 366, 552, 14]
    content:
      style: "$caption"
      fontSize: 7.6
      wrap: false
      text: 数值为归一化后的误差；完整 SVR / BP / RNN 对比见原文表 5–7。
  - elementId: kpi-card
    elementType: shape
    bounds: [328, 402, 584, 62]
    shapeName: roundRect
    adjustments: [14000]
    fill: { type: solid, color: "$primaryDeep" }
    shadow: { blur: 12, color: "#123B7A33", offset: [0, 3] }
  - elementId: kpi-text
