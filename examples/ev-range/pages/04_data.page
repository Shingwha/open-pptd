      fontSize: 9.6
      wrap: false
      text: GB/T 32960 · 1 Hz · 4 辆实车 · NEDC 310 km / 31 kWh / 1125 kg · 2022.10–2023.04
  - elementId: step-1
    elementType: shape
    bounds: [48, 132, 198, 104]
    shapeName: roundRect
    adjustments: [10000]
    fill: { type: solid, color: "$primarySoft" }
    border: { style: solid, width: 1, color: "$primaryTint" }
  - elementId: step-1-num
