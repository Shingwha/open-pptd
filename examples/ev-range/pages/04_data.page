pageType: content
background:
  type: solid
  color: "$bg"
notes: |-
  数据来源与处理流程：GB/T32960 监控平台数据、3δ 清洗、驾驶事件与 20 s 短片段划分。
  四条流水线卡片说明采集—清洗—事件—片段；下方表 2 给出四辆车数据分布，图 1/2 为示意图。
elements:
  - elementId: chapter-bar
    elementType: shape
    bounds: [0, 0, 960, 56]
    shapeName: rect
    fill: { type: solid, color: "$primary" }
  - elementId: chapter-text
    elementType: text
    bounds: [48, 14, 700, 28]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 18
      color: "#FFFFFF"
      bold: true
      align: [left, middle]
      wrap: false
      text: '02. 数据与方法 —— 从报文到片段'
  - elementId: chapter-brand
    elementType: text
    bounds: [736, 20, 176, 16]
    content:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 8.8
      color: "$accent6"
      align: [right, top]
      wrap: false
      text: EV RANGE · 学术报告
  - elementId: title
    elementType: text
    bounds: [48, 70, 864, 34]
    content:
      style: "$title"
      wrap: false
      text: 2,030 万条报文，清洗为 3,622 个可建模的驾驶事件
  - elementId: subtitle
    elementType: text
    bounds: [48, 104, 864, 16]
