pageType: content
background: { type: solid, color: "$bg" }
elements:
  - elementId: header-marker
    elementType: shape
    bounds: [36, 24, 8, 30]
    shapeName: rect
    fill: { type: solid, color: "$primary" }
  - elementId: header-title
    elementType: text
    bounds: [54, 22, 680, 34]
    content: { style: "$pageTitle", wrap: false, text: "05. 结论 —— 回答与贡献" }
  - elementId: header-brand
    elementType: text
    bounds: [730, 30, 194, 14]
    content: { style: "$label", fontSize: 9, align: [right, top], wrap: false, text: EV RANGE · RESEARCH }
  - elementId: header-rule
    elementType: shape
    bounds: [36, 66, 888, 2]
    shapeName: rect
    fill: { type: solid, color: "$primaryDeep" }
  - elementId: statement
    elementType: text
    bounds: [52, 78, 856, 42]
    content:
      style: "$statement"
      align: [center, middle]
      text: |-
        <p>驾驶行为量化因子让里程预测从“平均”走向<span style="color:$danger">“逐样本”</span></p>
  - elementId: answer-1-num
    elementType: text
    bounds: [52, 138, 240, 34]
    content: { style: "$stat", fontSize: 26, wrap: false, text: "01 · 问题" }
  - elementId: answer-1-text
    elementType: text
    bounds: [52, 184, 240, 70]
    content: { style: "$body", fontSize: 12.5, text: 聚类标签粒度粗、预测偏差大；Q 为每个短片段提供连续的驾驶行为标签。 }
  - elementId: answer-1-stat
    elementType: text
    bounds: [52, 268, 250, 32]
    content:
      style: "$stat"
      fontSize: 23
      wrap: false
      text: |-
        <p>3,622<span style="font-size:11px;color:$muted"> 个驾驶事件</span></p>
  - elementId: answer-1-ref
    elementType: text
    bounds: [52, 312, 240, 16]
    content: { style: "$caption", wrap: false, text: 证据指针 → §1 背景 / §2 指标 }
  - elementId: answer-sep-1
    elementType: shape
    bounds: [318, 138, 1, 190]
    shapeName: rect
    fill: { type: solid, color: "$line" }
  - elementId: answer-2-num
    elementType: text
    bounds: [352, 138, 240, 34]
    content: { style: "$stat", fontSize: 26, wrap: false, text: "02 · 方法" }
  - elementId: answer-2-text
    elementType: text
    bounds: [352, 184, 240, 70]
    content: { style: "$body", fontSize: 12.5, text: 七项指标经随机森林客观赋权；含 Q 的 LSTM 在四车上误差最低。 }
  - elementId: answer-2-stat
    elementType: text
    bounds: [352, 268, 240, 32]
    content: { style: "$stat", fontSize: 22, wrap: false, text: 0.017 → 0.005 }
  - elementId: answer-2-ref
    elementType: text
    bounds: [352, 312, 240, 16]
    content: { style: "$caption", wrap: false, text: 证据指针 → 表 3 / 表 7 }
  - elementId: answer-sep-2
    elementType: shape
    bounds: [618, 138, 1, 190]
    shapeName: rect
    fill: { type: solid, color: "$line" }
  - elementId: answer-3-num
    elementType: text
    bounds: [652, 138, 240, 34]
    content: { style: "$stat", fontSize: 26, wrap: false, text: "03 · 证据" }
  - elementId: answer-3-text
    elementType: text
    bounds: [652, 184, 240, 70]
    content: { style: "$body", fontSize: 12.5, text: 实车单驾驶事件 R² 全部提升，优于不含 Q 模型与原车仪表。 }
  - elementId: answer-3-stat
    elementType: text
    bounds: [652, 268, 240, 32]
    content: { style: "$stat", fontSize: 23, wrap: false, text: 最高 R² 0.9953 }
  - elementId: answer-3-ref
    elementType: text
    bounds: [652, 312, 240, 16]
    content: { style: "$caption", wrap: false, text: 证据指针 → 表 8 / 图 14 }
  - elementId: contribution-frame
    elementType: shape
    bounds: [36, 350, 888, 84]
    shapeName: rect
    fill: { type: solid, color: "$primarySoft" }
    border: { style: solid, width: 1, color: "$primaryTint" }
  - elementId: contribution-label
    elementType: text
    bounds: [54, 360, 150, 18]
    content: { style: "$heading", fontSize: 12, wrap: false, text: 贡献 / CONTRIBUTION }
  - elementId: contribution-text
    elementType: text
    bounds: [214, 358, 688, 42]
    content:
      style: "$body"
      fontSize: 12
      text: 把驾驶行为从离散标签改写为可赋权的连续因子，打通“数据清洗 → 特征工程 → LSTM → 实车验证”全流程，为续驶里程管理与充电规划提供支持。
  - elementId: contribution-boundary
    elementType: text
    bounds: [214, 406, 688, 16]
    content: { style: "$caption", fontSize: 9, wrap: false, text: 边界：单车型、离线数据；下一步扩展高寒 / 高原 / 高温地区与更多车型在线验证。 }
  - elementId: takeaway-bar
    elementType: shape
    bounds: [36, 452, 888, 40]
    shapeName: rect
    fill: { type: solid, color: "$primary" }
  - elementId: wave-left
    elementType: line
    bounds: [50, 464, 48, 14]
    viewBox: [48, 14]
    points: "0,7 8,7 12,2 17,12 23,5 28,7 48,7"
    curve: sharp
    border: { style: solid, width: 1, color: "$accent4" }
  - elementId: wave-right
    elementType: line
    bounds: [862, 464, 48, 14]
    viewBox: [48, 14]
    points: "0,7 20,7 25,5 31,12 36,2 40,7 48,7"
    curve: sharp
    border: { style: solid, width: 1, color: "$accent4" }
  - elementId: takeaway
    elementType: text
    bounds: [100, 456, 760, 30]
    content: { style: "$takeaway", align: [center, middle], wrap: false, text: 问题、方法与证据形成闭环：Q 是可计算、可赋权、可验证的行为特征 }
  - elementId: footer-source
    elementType: text
    bounds: [36, 510, 680, 12]
    content: { style: "$nav", fontSize: 8.2, wrap: false, text: 结论依据：原文表 3、表 7、表 8 与图 14 }
  - elementId: footer-page
    elementType: text
    bounds: [836, 510, 88, 12]
    content: { style: "$nav", color: "$primary", bold: true, align: [right, top], wrap: false, text: 13 / 15 }
