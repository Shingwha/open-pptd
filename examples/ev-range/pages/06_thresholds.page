pageType: content
background: { type: solid, color: "$bg" }
elements:
  - elementId: header-marker
    elementType: shape
    bounds: [36, 24, 8, 30]
    shapeName: rect
    fill: { type: solid, color: "$primary" }
  - elementId: header-title
    elementType: text
    bounds: [54, 22, 680, 34]
    content: { style: "$pageTitle", wrap: false, text: "02. 数据与方法 —— 阈值与速度区间" }
  - elementId: header-brand
    elementType: text
    bounds: [730, 30, 194, 14]
    content: { style: "$label", fontSize: 9, align: [right, top], wrap: false, text: EV RANGE · RESEARCH }
  - elementId: header-rule
    elementType: shape
    bounds: [36, 66, 888, 2]
    shapeName: rect
    fill: { type: solid, color: "$primaryDeep" }
  - elementId: statement
    elementType: text
    bounds: [52, 78, 856, 42]
    content:
      style: "$statement"
      align: [center, middle]
      text: |-
        <p>阈值按速度区间自适应，<span style="color:$danger">高速段不再漏检急加速</span></p>
  - elementId: fig-frame
    elementType: shape
    bounds: [36, 132, 430, 258]
    shapeName: rect
    fill: { type: solid, color: "#FFFFFF" }
    border: { style: solid, width: 1, color: "$line" }
  - elementId: fig-4
    elementType: image
    bounds: [40, 136, 422, 250]
    src: media/fig04_percentile.jpg
    fit: { mode: contain }
  - elementId: fig-caption
    elementType: text
    bounds: [36, 396, 430, 32]
    content:
      style: "$caption"
      fontSize: 9
      text: |-
        <p><span style="color:$primary"><strong>图 4</strong></span>　分段区间 90% 百分位线判断方法；来源：陈默等（2024），图 4</p>
  - elementId: cluster-frame
    elementType: shape
    bounds: [482, 132, 442, 258]
    shapeName: rect
    fill: { type: solid, color: "#FFFFFF" }
    border: { style: solid, width: 1, color: "$line" }
  - elementId: cluster-label
    elementType: text
    bounds: [500, 144, 406, 20]
    content: { style: "$heading", align: [center, top], wrap: false, text: 速度区间聚类（K-means，K = 3） }
  - elementId: cluster-text
    elementType: text
    bounds: [500, 168, 406, 40]
    content:
      style: "$body"
      fontSize: 12
      text: 轮廓系数在 K = 3 时均值最大，手肘法同样指向低 / 中 / 高速三类，替代固定阈值与全局百分位线。
  - elementId: table-caption
    elementType: text
    bounds: [500, 216, 238, 16]
    content:
      style: "$caption"
      fontSize: 9
      wrap: false
      text: |-
        <p><span style="color:$primary"><strong>表 4</strong></span>　聚类中心 / km·h⁻¹</p>
  - elementId: table-4
    elementType: table
    bounds: [500, 238, 238, 120]
    columnWidths: [0.56, 0.44]
    rowHeights: [0.25, 0.25, 0.25, 0.25]
    style: "$blueCompact"
    rows:
      - - text: 聚类结果
        - text: 聚类中心
      - - text: 低速状态
        - text: "11.07"
      - - text: 中速状态
        - text: "33.98"
      - - text: 高速状态
        - text: |-
            <p><span style="color:$primary"><strong>60.68</strong></span></p>
  - elementId: threshold-label
    elementType: text
    bounds: [754, 222, 152, 16]
    content: { style: "$label", align: [center, top], wrap: false, text: 高速事件阈值 }
  - elementId: threshold-num
    elementType: text
    bounds: [754, 246, 152, 38]
    content:
      style: "$stat"
      fontSize: 25
      align: [center, top]
      wrap: false
      text: |-
        <p>60.68<span style="font-size:10px;color:$muted"> km/h</span></p>
  - elementId: threshold-note
    elementType: text
    bounds: [754, 292, 152, 66]
    content: { style: "$caption", fontSize: 9, text: 取高速聚类中心作为阈值，用于统计高速时长占比 Pₕ；固定阈值易在高速区间漏检。 }
  - elementId: recover-frame
    elementType: shape
    bounds: [482, 402, 442, 32]
    shapeName: rect
    fill: { type: solid, color: "$primarySoft" }
    border: { style: solid, width: 1, color: "$primaryTint" }
  - elementId: recover-text
    elementType: text
    bounds: [496, 402, 414, 32]
    content:
      style: "$caption"
      fontSize: 9.5
      color: "$text"
      align: [center, middle]
      wrap: false
      text: 能量回收占比：3 号车 8.715%，4 号车 7.041%；1、2 号车未开启
  - elementId: takeaway-bar
    elementType: shape
    bounds: [36, 452, 888, 40]
    shapeName: rect
    fill: { type: solid, color: "$primary" }
  - elementId: wave-left
    elementType: line
    bounds: [50, 464, 48, 14]
    viewBox: [48, 14]
    points: "0,7 8,7 12,2 17,12 23,5 28,7 48,7"
    curve: sharp
    border: { style: solid, width: 1, color: "$accent4" }
  - elementId: wave-right
    elementType: line
    bounds: [862, 464, 48, 14]
    viewBox: [48, 14]
    points: "0,7 20,7 25,5 31,12 36,2 40,7 48,7"
    curve: sharp
    border: { style: solid, width: 1, color: "$accent4" }
  - elementId: takeaway
    elementType: text
    bounds: [100, 456, 760, 30]
    content: { style: "$takeaway", align: [center, middle], wrap: false, text: 分段百分位线与三类速度区间共同定义可计算的行为阈值 }
  - elementId: footer-source
    elementType: text
    bounds: [36, 510, 680, 12]
    content: { style: "$nav", fontSize: 8.2, wrap: false, text: 来源：陈默等（2024），图 4、表 4 及第 2 节 }
  - elementId: footer-page
    elementType: text
    bounds: [836, 510, 88, 12]
    content: { style: "$nav", color: "$primary", bold: true, align: [right, top], wrap: false, text: 06 / 15 }
