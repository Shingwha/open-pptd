version: v2
title: 基于驾驶行为量化特征的电动汽车剩余续驶里程预测
size: [960, 540]
fonts:
  思源宋体: { family: "Source Han Serif CN" }
  霞鹜新晰黑: { family: "LXGW Neo XiHei" }
theme:
  colors:
    primary: "#1F4E79"
    accent: "#2E6F9E"
    bg: "#F7F9FC"
    text: "#1B2733"
    muted: "#5F6F80"
    line: "#D5DEE8"
    success: "#2F6B57"
    warning: "#8A6D3B"
    danger: "#A14B43"
    primarySoft: "#EAF1F8"
    primaryTint: "#D8E4EF"
    primaryDeep: "#12324F"
    accent3: "#4E7FA8"
    accent4: "#7FA3C0"
    accent5: "#335F82"
    accent6: "#8AA9C2"
  textStyles:
    title:
      fontFamily: "Source Han Serif CN"
      fontSize: 24
      color: "$primary"
      lineHeight: 1.25
    subtitle:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 13
      color: "$muted"
      lineHeight: 1.5
    body:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 13
      color: "$text"
      lineHeight: 1.5
    caption:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 9
      color: "$muted"
      lineHeight: 1.35
    kicker:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 10
      color: "$accent"
      letterSpacing: 2
      lineHeight: 1.2
    quote:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 13
      color: "$muted"
      italic: true
      lineHeight: 1.5
  tableStyles:
    threeline:
      cellStyle:
        fontSize: 12
        fontFamily: "LXGW Neo XiHei"
        color: "$text"
        align: [center, middle]
        fill: { type: solid, color: "#FFFFFF" }
        border: null
        lineHeight: 1.3
      firstRowStyle:
        bold: true
        color: "$primary"
        border:
          - { style: solid, width: 2, color: "$primary" }
          - null
          - { style: solid, width: 1, color: "$primary" }
          - null
      lastRowStyle:
        border:
          - null
          - null
          - { style: solid, width: 2, color: "$primary" }
          - null
      rowOverColumn: true
    default:
      cellStyle:
        fontSize: 11
        color: "$text"
        fill: { type: solid, color: "#FFFFFF" }
        border: { style: solid, width: 1, color: "$line" }
        align: [center, middle]
      firstRowStyle:
        fill: { type: solid, color: "$primary" }
        color: "#FFFFFF"
        bold: true
      bodyStyles:
        - { fill: { type: solid, color: "$primarySoft" } }
        - { fill: { type: solid, color: "#FFFFFF" } }
      rowOverColumn: true
pages:
  - pages/01_cover.page
  - pages/02_overview.page
  - pages/03_toc.page
  - pages/04_divider1.page
  - pages/05_data.page
  - pages/06_divider2.page
  - pages/07_indicators.page
  - pages/08_thresholds.page
  - pages/09_rf.page
  - pages/10_factor.page
  - pages/11_divider3.page
  - pages/12_lstm.page
  - pages/13_training.page
  - pages/14_divider4.page
  - pages/15_validation.page
  - pages/16_conclusion.page
  - pages/17_end.page
