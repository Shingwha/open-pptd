version: v2
title: 基于驾驶行为量化特征的电动汽车剩余续驶里程预测
size: [960, 540]
fonts:
  思源宋体: { family: "Source Han Serif CN" }
  霞鹜新晰黑: { family: "LXGW Neo XiHei" }
theme:
  colors:
    primary: "#1F5B97"
    accent: "#3578B5"
    bg: "#FFFFFF"
    text: "#1B2B3A"
    muted: "#65788A"
    line: "#C9D6E2"
    success: "#2F6B57"
    warning: "#B4872D"
    danger: "#B33E38"
    primarySoft: "#EFF4F8"
    primaryTint: "#D8E5F0"
    primaryDeep: "#123E6C"
    accent3: "#4C83B5"
    accent4: "#86A9C8"
    accent5: "#31587A"
    accent6: "#B8CDDE"
  textStyles:
    display:
      fontFamily: "Source Han Serif CN"
      fontSize: 44
      color: "#FFFFFF"
      bold: true
      lineHeight: 1.35
    pageTitle:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 23
      color: "$primaryDeep"
      bold: true
      lineHeight: 1.25
    statement:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 19
      color: "$primaryDeep"
      bold: true
      lineHeight: 1.35
    heading:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 13
      color: "$primary"
      bold: true
      lineHeight: 1.35
    body:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 15
      color: "$text"
      lineHeight: 1.45
    caption:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 9.5
      color: "$muted"
      lineHeight: 1.35
    label:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 10
      color: "$primary"
      bold: true
      letterSpacing: 0.8
      lineHeight: 1.3
    stat:
      fontFamily: "Source Han Serif CN"
      fontSize: 28
      color: "$primary"
      bold: true
      lineHeight: 1.15
    nav:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 8.5
      color: "$muted"
      lineHeight: 1.2
    takeaway:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 15
      color: "#FFFFFF"
      bold: true
      lineHeight: 1.3
  tableStyles:
    blue:
      cellStyle:
        fontSize: 11
        fontFamily: "LXGW Neo XiHei"
        color: "$text"
        align: [center, middle]
        fill: { type: solid, color: "#FFFFFF" }
        border: [null, null, { style: solid, width: 0.75, color: "$line" }, null]
        lineHeight: 1.25
      firstRowStyle:
        fill: { type: solid, color: "$primary" }
        color: "#FFFFFF"
        bold: true
        fontSize: 10.5
        border: null
      bodyStyles:
        - { fill: { type: solid, color: "#FFFFFF" } }
        - { fill: { type: solid, color: "$primarySoft" } }
      lastRowStyle:
        border: [null, null, { style: solid, width: 1.2, color: "$primary" }, null]
      rowOverColumn: true
    formula:
      cellStyle:
        fontSize: 9.5
        fontFamily: "LXGW Neo XiHei"
        color: "$text"
        align: [center, middle]
        fill: { type: solid, color: "#FFFFFF" }
        border: [null, null, { style: solid, width: 0.75, color: "$line" }, null]
        lineHeight: 1.15
      firstRowStyle:
        fill: { type: solid, color: "$primary" }
        color: "#FFFFFF"
        bold: true
        fontSize: 10
        border: null
      bodyStyles:
        - { fill: { type: solid, color: "#FFFFFF" } }
        - { fill: { type: solid, color: "$primarySoft" } }
      lastRowStyle:
        border: [null, null, { style: solid, width: 1.2, color: "$primary" }, null]
      rowOverColumn: true
    blueCompact:
      cellStyle:
        fontSize: 10.5
        fontFamily: "LXGW Neo XiHei"
        color: "$text"
        align: [center, middle]
        fill: { type: solid, color: "#FFFFFF" }
        border: [null, null, { style: solid, width: 0.75, color: "$line" }, null]
        lineHeight: 1.2
      firstRowStyle:
        fill: { type: solid, color: "$primary" }
        color: "#FFFFFF"
        bold: true
        fontSize: 10
        border: null
      bodyStyles:
        - { fill: { type: solid, color: "#FFFFFF" } }
        - { fill: { type: solid, color: "$primarySoft" } }
      lastRowStyle:
        border: [null, null, { style: solid, width: 1.2, color: "$primary" }, null]
      rowOverColumn: true
pages:
  - pages/01_cover.page
  - pages/02_background.page
  - pages/03_question.page
  - pages/04_data.page
  - pages/05_indicators.page
  - pages/06_thresholds.page
  - pages/07_rf.page
  - pages/08_factor.page
  - pages/09_lstm.page
  - pages/10_training.page
  - pages/11_validation.page
  - pages/12_discussion.page
  - pages/13_conclusion.page
  - pages/14_references.page
  - pages/15_final.page
