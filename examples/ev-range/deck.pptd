version: v2
title: 基于驾驶行为量化特征的电动汽车剩余续驶里程预测
size: [960, 540]
fonts:
  思源宋体: { family: "Source Han Serif CN" }
  霞鹜新晰黑: { family: "LXGW Neo XiHei" }
theme:
  colors:
    primary: "#1F5FBF"
    primaryDeep: "#123B7A"
    accent: "#2F80ED"
    bg: "#FFFFFF"
    text: "#1B2A3A"
    muted: "#5F7186"
    line: "#D6E4F7"
    success: "#2F6B57"
    warning: "#C98A2B"
    danger: "#B54A3F"
    primarySoft: "#EAF2FF"
    primaryTint: "#D6E6FB"
    accent3: "#5B9BF5"
    accent4: "#8FBDFA"
    accent5: "#2A5FA8"
    accent6: "#BFD8F7"
  textStyles:
    display:
      fontFamily: "Source Han Serif CN"
      fontSize: 40
      color: "#FFFFFF"
      bold: true
      lineHeight: 1.3
    title:
      fontFamily: "Source Han Serif CN"
      fontSize: 23
      color: "$primaryDeep"
      bold: true
      lineHeight: 1.25
    heading:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 12.5
      color: "$primary"
      bold: true
      lineHeight: 1.35
    body:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 11
      color: "$text"
      lineHeight: 1.55
    caption:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 8.8
      color: "$muted"
      lineHeight: 1.4
    label:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 9
      color: "$primary"
      letterSpacing: 1
      lineHeight: 1.3
    kicker:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 10
      color: "$accent"
      letterSpacing: 2
      lineHeight: 1.3
    stat:
      fontFamily: "Source Han Serif CN"
      fontSize: 27
      color: "$primary"
      bold: true
      lineHeight: 1.15
    nav:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 8.5
      color: "$muted"
      lineHeight: 1.2
    coverLabel:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 9.5
      color: "$primaryTint"
      letterSpacing: 1.5
      lineHeight: 1.3
  tableStyles:
    blue:
      cellStyle:
        fontSize: 10
        fontFamily: "LXGW Neo XiHei"
        color: "$text"
        align: [center, middle]
        fill: { type: solid, color: "#FFFFFF" }
        border: [null, null, { style: solid, width: 0.75, color: "$line" }, null]
        lineHeight: 1.3
      firstRowStyle:
        fill: { type: solid, color: "$primary" }
        color: "#FFFFFF"
        bold: true
        fontSize: 10
        border: null
      bodyStyles:
        - { fill: { type: solid, color: "#FFFFFF" } }
        - { fill: { type: solid, color: "#F6FAFF" } }
      lastRowStyle:
        border:
          - null
          - null
          - { style: solid, width: 1, color: "$primary" }
          - null
      rowOverColumn: true
    formula:
      cellStyle:
        fontSize: 8.2
        fontFamily: "LXGW Neo XiHei"
        color: "$text"
        align: [center, middle]
        fill: { type: solid, color: "#FFFFFF" }
        border: [null, null, { style: solid, width: 0.75, color: "$line" }, null]
        lineHeight: 1.15
      firstRowStyle:
        fill: { type: solid, color: "$primary" }
        color: "#FFFFFF"
        bold: true
        fontSize: 8.2
        border: null
      bodyStyles:
        - { fill: { type: solid, color: "#FFFFFF" } }
        - { fill: { type: solid, color: "#F6FAFF" } }
      lastRowStyle:
        border:
          - null
          - null
          - { style: solid, width: 1, color: "$primary" }
          - null
      rowOverColumn: true
    blueCompact:
      cellStyle:
        fontSize: 9
        fontFamily: "LXGW Neo XiHei"
        color: "$text"
        align: [center, middle]
        fill: { type: solid, color: "#FFFFFF" }
        border: [null, null, { style: solid, width: 0.75, color: "$line" }, null]
        lineHeight: 1.25
      firstRowStyle:
        fill: { type: solid, color: "$primary" }
        color: "#FFFFFF"
        bold: true
        fontSize: 8.8
        border: null
      bodyStyles:
        - { fill: { type: solid, color: "#FFFFFF" } }
        - { fill: { type: solid, color: "#F6FAFF" } }
      lastRowStyle:
        border:
          - null
          - null
          - { style: solid, width: 1, color: "$primary" }
          - null
      rowOverColumn: true
pages:
  - pages/01_cover.page
  - pages/02_background.page
  - pages/03_question.page
  - pages/04_data.page
  - pages/05_indicators.page
  - pages/06_thresholds.page
  - pages/07_rf.page
  - pages/08_factor.page
  - pages/09_lstm.page
  - pages/10_training.page
  - pages/11_validation.page
  - pages/12_discussion.page
  - pages/13_conclusion.page
  - pages/14_references.page
  - pages/15_final.page
