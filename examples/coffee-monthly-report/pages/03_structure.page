pageType: content
background:
  type: solid
  color: "$bg"
notes: 汇报要点：现磨咖啡占 58.4% 是基本盘；外卖占比连续 3 个月提升（4 月 14.6% → 5 月 15.8%），但单店净利率仍稳定在 17.0%，说明外卖增量没有侵蚀利润，主要因为增量订单落在租金更轻的快取店。
elements:
  # —— 页眉 ——
  - elementId: kicker
    elementType: text
    bounds: [40, 22, 600, 16]
    content:
      style: "$kicker"
      text: 03 / 收入结构
  - elementId: title
    elementType: text
    bounds: [40, 40, 880, 32]
    content:
      style: "$title"
      text: 现磨咖啡占六成基本盘，外卖占比<strong>连续 3 个月提升</strong>
  - elementId: subtitle
    elementType: text
    bounds: [40, 74, 880, 18]
    content:
      style: "$subtitle"
      text: 品类营收构成与单店利润拆解 · 单店净利率 17.0%，与上月持平
  - elementId: headerLine
    elementType: shape
    bounds: [40, 100, 880, 1]
    shapeName: rect
    fill: { type: solid, color: "$line" }
  # —— 左：品类营收占比（环形图）——
  - elementId: pieBlockIcon
    elementType: icon
    bounds: [40, 109, 16, 16]
    iconName: "bs:pie-chart"
    fill: { type: solid, color: "$accent" }
  - elementId: pieBlockTitle
    elementType: text
    bounds: [64, 110, 280, 18]
    content:
      fontFamily: "Alimama ShuHeiTi"
      fontSize: 13
      color: "$text"
      text: 品类营收占比
  - elementId: pieBlockCaption
    elementType: text
    bounds: [300, 112, 170, 16]
    content:
      style: "$caption"
      align: [right, top]
      text: 5 月 · 合计 4,392 万元
  - elementId: categoryPie
    elementType: chart
    bounds: [40, 138, 430, 292]
    data:
      cols: [品类, 营收]
      rows:
        - [现磨咖啡, 2565]
        - [轻食, 711]
        - [外卖, 694]
        - [周边, 422]
    legend: { fontSize: 9, position: bottom }
    series:
      - type: pie
        encode: { category: 品类, value: 营收 }
        innerRadius: 0.62
        fill: ["$primary", "$accent", "$accent2", "$accent4"]
        dataLabels: { show: true, content: percentage, fontSize: 9, color: "$muted" }
  - elementId: donutCenterValue
    elementType: text
    bounds: [188, 250, 134, 26]
    content:
      fontFamily: "Alimama ShuHeiTi"
      fontSize: 17
      color: "$primary"
      align: [center, middle]
      text: 4,392 万
  - elementId: donutCenterLabel
    elementType: text
    bounds: [188, 276, 134, 16]
    content:
      fontFamily: "MiSans"
      fontSize: 9
      color: "$muted"
      align: [center, top]
      text: 5 月营收（万元）
  # —— 右：单店月利润拆解（瀑布图）——
  - elementId: wfBlockIcon
    elementType: icon
    bounds: [500, 109, 16, 16]
    iconName: "bs:bar-chart-line"
    fill: { type: solid, color: "$accent" }
  - elementId: wfBlockTitle
    elementType: text
    bounds: [524, 110, 300, 18]
    content:
      fontFamily: "Alimama ShuHeiTi"
      fontSize: 13
      color: "$text"
      text: 单店月利润拆解（万元）
  - elementId: wfBlockCaption
    elementType: text
    bounds: [760, 112, 160, 16]
    content:
      style: "$caption"
      align: [right, top]
      text: 口径：126 店月均加权
  - elementId: storeProfitWaterfall
    elementType: chart
    bounds: [500, 138, 420, 292]
    data:
      cols: [项目, 金额, 合计]
      rows:
        - [单店营收, 34.8, true]
        - [原料成本, -13.9, null]
        - [房租物业, -5.2, null]
        - [人力成本, -7.3, null]
        - [能源杂费, -2.5, null]
        - [单店净利, 5.9, true]
    xAxis:
      axisLine: false
      label: { fontSize: 9.5, color: "$muted" }
    yAxis:
      axisLine: false
      gridLine: { color: "$line" }
      label: { fontSize: 9, color: "$muted" }
    series:
      - type: waterfall
        encode: { x: 项目, y: 金额, isTotal: 合计 }
        totalBars: { fill: "$primary" }
        increaseBars: { fill: "$accent" }
        decreaseBars: { fill: "$accent5" }
        dataLabels: { show: true, fontSize: 8.5, color: "$muted", numberFormat: "0.0" }
  # —— 底部结论条 ——
  - elementId: insightBar
    elementType: shape
    bounds: [40, 446, 4, 54]
    shapeName: rect
    fill: { type: solid, color: "$accent" }
  - elementId: insightBox
    elementType: shape
    bounds: [40, 446, 880, 54]
    shapeName: rect
    fill: { type: solid, color: "$primarySoft" }
  - elementId: insightText
    elementType: text
    bounds: [60, 446, 844, 54]
    content:
      fontFamily: "MiSans"
      fontSize: 12
      color: "$text"
      align: [left, middle]
      lineHeight: 1.5
      text: |
        <p><strong>结论：</strong>外卖占比升至 15.8% 而单店净利率稳定在 17.0%，增量订单未侵蚀利润——主因外卖放量集中在租金、人力更轻的快取店；现磨咖啡仍是利润基本盘。</p>
  # —— 页脚 ——
  - elementId: footerLeft
    elementType: text
    bounds: [40, 519, 420, 14]
    content:
      style: "$caption"
      text: 屿间咖啡 · 2026 年 5 月经营月报
  - elementId: footerRight
    elementType: text
    bounds: [520, 519, 400, 14]
    content:
      style: "$caption"
      align: [right, top]
      text: 03 / 05 · 数据截至 2026-05-31 · 财务口径
