version: v2
title: 屿间咖啡 2026 年 5 月经营月报
size: [960, 540]
fonts:
  阿里妈妈数黑体: { family: "Alimama ShuHeiTi" }
  MiSans: { family: "MiSans" }
theme:
  colors:
    primary: "#3D2C4F"
    accent: "#8B5FC7"
    bg: "#F5F1F8"
    text: "#2C2436"
    muted: "#8B7F97"
    line: "#E3DCEA"
    success: "#5F7A52"
    warning: "#B0781C"
    danger: "#A64B32"
    primarySoft: "#EDE7F4"
    primaryTint: "#DCD1E8"
    primaryDeep: "#221831"
    accent2: "#7A5BA8"
    accent3: "#C9A87C"
    accent4: "#6E7F5E"
    accent5: "#9A8B7A"
    accent6: "#5A4773"
  textStyles:
    title:
      fontFamily: "Alimama ShuHeiTi"
      fontSize: 22
      color: "$text"
      lineHeight: 1.25
    subtitle:
      fontFamily: "MiSans"
      fontSize: 12
      color: "$muted"
      lineHeight: 1.4
    body:
      fontFamily: "MiSans"
      fontSize: 13
      color: "$text"
      lineHeight: 1.55
    caption:
      fontFamily: "MiSans"
      fontSize: 9
      color: "$muted"
      lineHeight: 1.35
    kicker:
      fontFamily: "Alimama ShuHeiTi"
      fontSize: 10
      color: "$accent"
      letterSpacing: 2
      lineHeight: 1.2
    quote:
      fontFamily: "MiSans"
      fontSize: 13
      color: "$muted"
      italic: true
      lineHeight: 1.5
  tableStyles:
    threeline:
      cellStyle:
        fontSize: 11
        fontFamily: "MiSans"
        color: "$text"
        align: [center, middle]
        fill: { type: solid, color: "#FFFFFF" }
        border: null
        lineHeight: 1.2
      firstRowStyle:
        bold: true
        border:
          - { style: solid, width: 2, color: "$primary" }
          - null
          - { style: solid, width: 1, color: "$primary" }
          - null
      lastRowStyle:
        bold: true
        fill: { type: solid, color: "$primarySoft" }
        border:
          - null
          - null
          - { style: solid, width: 2, color: "$primary" }
          - null
      rowOverColumn: true
    default:
      cellStyle:
        fontSize: 10
        fontFamily: "MiSans"
        color: "$text"
        fill: { type: solid, color: "#FFFFFF" }
        border: { style: solid, width: 1, color: "$line" }
        align: [center, middle]
        lineHeight: 1.2
      firstRowStyle:
        fill: { type: solid, color: "$primary" }
        color: "#FFFFFF"
        bold: true
      bodyStyles:
        - { fill: { type: solid, color: "$primarySoft" } }
        - { fill: { type: solid, color: "#FFFFFF" } }
      rowOverColumn: true
pages:
  - pages/01_cover.page
  - pages/02_overview.page
  - pages/03_structure.page
  - pages/04_stores.page
  - pages/05_conclusion.page
