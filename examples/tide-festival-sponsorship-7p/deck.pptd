version: v2
title: 潮汐音乐节 TIDAL FEST 2026 · 招商合作方案
size: [960, 540]

fonts:
  站酷庆科黄油体: { family: "ZCOOL QingKe HuangYou" }
  霞鹜新晰黑: { family: "LXGW Neo XiHei" }

theme:
  colors:
    primaryDeep: "#241436"        # 暮紫：深色底 / 夜空
    bg: "#3B2358"    # 深紫：辅助深 / 深底上的浅一层
    primary: "#FF6B4A"        # 珊瑚橙：落日 / 高亮（深底文字、色块）
    accent: "#D94F2B"    # 珊瑚橙加深：浅底上的小字强调（保证对比度）
    primarySoft: "#FFC9B0"        # 蜜桃：过渡 / 深底次要文字
    accent4: "#FFE9DD"    # 蜜桃极浅：表格高亮列底色
    primaryTint: "#FFF4EA"        # 奶油：浅底 / 深底主文字
    text: "#2A1A3E"         # 浅底正文
    muted: "#7A6A8C"        # 浅底次要文字
    accent5: "#B9A3D6"    # 深底次要文字（薰衣草紫）
    line: "#EADBCB"         # 浅底分隔细线
    accent6: "#4A3170"     # 深底分隔细线
  textStyles:
    kicker:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 10.5
      bold: true
      letterSpacing: 3
      color: "$bg"
    disp:
      fontFamily: "ZCOOL QingKe HuangYou"
      fontSize: 28
      color: "$primaryDeep"
      lineHeight: 1.25
    h3:
      fontFamily: "ZCOOL QingKe HuangYou"
      fontSize: 15
      color: "$primaryDeep"
      lineHeight: 1.35
    body:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 12
      color: "$text"
      lineHeight: 1.65
    small:
      fontFamily: "LXGW Neo XiHei"
      fontSize: 10.5
      color: "$muted"
      lineHeight: 1.5
  tableStyles:
    default:
      cellStyle:
        fontSize: 11
        fontFamily: "LXGW Neo XiHei"
        color: "$text"
        fill: { type: solid, color: "#FFFFFF" }
        border: [null, null, { style: solid, width: 0.75, color: "$line" }, null]
        align: [center, middle]
      firstRowStyle:
        fill: { type: solid, color: "$primaryDeep" }
        color: "$primaryTint"
        bold: true
        fontSize: 11
      rowOverColumn: true

pages:
  - pages/1_cover.page
  - pages/2_concept.page
  - pages/3_lineup.page
  - pages/4_numbers.page
  - pages/5_tiers.page
  - pages/6_activation.page
  - pages/7_contact.page
