    fill: { type: solid, color: "$primaryTint" }
    border: { style: solid, width: 1, color: "$primary" }

  - elementId: node-read-db-text
    elementType: text
    bounds: [736, 286, 130, 42]
    content:
      fontFamily: "MiSans"
      fontSize: 11
      bold: true
      color: "$primary"
      align: [center, middle]
