    fill: { type: solid, color: "#FFFFFF" }
    border: { style: solid, width: 1, color: "$primary" }

  - elementId: node-query-api-text
    elementType: text
    bounds: [736, 384, 130, 42]
    content:
      fontFamily: "MiSans"
      fontSize: 11
      bold: true
      color: "$primary"
      align: [center, middle]
      text: 查询服务

  - elementId: path-write-label
    elementType: text
    bounds: [544, 148, 150, 18]
    content:
      style: "$small"
      color: "$accent"
      align: [center, middle]
      text: 唯一同步路径

  - elementId: path-read-label
    elementType: text
    bounds: [620, 342, 170, 20]
    content:
      style: "$small"
      color: "$primary"
      align: [right, middle]
      text: 读路径 / 最终一致

  - elementId: arrow-client-gateway
    elementType: line
    bounds: [148, 182, 32, 10]
    viewBox: [32, 10]
    points: "0,5 32,5"
    curve: sharp
    arrow: [null, stealth]
    border: { style: solid, width: 1.5, color: "$primary" }

  - elementId: arrow-gateway-command
    elementType: line
    bounds: [310, 182, 32, 10]
    viewBox: [32, 10]
    points: "0,5 32,5"
    curve: sharp
    arrow: [null, stealth]
    border: { style: solid, width: 1.5, color: "$primary" }

  - elementId: arrow-command-db
    elementType: line
    bounds: [512, 182, 32, 10]
    viewBox: [32, 10]
    points: "0,5 32,5"
    curve: sharp
    arrow: [null, stealth]
    border: { style: solid, width: 2, color: "$accent" }

  - elementId: arrow-command-mq
    elementType: line
    bounds: [422, 208, 8, 78]
    viewBox: [8, 78]
    points: "4,0 4,78"
    curve: sharp
    arrow: [null, stealth]
    border: { style: solid, width: 1.5, color: "$accent" }

  - elementId: arrow-mq-processor
    elementType: line
    bounds: [492, 302, 32, 10]
    viewBox: [32, 10]
    points: "0,5 32,5"
    curve: sharp
    arrow: [null, stealth]
    border: { style: solid, width: 1.5, color: "$primary" }

  - elementId: arrow-processor-read
    elementType: line
    bounds: [704, 302, 32, 10]
    viewBox: [32, 10]
    points: "0,5 32,5"
    curve: sharp
    arrow: [null, stealth]
    border: { style: solid, width: 1.5, color: "$primary" }

  - elementId: arrow-read-query
    elementType: line
    bounds: [796, 328, 8, 56]
    viewBox: [8, 56]
    points: "4,0 4,56"
    curve: sharp
    arrow: [null, stealth]
    border: { style: solid, width: 1.5, color: "$primary" }

  - elementId: legend-solid
    elementType: shape
    bounds: [48, 438, 40, 2]
    shapeName: rect
    fill: { type: solid, color: "$primary" }

  - elementId: legend-solid-text
    elementType: text
    bounds: [100, 428, 130, 22]
    content:
      style: "$small"
      align: [left, middle]
      text: 同步调用

  - elementId: legend-async
    elementType: line
    bounds: [190, 439, 40, 2]
    viewBox: [40, 2]
    points: "0,1 40,1"
    curve: sharp
    border: { style: dash, width: 1.5, color: "$accent" }

  - elementId: legend-async-text
    elementType: text
    bounds: [242, 428, 150, 22]
    content:
      style: "$small"
      align: [left, middle]
      text: 异步事件投影

  - elementId: key-change
    elementType: text
    bounds: [48, 476, 864, 44]
    content:
      fontFamily: "MiSans"
      fontSize: 13
      color: "$text"
      lineHeight: 1.6
      align: [left, top]
      text: |
        <p><strong>变化</strong>：外部库存 / 支付 / 履约由同步等待改为事件通知；查询服务只读查询库，峰值读流量不再与写事务争抢主库。</p>
