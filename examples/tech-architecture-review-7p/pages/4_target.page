pageType: content
background:
  type: solid
  color: "$bg"
notes: |
  目标架构只保留一条同步写路径：命令落库。查询、外部通知与事件投影全部异步化，故障半径被隔离。
elements:
  - elementId: section-rule
    elementType: shape
    bounds: [48, 36, 3, 26]
    shapeName: rect
    fill: { type: solid, color: "$accent" }

  - elementId: section-label
    elementType: text
    bounds: [64, 38, 360, 22]
    content:
      style: "$eyebrow"
      align: [left, middle]
      text: 03 / 目标架构

  - elementId: page-number
    elementType: text
    bounds: [820, 38, 92, 22]
    content:
      style: "$small"
      align: [right, middle]
      text: "04 / 07"

  - elementId: title
    elementType: text
    bounds: [48, 70, 864, 42]
    content:
      style: "$title"
      align: [left, middle]
      text: 目标：命令与查询分离，写链路只保留一次落库

  - elementId: subtitle
    elementType: text
    bounds: [48, 116, 864, 24]
    content:
      style: "$subtitle"
      align: [left, middle]
      text: 同步路径只剩“命令落库”；查询与外部通知异步解耦。

  - elementId: header-rule
    elementType: shape
    bounds: [48, 146, 864, 1]
    shapeName: rect
    fill: { type: solid, color: "$line" }

  - elementId: node-client
    elementType: shape
    bounds: [48, 166, 100, 42]
    shapeName: rect
    fill: { type: solid, color: "#FFFFFF" }
    border: { style: solid, width: 1, color: "$primary" }

  - elementId: node-client-text
    elementType: text
    bounds: [48, 166, 100, 42]
    content:
      fontFamily: "MiSans"
      fontSize: 12
      bold: true
      color: "$primary"
      align: [center, middle]
      text: 客户端

  - elementId: node-gateway
    elementType: shape
    bounds: [180, 166, 130, 42]
    shapeName: rect
    fill: { type: solid, color: "#FFFFFF" }
    border: { style: solid, width: 1, color: "$primary" }

  - elementId: node-gateway-text
    elementType: text
    bounds: [180, 166, 130, 42]
    content:
      fontFamily: "MiSans"
      fontSize: 12
      bold: true
      color: "$primary"
      align: [center, middle]
      text: 接入网关

  - elementId: node-command
    elementType: shape
    bounds: [342, 166, 170, 42]
    shapeName: rect
    fill: { type: solid, color: "$primary" }
    border: { style: solid, width: 1, color: "$primary" }

  - elementId: node-command-text
    elementType: text
    bounds: [342, 166, 170, 42]
    content:
      fontFamily: "MiSans"
      fontSize: 12
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: 订单命令服务

  - elementId: node-write-db
    elementType: shape
    bounds: [544, 166, 150, 42]
    shapeName: rect
    fill: { type: solid, color: "$primaryDeep" }
    border: { style: solid, width: 1, color: "$primaryDeep" }

  - elementId: node-write-db-text
    elementType: text
    bounds: [544, 166, 150, 42]
    content:
      fontFamily: "MiSans"
      fontSize: 11
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: 订单主库（写）

  - elementId: node-mq
    elementType: shape
    bounds: [342, 286, 150, 42]
    shapeName: rect
    fill: { type: solid, color: "$primarySoft" }
    border: { style: solid, width: 1, color: "$primary" }

  - elementId: node-mq-text
    elementType: text
    bounds: [342, 286, 150, 42]
    content:
      fontFamily: "MiSans"
      fontSize: 11
      bold: true
      color: "$primary"
      align: [center, middle]
      text: Kafka 事件流

  - elementId: node-processor
    elementType: shape
    bounds: [524, 286, 180, 42]
    shapeName: rect
    fill: { type: solid, color: "$primarySoft" }
    border: { style: solid, width: 1, color: "$primary" }

  - elementId: node-processor-text
    elementType: text
    bounds: [524, 286, 180, 42]
    content:
      fontFamily: "MiSans"
      fontSize: 11
      bold: true
      color: "$primary"
