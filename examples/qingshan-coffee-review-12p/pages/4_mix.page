        - [非咖饮品, 512]
        - [烘焙轻食, 438]
        - [周边零售, 295]
    series:
      - type: pie
        encode: {category: 品类, value: 销售额}
        innerRadius: 0.58
        startAngle: 0
        fill: ["$primary", "$accent", "$accent3", "$accent4"]
        dataLabels: {show: true, content: percentage, numberFormat: "0%", fontSize: 10.5, color: "#FFFFFF"}
  - elementId: donut-center
    elementType: text
    bounds: [212, 266, 126, 60]
    content:
      align: [center, middle]
      text: |
        <p><span style="font-size:10.5px; color:$muted;">H1 总销售额</span></p>
        <p><span style="font-size:20px; font-family:Source Han Serif CN; color:$primary; font-weight:bold;">¥2,731 万</span></p>
