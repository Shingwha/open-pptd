pageType: content
background: {type: solid, color: "$bg"}
notes: 结构页：回答"增长从哪来"。咖啡饮品是基本盘但占比在降，非咖 +42% 是上半年最快的增量，烘焙的连带率还有空间。右轴四行按占比从高到低。
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 42, 520, 20]
    content:
      style: "$kicker"
      text: "02 · 品类结构 CATEGORY MIX"
  - elementId: dot1
    elementType: shape
    bounds: [862, 44, 8, 8]
    shapeName: ellipse
