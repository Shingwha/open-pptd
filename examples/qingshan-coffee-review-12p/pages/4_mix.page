  - elementId: dot2
    elementType: shape
    bounds: [876, 44, 8, 8]
    shapeName: ellipse
    fill: {type: solid, color: "$accent"}
  - elementId: dot3
    elementType: shape
    bounds: [890, 44, 8, 8]
    shapeName: ellipse
    fill: {type: solid, color: "$line"}
  - elementId: dot4
    elementType: shape
    bounds: [904, 44, 8, 8]
    shapeName: ellipse
    fill: {type: solid, color: "$line"}
  - elementId: dot5
    elementType: shape
    bounds: [918, 44, 8, 8]
    shapeName: ellipse
    fill: {type: solid, color: "$line"}
