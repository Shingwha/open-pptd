version: v2
title: "MORI 森野 · 城市户外生活方式品牌提案"
size: [960, 540]
fonts:
  阿里妈妈数黑体: { family: "Alimama ShuHeiTi" }
  霞鹜新晰黑: { family: "LXGW Neo XiHei" }
theme:
  colors:
    primary: "#12100E"
    accent: "#E23A1E"
    bg: "#F5F2EA"
    text: "#12100E"
    muted: "#6F6A61"
    line: "#D8D2C5"
    success: "#3F7A5B"
    warning: "#C2901D"
    danger: "#C7431E"
    primarySoft: "#ECE8DE"
    primaryTint: "#D9D3C6"
    primaryDeep: "#12100E"
    accent3: "#A8A093"
    accent4: "#80786C"
    accent5: "#56504A"
    accent6: "#C77A5F"
  textStyles:
    eyebrow: { fontFamily: "LXGW Neo XiHei", fontSize: 10, color: "$muted", bold: true, letterSpacing: 3, lineHeight: 1.3 }
    title: { fontFamily: "Alimama ShuHeiTi", fontSize: 44, color: "$text", bold: true, lineHeight: 1.05 }
    subtitle: { fontFamily: "LXGW Neo XiHei", fontSize: 15, color: "$muted", lineHeight: 1.55 }
    body: { fontFamily: "LXGW Neo XiHei", fontSize: 15, color: "$text", lineHeight: 1.7 }
    small: { fontFamily: "LXGW Neo XiHei", fontSize: 10, color: "$muted", lineHeight: 1.45 }
    metric: { fontFamily: "Alimama ShuHeiTi", fontSize: 72, color: "$text", bold: true, lineHeight: 0.95 }
  tableStyles:
    default:
      cellStyle: { fontFamily: "LXGW Neo XiHei", fontSize: 12, color: "$text", fill: { type: "solid", color: "#F5F2EA" }, border: [null, null, { style: "solid", width: 1, color: "$line" }, null], align: ["center", "middle"] }
      firstRowStyle: { fill: { type: "solid", color: "$primary" }, color: "#FFFFFF", bold: true }
      bodyStyles:
        - { fill: { type: "solid", color: "$primarySoft" } }
        - { fill: { type: "solid", color: "#F5F2EA" } }
      rowOverColumn: true
pages:
  - pages/1_cover.page
  - pages/2_manifesto.page
  - pages/3_name.page
  - pages/4_visual_system.page
  - pages/5_applications.page
  - pages/6_launch.page
  - pages/7_closing.page
