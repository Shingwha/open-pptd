    bounds: [336, 449, 6, 6]
    shapeName: rect
    fill: {type: solid, color: "$accent"}

  - elementId: tl-node-3
    elementType: shape
    bounds: [624, 449, 6, 6]
    shapeName: rect
    fill: {type: solid, color: "$accent"}

  - elementId: tl-node-4
    elementType: shape
    bounds: [906, 449, 6, 6]
    shapeName: rect
    fill: {type: solid, color: "$accent"}

  - elementId: tl-item-1
