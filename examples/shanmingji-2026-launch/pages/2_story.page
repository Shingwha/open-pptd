        <p><span style="font-family:'Alimama DongFangDaKai'; font-size:15px; color:$primary;">2016</span></p>
        <p><span style="font-family:'LXGW Neo XiHei'; font-size:10px; color:$muted;">创立于武夷山天心村</span></p>

  - elementId: tl-item-2
    elementType: text
    bounds: [336, 408, 220, 36]
