pageType: toc
background:
  type: solid
  color: "#FFFFFF"
elements:
  - elementId: tc-title
    elementType: text
    bounds: [64, 60, 300, 44]
    content:
      style: "$title"
      fontSize: 30
      color: "$text"
      align: [left, middle]
      text: '本期内容'
  - elementId: tc-title-en
    elementType: text
    bounds: [64, 106, 300, 22]
    content:
      fontSize: 13
      color: "$muted"
      align: [left, middle]
      letterSpacing: 3
      text: 'CONTENTS'
  - elementId: tc-line
    elementType: shape
    bounds: [64, 142, 52, 3]
    shapeName: roundRect
    adjustments: [50000]
    fill: {color: "$primary"}
  - elementId: tc-c1
    elementType: shape
    bounds: [64, 172, 400, 70]
    shapeName: roundRect
    adjustments: [14000]
    fill: {color: "$primary-soft"}
  - elementId: tc-n1
    elementType: text
    bounds: [84, 184, 40, 46]
    content:
      fontSize: 16
      bold: true
      color: "$primary"
      align: [center, middle]
      text: '01'
  - elementId: tc-name1
    elementType: text
    bounds: [136, 182, 316, 26]
    content:
      fontSize: 15
      bold: true
      color: "$text"
      align: [left, middle]
      text: 家的呼吸感
  - elementId: tc-desc1
