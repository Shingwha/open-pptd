pageType: content
background:
  type: solid
  color: "#FFFFFF"
elements:
  # —— 页眉 ——
  - elementId: ov-title
    elementType: text
    bounds: [48, 36, 400, 34]
    content:
      style: "$title"
      fontSize: 22
      color: "$text"
      align: [left, middle]
      text: '手作器物志'
  - elementId: ov-titlebar
    elementType: shape
    bounds: [48, 74, 52, 4]
    shapeName: roundRect
    adjustments: [50000]
    fill: {color: "$primary"}
  - elementId: ov-page
    elementType: text
    bounds: [872, 36, 48, 28]
    content:
      fontSize: 13
      bold: true
      color: "$primary"
      align: [right, middle]
      text: '03'
  - elementId: ov-foot
    elementType: text
    bounds: [48, 508, 420, 20]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, middle]
      text: '慢调编辑部  ｜  2025'
  # —— 器物一 ——
  - elementId: ov-i1
    elementType: shape
    bounds: [48, 104, 420, 150]
    shapeName: roundRect
    adjustments: [14000]
    fill: {color: "$primary-soft"}
  - elementId: ov-i1-n
    elementType: text
    bounds: [72, 124, 60, 26]
    content:
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '壹'
  - elementId: ov-i1-name
    elementType: text
    bounds: [72, 158, 300, 34]
    content:
      fontSize: 18
      bold: true
      color: "$text"
      align: [left, middle]
      text: '柴烧杯 · 灰釉'
  - elementId: ov-i1-d
    elementType: text
    bounds: [72, 202, 340, 34]
    content:
      fontSize: 13
      color: "$muted"
      align: [left, top]
      text: '茶席器物，手捏成型，柴窑落灰成釉'
  # —— 器物二（错落）——
  - elementId: ov-i2
    elementType: shape
    bounds: [492, 120, 420, 150]
    shapeName: roundRect
    adjustments: [14000]
    fill: {color: "$primary-tint"}
  - elementId: ov-i2-n
    elementType: text
    bounds: [516, 140, 60, 26]
    content:
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '贰'
  - elementId: ov-i2-name
    elementType: text
    bounds: [516, 174, 300, 34]
    content:
      fontSize: 18
      bold: true
      color: "$text"
      align: [left, middle]
      text: '花觚 · 青白釉'
  - elementId: ov-i2-d
    elementType: text
    bounds: [516, 218, 340, 34]
    content:
      fontSize: 13
      color: "$muted"
      align: [left, top]
      text: '夏花入瓶，釉色如玉，瓶口微敞'
  # —— 器物三（错落）——
  - elementId: ov-i3
    elementType: shape
    bounds: [48, 276, 420, 150]
    shapeName: roundRect
    adjustments: [14000]
    fill: {color: "$primary-tint"}
  - elementId: ov-i3-n
    elementType: text
    bounds: [72, 296, 60, 26]
    content:
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '叁'
  - elementId: ov-i3-name
    elementType: text
    bounds: [72, 330, 300, 34]
    content:
      fontSize: 18
      bold: true
      color: "$text"
      align: [left, middle]
      text: '食器 · 米白釉'
  - elementId: ov-i3-d
    elementType: text
    bounds: [72, 374, 340, 34]
    content:
      fontSize: 13
      color: "$muted"
      align: [left, top]
      text: '一粥一饭，手边的温度与分量'
  # —— 器物四（错落）——
  - elementId: ov-i4
    elementType: shape
    bounds: [492, 292, 420, 150]
    shapeName: roundRect
    adjustments: [14000]
    fill: {color: "$primary-soft"}
  - elementId: ov-i4-n
    elementType: text
    bounds: [516, 312, 60, 26]
    content:
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '肆'
  - elementId: ov-i4-name
    elementType: text
    bounds: [516, 346, 300, 34]
    content:
      fontSize: 18
      bold: true
      color: "$text"
      align: [left, middle]
      text: '香炉 · 铁锈釉'
  - elementId: ov-i4-d
    elementType: text
    bounds: [516, 390, 340, 34]
    content:
      fontSize: 13
      color: "$muted"
      align: [left, top]
      text: '一缕青烟，铁锈色沉着安静'
  # —— 结语 ——
  - elementId: ov-note
    elementType: text
    bounds: [48, 466, 864, 28]
    content:
      fontSize: 13
      color: "$muted"
      align: [center, middle]
      text: '器物有四季：春天做茶器，夏天做花器，泥土的温度就是日子的温度。'
