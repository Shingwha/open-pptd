pageType: chapter
background:
  type: solid
  color: "$primary-soft"
elements:
  - elementId: ch-num
    elementType: text
    bounds: [64, 100, 340, 170]
    content:
      fontSize: 150
      bold: true
      color: "$primary25"
      align: [left, top]
      text: '01'
  - elementId: ch-bar
    elementType: shape
    bounds: [64, 296, 48, 4]
    shapeName: roundRect
    adjustments: [50000]
    fill: {color: "$primary"}
  - elementId: ch-title
    elementType: text
    bounds: [92, 324, 700, 56]
    content:
      style: "$title"
      fontSize: 36
      color: "$text"
      align: [left, middle]
      text: '家的呼吸感'
  - elementId: ch-sub
    elementType: text
    bounds: [92, 392, 700, 30]
    content:
      fontSize: 16
      color: "$muted"
      align: [left, middle]
      text: '留白不是空，是让器物说话'
  - elementId: ch-foot
    elementType: text
    bounds: [64, 496, 400, 22]
    content:
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '慢调编辑部  ｜  2025'
