pageType: chapter
background:
  type: solid
  color: "#FFFFFF"
elements:
  - elementId: ch-block
    elementType: shape
    bounds: [64, 96, 240, 300]
    shapeName: roundRect
    adjustments: [16000]
    fill: {color: "$primary"}
  - elementId: ch-num
    elementType: text
    bounds: [96, 150, 180, 120]
    content:
      fontSize: 100
      bold: true
      color: "#FFFFFF"
      align: [center, top]
      text: '01'
  - elementId: ch-block-t
    elementType: text
    bounds: [96, 290, 180, 50]
    content:
      style: "$body"
      fontSize: 20
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: '科学探索营'
  - elementId: ch-title
    elementType: text
    bounds: [360, 160, 520, 60]
    content:
      style: "$title"
      fontSize: 36
      color: "$text"
      align: [left, middle]
      text: '为什么天空是蓝色的？'
  - elementId: ch-sub
    elementType: text
    bounds: [360, 240, 520, 60]
    content:
      style: "$body"
      fontSize: 16
      color: "$muted"
      align: [left, top]
      text: |
        28 天里，孩子们将亲手完成 12 个实验
        从光的散射到火箭发射，好奇心就是引擎
  - elementId: ch-tag
    elementType: shape
    bounds: [360, 340, 150, 40]
    shapeName: roundRect
    adjustments: [50000]
    fill: {color: "#FFD166"}
  - elementId: ch-tag-t
    elementType: text
    bounds: [360, 340, 150, 40]
    content:
      fontSize: 14
      bold: true
      color: "#33331A"
      align: [center, middle]
      text: '适合 8-10 岁'
  - elementId: ch-foot
    elementType: text
    bounds: [64, 496, 400, 22]
    content:
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '青芽教育  ｜  2025 暑期'
