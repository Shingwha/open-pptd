pageType: content
background:
  type: solid
  color: "#0B1220"
elements:
  # —— 页眉 ——
  - elementId: ov-title
    elementType: text
    bounds: [48, 32, 500, 34]
    content:
      fontSize: 22
      bold: true
      color: "#FFFFFF"
      align: [left, middle]
      text: 性能，重新定义
  - elementId: ov-titlebar
    elementType: shape
    bounds: [48, 70, 40, 4]
    shapeName: rect
    fill: {color: "$accent"}
  - elementId: ov-page
    elementType: text
    bounds: [872, 32, 48, 28]
    content:
      fontSize: 13
      bold: true
      color: "$accent"
      align: [right, middle]
      text: '03'
  - elementId: ov-foot
    elementType: text
    bounds: [48, 508, 420, 20]
    content:
      fontSize: 11
      color: "#FFFFFF66"
      align: [left, middle]
      text: '星核科技  ｜  2025'
  # —— 三大数字（发布会式大数字横幅）——
  - elementId: ov-n1-v
    elementType: text
    bounds: [48, 104, 250, 90]
    content:
      fontSize: 64
      bold: true
      color: "#FFFFFF"
      align: [left, top]
      text: '-68%'
  - elementId: ov-n1-l
    elementType: text
    bounds: [48, 204, 250, 24]
    content:
      fontSize: 13
      color: "#FFFFFFB3"
      align: [left, middle]
      text: '推理延迟 · vs 上代引擎'
  - elementId: ov-sep1
    elementType: line
    bounds: [310, 104, 2, 124]
    viewBox: [2, 124]
    points: "1,0 1,124"
    border: {style: solid, width: 1, color: "#FFFFFF14"}
  - elementId: ov-n2-v
    elementType: text
    bounds: [330, 104, 250, 90]
    content:
      fontSize: 64
      bold: true
      color: "$accent"
      align: [left, top]
      text: '2.3×'
  - elementId: ov-n2-l
    elementType: text
    bounds: [330, 204, 250, 24]
    content:
      fontSize: 13
      color: "#FFFFFFB3"
      align: [left, middle]
      text: '吞吐 · 每卡每秒 tokens'
  - elementId: ov-sep2
    elementType: line
    bounds: [592, 104, 2, 124]
    viewBox: [2, 124]
    points: "1,0 1,124"
    border: {style: solid, width: 1, color: "#FFFFFF14"}
  - elementId: ov-n3-v
    elementType: text
    bounds: [612, 104, 300, 90]
    content:
      fontSize: 64
      bold: true
      color: "#FFFFFF"
      align: [left, top]
      text: '99.99%'
  - elementId: ov-n3-l
    elementType: text
    bounds: [612, 204, 300, 24]
    content:
      fontSize: 13
      color: "#FFFFFFB3"
      align: [left, middle]
      text: '月度可用性 · 72h 压测零中断'
  # —— 全宽大图 ——
  - elementId: ov-c1-t
    elementType: text
    bounds: [48, 252, 420, 22]
    content:
      fontSize: 14
      bold: true
      color: "#FFFFFF"
      align: [left, middle]
      text: '三代引擎延迟与吞吐对比'
  - elementId: ov-c1-s
    elementType: text
    bounds: [700, 252, 212, 22]
    content:
      fontSize: 11
      color: "#FFFFFF99"
      align: [right, middle]
      text: '柱状图 + 折线 · 混合轴'
  - elementId: ov-c1
    elementType: chart
    bounds: [48, 278, 864, 200]
    data:
      cols: [型号, 延迟, 吞吐]
      rows:
        - [V1, 860, 62]
        - [V2, 640, 48]
        - [星核, 96, 11]
    series:
      - type: bar
        encode: {category: 型号, y: 延迟}
        name: 延迟(ms)
      - type: line
        encode: {category: 型号, y: 吞吐}
        name: 吞吐(t/s)
