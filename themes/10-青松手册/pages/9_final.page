pageType: final
background:
  type: solid
  color: "#FFFFFF"
elements:
  # —— 页眉文档头 + 装订线 ——
  - elementId: fn-topline
    elementType: shape
    bounds: [0, 0, 960, 4]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: fn-head
    elementType: text
    bounds: [48, 22, 400, 24]
    content:
      fontSize: 12
      bold: true
      color: "$primary"
      align: [left, middle]
      text: 'QH-2025-07 · 附则'
  - elementId: fn-page
    elementType: text
    bounds: [872, 22, 48, 24]
    content:
      fontSize: 13
      bold: true
      color: "$primary"
      align: [right, middle]
      text: '09'
  - elementId: fn-title
    elementType: text
    bounds: [48, 56, 600, 30]
    content:
      fontSize: 22
      bold: true
      color: "$text"
      align: [left, middle]
      text: '附则：生效与修订'
  # —— 小节 附（编号小方块）——
  - elementId: fn-sbox
    elementType: shape
    bounds: [48, 102, 24, 24]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: fn-snum
    elementType: text
    bounds: [48, 102, 24, 24]
    content:
      fontSize: 12
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: '附'
  - elementId: fn-s
    elementType: text
    bounds: [84, 102, 400, 24]
    content:
      fontSize: 15
      bold: true
      color: "$text"
      align: [left, middle]
      text: '生效条款'
  - elementId: fn-sline
    elementType: shape
    bounds: [200, 113, 40, 2]
    shapeName: rect
    fill: {color: "$accent"}
  # —— 生效条款（行首小方块 + 细线分隔）——
  - elementId: fn-b1
    elementType: shape
    bounds: [52, 146, 10, 10]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: fn-t1
    elementType: text
    bounds: [76, 140, 820, 24]
    content:
      fontSize: 14
      color: "$text"
      align: [left, middle]
      text: '本手册自 2025 年 7 月 1 日起施行，原 V1.3 版本同时废止。'
  - elementId: fn-sep1
    elementType: shape
    bounds: [48, 176, 864, 1]
    shapeName: rect
    fill: {color: "$line"}
  - elementId: fn-b2
    elementType: shape
    bounds: [52, 198, 10, 10]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: fn-t2
    elementType: text
    bounds: [76, 192, 820, 24]
    content:
      fontSize: 14
      color: "$text"
      align: [left, middle]
      text: '本手册由项目管理部负责解释；修订须经评审会批准后发布。'
  - elementId: fn-sep2
    elementType: shape
    bounds: [48, 228, 864, 1]
    shapeName: rect
    fill: {color: "$line"}
  - elementId: fn-b3
    elementType: shape
    bounds: [52, 250, 10, 10]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: fn-t3
    elementType: text
    bounds: [76, 244, 820, 24]
    content:
      fontSize: 14
      color: "$text"
      align: [left, middle]
      text: '执行中的问题与建议，请反馈至 pm-support@company.com。'
  # —— 修订记录（小表格 + 表题）——
  - elementId: fn-rstitle
    elementType: text
    bounds: [48, 296, 400, 20]
    content:
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '表 2  修订记录'
  - elementId: fn-rs
    elementType: table
    bounds: [48, 322, 560, 120]
    rows:
      - [版本, 日期, 修订内容]
      - [V2.1, 2025-06-20, 新增变更管控章节，细化验收标准]
      - [V2.0, 2024-12-15, 全章节重写，流程数字化]
      - [V1.3, 2024-03-01, 补充试点项目条款]
  # —— 右下落款（公文感）——
  - elementId: fn-sign
    elementType: text
    bounds: [620, 390, 292, 60]
    content:
      fontSize: 13
      color: "$text"
      align: [right, top]
      lineHeight: 1.7
      text: |-
        项目管理部
        2025 年 6 月 20 日
  # —— 页脚 ——
  - elementId: fn-foot
    elementType: text
    bounds: [48, 508, 420, 18]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, middle]
      text: '青松手册 · 项目管理规范手册'
  - elementId: fn-foot2
    elementType: text
    bounds: [640, 508, 272, 18]
    content:
      fontSize: 11
      color: "$muted"
      align: [right, middle]
      text: '内部资料 · 请勿外传'
