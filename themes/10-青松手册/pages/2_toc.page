pageType: toc
background:
  type: solid
  color: "#FFFFFF"
elements:
  # —— 装订线 ——
  - elementId: tc-topline
    elementType: shape
    bounds: [0, 0, 960, 4]
    shapeName: rect
    fill: {color: "$primary"}
  # —— 标题 ——
  - elementId: tc-title
    elementType: text
    bounds: [48, 56, 160, 36]
    content:
      fontSize: 26
      bold: true
      color: "$text"
      align: [left, middle]
      text: '目  录'
  - elementId: tc-line
    elementType: shape
    bounds: [48, 100, 48, 3]
    shapeName: rect
    fill: {color: "$accent"}
  # —— 书刊式目录条目（编号方块 + 点线引导 + 右对齐页码）——
  # 01 总则
  - elementId: tc-b1
    elementType: shape
    bounds: [48, 136, 28, 28]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: tc-n1
    elementType: text
    bounds: [48, 136, 28, 28]
    content:
      fontSize: 14
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: '01'
  - elementId: tc-t1
    elementType: text
    bounds: [92, 136, 300, 28]
    content:
      fontSize: 15
      bold: true
      color: "$text"
      align: [left, middle]
      text: '总  则'
  - elementId: tc-dots1
    elementType: line
    bounds: [396, 149, 420, 1]
    viewBox: [420, 1]
    points: "0,0 420,0"
    border: {style: dash, width: 1, color: "$line"}
  - elementId: tc-p1
    elementType: text
    bounds: [828, 136, 84, 28]
    content:
      fontSize: 14
      color: "$text"
      align: [right, middle]
      text: '03'
  - elementId: tc-sep1
    elementType: shape
    bounds: [48, 176, 864, 1]
    shapeName: rect
    fill: {color: "$line"}
  # 02 项目立项与计划
  - elementId: tc-b2
    elementType: shape
    bounds: [48, 188, 28, 28]
    shapeName: rect
    fill: {color: "$primary"}
