pageType: content
background:
  type: solid
  color: "#FFFFFF"
elements:
  # —— 页眉文档头（文件编号 · 章节）+ 装订线 ——
  - elementId: pc-topline
    elementType: shape
    bounds: [0, 0, 960, 4]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: pc-head
    elementType: text
    bounds: [48, 22, 400, 24]
    content:
      fontSize: 12
      bold: true
      color: "$primary"
      align: [left, middle]
      text: 'QH-2025-07 · 第 02 章'
  - elementId: pc-page
    elementType: text
    bounds: [872, 22, 48, 24]
    content:
      fontSize: 13
      bold: true
      color: "$primary"
      align: [right, middle]
      text: '04'
  - elementId: pc-title
    elementType: text
    bounds: [48, 56, 600, 30]
    content:
      fontSize: 22
      bold: true
      color: "$text"
      align: [left, middle]
      text: '项目立项与计划'
  # —— 小节 2.1 管理流程（编号小方块 + 标题 + 沙金短线）——
  - elementId: pc-s1box
    elementType: shape
    bounds: [48, 102, 24, 24]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: pc-s1num
    elementType: text
    bounds: [48, 102, 24, 24]
    content:
      fontSize: 12
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: '2.1'
  - elementId: pc-s1
    elementType: text
    bounds: [84, 102, 400, 24]
    content:
      fontSize: 15
      bold: true
      color: "$text"
      align: [left, middle]
      text: '管理流程'
  - elementId: pc-s1line
    elementType: shape
    bounds: [200, 113, 40, 2]
    shapeName: rect
    fill: {color: "$accent"}
  # —— chevron 步骤条（4 步，全 primary 统一色 + 白字）——
  - elementId: pc-step1
    elementType: shape
    bounds: [48, 144, 213, 60]
    shapeName: chevron
    adjustments: [20000]
    fill: {color: "$primary"}
  - elementId: pc-step1t
    elementType: text
    bounds: [58, 144, 195, 60]
    content:
      fontSize: 14
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: '01 · 立项'
  - elementId: pc-step2
    elementType: shape
    bounds: [261, 144, 213, 60]
    shapeName: chevron
    adjustments: [20000]
    fill: {color: "$primary"}
  - elementId: pc-step2t
    elementType: text
    bounds: [271, 144, 195, 60]
    content:
      fontSize: 14
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: '02 · 计划'
  - elementId: pc-step3
    elementType: shape
    bounds: [474, 144, 213, 60]
    shapeName: chevron
    adjustments: [20000]
    fill: {color: "$primary"}
  - elementId: pc-step3t
    elementType: text
    bounds: [484, 144, 195, 60]
    content:
      fontSize: 14
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: '03 · 执行'
  - elementId: pc-step4
    elementType: shape
    bounds: [687, 144, 225, 60]
    shapeName: chevron
    adjustments: [20000]
    fill: {color: "$primary"}
  - elementId: pc-step4t
    elementType: text
    bounds: [697, 144, 207, 60]
    content:
      fontSize: 14
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: '04 · 复盘'
  # —— 步骤说明（小字，与流程条对齐）——
  - elementId: pc-d1
    elementType: text
    bounds: [48, 212, 213, 40]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, top]
      lineHeight: 1.5
      text: |-
        需求评审与立项审批，
        明确项目章程
  - elementId: pc-d2
    elementType: text
    bounds: [261, 212, 213, 40]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, top]
      lineHeight: 1.5
      text: |-
        编制计划与预算，
        书面确认里程碑
  - elementId: pc-d3
    elementType: text
    bounds: [474, 212, 213, 40]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, top]
      lineHeight: 1.5
      text: |-
        按周跟踪进度，
        变更走审批流程
  - elementId: pc-d4
    elementType: text
    bounds: [687, 212, 225, 40]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, top]
      lineHeight: 1.5
      text: |-
        验收交付与复盘，
        沉淀改进项
  # —— 小节 2.2 计划要点 ——
  - elementId: pc-s2box
    elementType: shape
    bounds: [48, 272, 24, 24]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: pc-s2num
    elementType: text
    bounds: [48, 272, 24, 24]
    content:
      fontSize: 12
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: '2.2'
  - elementId: pc-s2
    elementType: text
    bounds: [84, 272, 400, 24]
    content:
      fontSize: 15
      bold: true
      color: "$text"
      align: [left, middle]
      text: '计划要点'
  - elementId: pc-s2line
    elementType: shape
    bounds: [180, 283, 40, 2]
    shapeName: rect
    fill: {color: "$accent"}
  # —— 清单（行首 check 图标，本页唯一图标用法）——
  - elementId: pc-c1
    elementType: icon
    bounds: [52, 316, 16, 16]
    icon: check
    fill: {color: "$primary"}
  - elementId: pc-t1
    elementType: text
    bounds: [80, 312, 820, 24]
    content:
      fontSize: 14
      color: "$text"
      align: [left, middle]
      text: '目标可量化：交付物、里程碑与预算在计划阶段书面确认'
  - elementId: pc-c2
    elementType: icon
    bounds: [52, 348, 16, 16]
    icon: check
    fill: {color: "$primary"}
  - elementId: pc-t2
    elementType: text
    bounds: [80, 344, 820, 24]
    content:
      fontSize: 14
      color: "$text"
      align: [left, middle]
      text: '依赖明确：资源与协作方职责写入计划，避免口头约定'
  - elementId: pc-c3
    elementType: icon
    bounds: [52, 380, 16, 16]
    icon: check
    fill: {color: "$primary"}
  - elementId: pc-t3
    elementType: text
    bounds: [80, 376, 820, 24]
    content:
      fontSize: 14
      color: "$text"
      align: [left, middle]
      text: '风险预案：识别 Top 5 风险并指定应对责任人'
  # —— 结论条（白底细边框 + 左竖条，区别于色块结论条）——
  - elementId: pc-conclbox
    elementType: shape
    bounds: [48, 432, 864, 46]
    shapeName: rect
    fill: {color: "#FFFFFF"}
    border: {width: 1, color: "$line"}
  - elementId: pc-conclbar
    elementType: shape
    bounds: [48, 432, 3, 46]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: pc-concl
    elementType: text
    bounds: [66, 432, 830, 46]
    content:
      fontSize: 13
      color: "$text"
      align: [left, middle]
      text: '要点：计划评审通过后方可进入执行阶段；计划变更须按 03 章流程重新评审。'
  # —— 页脚 ——
  - elementId: pc-foot
    elementType: text
    bounds: [48, 508, 420, 18]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, middle]
      text: '青松手册 · 项目管理规范手册'
  - elementId: pc-foot2
    elementType: text
    bounds: [640, 508, 272, 18]
    content:
      fontSize: 11
      color: "$muted"
      align: [right, middle]
      text: '内部资料 · 请勿外传'
