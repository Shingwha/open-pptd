pageType: content
background:
  type: solid
  color: "#FFFFFF"
elements:
  # —— 页眉文档头 + 装订线 ——
  - elementId: dt-topline
    elementType: shape
    bounds: [0, 0, 960, 4]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: dt-head
    elementType: text
    bounds: [48, 22, 400, 24]
    content:
      fontSize: 12
      bold: true
      color: "$primary"
      align: [left, middle]
      text: 'QH-2025-07 · 第 03 章'
  - elementId: dt-page
    elementType: text
    bounds: [872, 22, 48, 24]
    content:
      fontSize: 13
      bold: true
      color: "$primary"
      align: [right, middle]
      text: '05'
  - elementId: dt-title
    elementType: text
    bounds: [48, 56, 600, 30]
    content:
      fontSize: 22
      bold: true
      color: "$text"
      align: [left, middle]
      text: '执行与监控'
  # —— 小节 3.1 执行情况 ——
  - elementId: dt-s1box
    elementType: shape
    bounds: [48, 102, 24, 24]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: dt-s1num
    elementType: text
    bounds: [48, 102, 24, 24]
    content:
      fontSize: 12
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: '3.1'
  - elementId: dt-s1
    elementType: text
    bounds: [84, 102, 400, 24]
    content:
      fontSize: 15
      bold: true
      color: "$text"
      align: [left, middle]
      text: '执行情况'
  - elementId: dt-s1line
    elementType: shape
    bounds: [200, 113, 40, 2]
    shapeName: rect
    fill: {color: "$accent"}
  # —— 图 1：交付计划 vs 实际（柱状图，主题系列色）——
  - elementId: dt-c1
    elementType: chart
    bounds: [48, 132, 424, 212]
    data:
      cols: [季度, 计划交付, 实际交付]
      rows:
        - [Q1, 18, 16]
        - [Q2, 22, 20]
        - [Q3, 24, 22]
        - [Q4, 26, 24]
    series:
      - type: bar
        encode: {category: 季度, y: 计划交付}
        name: 计划交付
      - type: bar
        encode: {category: 季度, y: 实际交付}
        name: 实际交付
  - elementId: dt-c1cap
    elementType: text
    bounds: [48, 352, 424, 20]
    content:
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '图 1  2025 年各季度交付：计划 vs 实际（项）'
  # —— 表 1：里程碑计划（表题在表格上方，编号题注）——
  - elementId: dt-t1cap
    elementType: text
    bounds: [500, 132, 412, 20]
    content:
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '表 1  项目里程碑计划'
  - elementId: dt-t1
    elementType: table
    bounds: [500, 158, 412, 186]
    rows:
      - [里程碑, 计划日期, 状态]
      - [需求评审, 02-14, 已完成]
      - [方案定稿, 03-05, 已完成]
      - [试点上线, 04-18, 进行中]
      - [全量发布, 06-30, 待执行]
  # —— 数据口径说明（手册特色脚注）——
  - elementId: dt-note
    elementType: text
    bounds: [48, 392, 864, 20]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, middle]
      text: '数据口径：项目管理系统导出，截至 2025-06-30；状态定义见 3.2 节。'
  # —— 结论条（白底细边框 + 左竖条）——
  - elementId: dt-conclbox
    elementType: shape
    bounds: [48, 432, 864, 46]
    shapeName: rect
    fill: {color: "#FFFFFF"}
    border: {width: 1, color: "$line"}
  - elementId: dt-conclbar
    elementType: shape
    bounds: [48, 432, 3, 46]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: dt-concl
    elementType: text
    bounds: [66, 432, 830, 46]
    content:
      fontSize: 13
      color: "$text"
      align: [left, middle]
      text: '要点：Q2 交付达成率 91%，试点上线后进入变更管控，重点盯防 6 月底全量发布。'
  # —— 页脚 ——
  - elementId: dt-foot
    elementType: text
    bounds: [48, 508, 420, 18]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, middle]
      text: '青松手册 · 项目管理规范手册'
  - elementId: dt-foot2
    elementType: text
    bounds: [640, 508, 272, 18]
    content:
      fontSize: 11
      color: "$muted"
      align: [right, middle]
      text: '内部资料 · 请勿外传'
