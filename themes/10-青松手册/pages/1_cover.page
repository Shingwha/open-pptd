pageType: cover
background:
  type: solid
  color: "#FFFFFF"
elements:
  # —— 装订线：顶部 4px 贯穿细线（手册封面特征）——
  - elementId: cv-topline
    elementType: shape
    bounds: [0, 0, 960, 4]
    shapeName: rect
    fill: {color: "$primary"}
  # —— 左上：文件编号（小方块徽章 + 编号文字）——
  - elementId: cv-codebox
    elementType: shape
    bounds: [48, 36, 16, 16]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: cv-code
    elementType: text
    bounds: [74, 32, 300, 24]
    content:
      fontSize: 12
      bold: true
      color: "$primary"
      align: [left, middle]
      text: 'QH-2025-07 · 项目管理手册'
  # —— 右上：密级标签 ——
  - elementId: cv-sec
    elementType: text
    bounds: [720, 32, 192, 24]
    content:
      fontSize: 12
      color: "$muted"
      align: [right, middle]
      text: '密级：内部资料'
  # —— 主标题区（图标徽章 + 深绿标题 + 沙金短线）——
  - elementId: cv-badge
    elementType: shape
    bounds: [48, 176, 40, 40]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: cv-badgeicon
    elementType: icon
    bounds: [57, 185, 22, 22]
    icon: shield-check
    fill: {color: "#FFFFFF"}
  - elementId: cv-title
    elementType: text
    bounds: [104, 168, 664, 56]
    content:
      fontSize: 40
      bold: true
      color: "$primary"
      align: [left, middle]
      text: 项目管理规范手册
  - elementId: cv-line
    elementType: shape
    bounds: [108, 252, 76, 4]
    shapeName: rect
    fill: {color: "$accent"}
  - elementId: cv-sub
    elementType: text
    bounds: [104, 282, 640, 26]
    content:
      fontSize: 15
      color: "$muted"
      align: [left, middle]
      text: 项目立项 · 计划 · 执行 · 验收与复盘 全流程规范
  # —— 右下：文档属性栏（细边框信息栏，文件头气质）——
  - elementId: cv-metabox
    elementType: shape
    bounds: [620, 372, 292, 104]
    shapeName: rect
    fill: {color: "#FFFFFF"}
    border: {width: 1, color: "$line"}
  - elementId: cv-meta-title
    elementType: text
    bounds: [638, 380, 256, 20]
    content:
      fontSize: 11
      bold: true
      color: "$primary"
      align: [left, middle]
      text: '文 件 信 息'
  - elementId: cv-meta1
    elementType: text
    bounds: [638, 408, 256, 20]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: '版    本：V2.1'
  - elementId: cv-meta2
    elementType: text
    bounds: [638, 432, 256, 20]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: '生效日期：2025 年 7 月 1 日'
  - elementId: cv-meta3
    elementType: text
    bounds: [638, 456, 256, 20]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: '编制部门：项目管理部'
  # —— 页脚 ——
  - elementId: cv-foot
    elementType: text
    bounds: [48, 504, 420, 20]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, middle]
      text: '青松手册 · 规范文档系列'
  - elementId: cv-foot2
    elementType: text
    bounds: [640, 504, 272, 20]
    content:
      fontSize: 11
      color: "$muted"
      align: [right, middle]
      text: '第 1 页 / 共 9 页'
