pageType: chapter
background:
  type: solid
  color: "#FFFFFF"
elements:
  # —— 装订线 ——
  - elementId: ch2-topline
    elementType: shape
    bounds: [0, 0, 960, 4]
    shapeName: rect
    fill: {color: "$primary"}
  # —— 印章式大编号方块 ——
  - elementId: ch2-seal
    elementType: shape
    bounds: [48, 148, 128, 128]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: ch2-num
    elementType: text
    bounds: [48, 148, 128, 128]
    content:
      fontSize: 44
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: '04'
  - elementId: ch2-seallabel
    elementType: text
    bounds: [48, 288, 128, 22]
    content:
      fontSize: 11
      color: "$muted"
      align: [center, middle]
      text: '第 04 章'
  # —— 右侧章节名 ——
  - elementId: ch2-title
    elementType: text
    bounds: [224, 156, 660, 44]
    content:
      fontSize: 30
      bold: true
      color: "$primary"
      align: [left, middle]
      text: '验收与复盘'
  - elementId: ch2-line
    elementType: shape
    bounds: [228, 214, 64, 4]
    shapeName: rect
    fill: {color: "$accent"}
  - elementId: ch2-desc
    elementType: text
    bounds: [224, 234, 660, 24]
    content:
      fontSize: 13
      color: "$muted"
      align: [left, middle]
      text: '验收标准 · 移交归档 · 复盘改进'
  # —— 条款式要点 ——
  - elementId: ch2-item1
    elementType: text
    bounds: [224, 296, 660, 28]
    content:
      fontSize: 14
      color: "$text"
      align: [left, middle]
      text: '4.1  验收标准    交付物与验收清单逐项核对，评审会三分之二以上同意'
  - elementId: ch2-line1
    elementType: shape
    bounds: [224, 330, 640, 1]
    shapeName: rect
    fill: {color: "$line"}
  - elementId: ch2-item2
    elementType: text
    bounds: [224, 336, 660, 28]
    content:
      fontSize: 14
      color: "$text"
      align: [left, middle]
      text: '4.2  移交归档    文档、代码、数据包随验收同步归档至项目管理系统'
  - elementId: ch2-line2
    elementType: shape
    bounds: [224, 370, 640, 1]
    shapeName: rect
    fill: {color: "$line"}
  - elementId: ch2-item3
    elementType: text
    bounds: [224, 376, 660, 28]
    content:
      fontSize: 14
      color: "$text"
      align: [left, middle]
      text: '4.3  复盘改进    结项后两周内完成复盘，改进项纳入下一轮计划'
  # —— 页脚 ——
  - elementId: ch2-foot
    elementType: text
    bounds: [48, 504, 420, 20]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, middle]
      text: '青松手册 · 规范文档系列'
  - elementId: ch2-foot2
    elementType: text
    bounds: [640, 504, 272, 20]
    content:
      fontSize: 11
      color: "$muted"
      align: [right, middle]
      text: '第 7 页 / 共 9 页'
