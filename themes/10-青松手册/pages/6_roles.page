pageType: content
background:
  type: solid
  color: "#FFFFFF"
elements:
  # —— 页眉文档头 + 装订线 ——
  - elementId: rl-topline
    elementType: shape
    bounds: [0, 0, 960, 4]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: rl-head
    elementType: text
    bounds: [48, 22, 400, 24]
    content:
      fontSize: 12
      bold: true
      color: "$primary"
      align: [left, middle]
      text: 'QH-2025-07 · 第 03 章'
  - elementId: rl-page
    elementType: text
    bounds: [872, 22, 48, 24]
    content:
      fontSize: 13
      bold: true
      color: "$primary"
      align: [right, middle]
      text: '06'
  - elementId: rl-title
    elementType: text
    bounds: [48, 56, 600, 30]
    content:
      fontSize: 22
      bold: true
      color: "$text"
      align: [left, middle]
      text: '执行与监控'
  # —— 小节 3.2 职责分工 ——
  - elementId: rl-sbox
    elementType: shape
    bounds: [48, 102, 24, 24]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: rl-snum
    elementType: text
    bounds: [48, 102, 24, 24]
    content:
      fontSize: 12
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: '3.2'
  - elementId: rl-s
    elementType: text
    bounds: [84, 102, 400, 24]
    content:
      fontSize: 15
      bold: true
      color: "$text"
      align: [left, middle]
      text: '职责分工'
  - elementId: rl-sline
    elementType: shape
    bounds: [200, 113, 40, 2]
    shapeName: rect
    fill: {color: "$accent"}
  # —— 岗位卡 ×3（细边框白卡，icon + 岗位名 + 职责条目）——
  # 卡 1 项目经理
  - elementId: rl-c1
    elementType: shape
    bounds: [48, 140, 272, 250]
    shapeName: rect
    fill: {color: "#FFFFFF"}
    border: {width: 1, color: "$line"}
  - elementId: rl-c1icon
    elementType: icon
    bounds: [66, 158, 22, 22]
    icon: person
    fill: {color: "$primary"}
  - elementId: rl-c1name
    elementType: text
    bounds: [98, 154, 200, 30]
    content:
      fontSize: 15
      bold: true
      color: "$primary"
      align: [left, middle]
      text: '项目经理'
  - elementId: rl-c1line
    elementType: shape
    bounds: [66, 192, 236, 1]
    shapeName: rect
    fill: {color: "$line"}
  - elementId: rl-c1t1
    elementType: text
    bounds: [66, 204, 236, 20]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: '· 编制计划并对目标负责'
  - elementId: rl-c1t2
    elementType: text
    bounds: [66, 230, 236, 20]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: '· 组织周例会与变更评审'
  - elementId: rl-c1t3
    elementType: text
    bounds: [66, 256, 236, 20]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: '· 风险升级与资源协调'
  - elementId: rl-c1t4
    elementType: text
    bounds: [66, 282, 236, 20]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: '· 组织验收与复盘'
  # 卡 2 评审委员会
  - elementId: rl-c2
    elementType: shape
    bounds: [344, 140, 272, 250]
    shapeName: rect
    fill: {color: "#FFFFFF"}
    border: {width: 1, color: "$line"}
  - elementId: rl-c2icon
    elementType: icon
    bounds: [362, 158, 22, 22]
    icon: people
    fill: {color: "$primary"}
  - elementId: rl-c2name
    elementType: text
    bounds: [394, 154, 200, 30]
    content:
      fontSize: 15
      bold: true
      color: "$primary"
      align: [left, middle]
      text: '评审委员会'
  - elementId: rl-c2line
    elementType: shape
    bounds: [362, 192, 236, 1]
    shapeName: rect
    fill: {color: "$line"}
  - elementId: rl-c2t1
    elementType: text
    bounds: [362, 204, 236, 20]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: '· 计划与变更评审把关'
  - elementId: rl-c2t2
    elementType: text
    bounds: [362, 230, 236, 20]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: '· 里程碑验收签字'
  - elementId: rl-c2t3
    elementType: text
    bounds: [362, 256, 236, 20]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: '· 冲突裁定与资源仲裁'
  - elementId: rl-c2t4
    elementType: text
    bounds: [362, 282, 236, 20]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: '· 复盘结论审批'
  # 卡 3 支撑团队
  - elementId: rl-c3
    elementType: shape
    bounds: [640, 140, 272, 250]
    shapeName: rect
    fill: {color: "#FFFFFF"}
    border: {width: 1, color: "$line"}
  - elementId: rl-c3icon
    elementType: icon
    bounds: [658, 158, 22, 22]
    icon: gear
    fill: {color: "$primary"}
  - elementId: rl-c3name
    elementType: text
    bounds: [690, 154, 200, 30]
    content:
      fontSize: 15
      bold: true
      color: "$primary"
      align: [left, middle]
      text: '支撑团队'
  - elementId: rl-c3line
    elementType: shape
    bounds: [658, 192, 236, 1]
    shapeName: rect
    fill: {color: "$line"}
  - elementId: rl-c3t1
    elementType: text
    bounds: [658, 204, 236, 20]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: '· 研发 / 测试 / 运维交付'
  - elementId: rl-c3t2
    elementType: text
    bounds: [658, 230, 236, 20]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: '· 数据与文档同步归档'
  - elementId: rl-c3t3
    elementType: text
    bounds: [658, 256, 236, 20]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: '· 风险应对措施落地'
  - elementId: rl-c3t4
    elementType: text
    bounds: [658, 282, 236, 20]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: '· 问题跟踪与反馈'
  # —— 结论条（白底细边框 + 左竖条）——
  - elementId: rl-conclbox
    elementType: shape
    bounds: [48, 418, 864, 46]
    shapeName: rect
    fill: {color: "#FFFFFF"}
    border: {width: 1, color: "$line"}
  - elementId: rl-conclbar
    elementType: shape
    bounds: [48, 418, 3, 46]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: rl-concl
    elementType: text
    bounds: [66, 418, 830, 46]
    content:
      fontSize: 13
      color: "$text"
      align: [left, middle]
      text: '要点：单一负责人、集体评审、团队支撑，职责到人方可避免执行混乱。'
  # —— 页脚 ——
  - elementId: rl-foot
    elementType: text
    bounds: [48, 508, 420, 18]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, middle]
      text: '青松手册 · 项目管理规范手册'
  - elementId: rl-foot2
    elementType: text
    bounds: [640, 508, 272, 18]
    content:
      fontSize: 11
      color: "$muted"
      align: [right, middle]
      text: '内部资料 · 请勿外传'
