pageType: content
background:
  type: solid
  color: "#FFFFFF"
elements:
  # ── 页眉（统一）──
  - elementId: tb-topbar
    elementType: shape
    bounds: [0, 0, 960, 4]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: tb-head
    elementType: text
    bounds: [48, 22, 400, 26]
    content:
      fontSize: 13
      bold: true
      color: "$primary-deep"
      align: [left, middle]
      text: '3 实验 · 3.2 主要结果'
  - elementId: tb-page
    elementType: text
    bounds: [860, 22, 52, 26]
    content:
      fontSize: 12
      color: "$primary"
      align: [right, middle]
      text: '08'
  - elementId: tb-underline
    elementType: shape
    bounds: [48, 52, 864, 1]
    shapeName: rect
    fill: {color: "$line"}
  - elementId: tb-foot
    elementType: text
    bounds: [48, 512, 420, 18]
    content:
      fontSize: 10
      color: "$muted"
      align: [left, middle]
      text: 'Attention-based Time Series Forecasting'
  - elementId: tb-foot2
    elementType: text
    bounds: [640, 512, 272, 18]
    content:
      fontSize: 10
      color: "$muted"
      align: [right, middle]
      text: 'ICML 2026'
  # ── 小节标题 3.2 ──
  - elementId: tb-s1bar
    elementType: shape
    bounds: [48, 76, 4, 18]
    shapeName: rect
    fill: {color: "$accent"}
  - elementId: tb-s1
    elementType: text
    bounds: [60, 74, 400, 22]
    content:
      fontSize: 14
      bold: true
      color: "$primary"
      align: [left, middle]
      text: '3.2  主要结果'
  # ── 表 1：三数据集 RMSE 对比（左侧）──
  - elementId: tb-t1cap
    elementType: text
    bounds: [48, 108, 420, 20]
    content:
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '表 1  三个数据集上的 RMSE 对比'
  - elementId: tb-t1
    elementType: table
    bounds: [48, 134, 420, 160]
    rows:
      - [模型, Electricity, Traffic, ETTh1]
      - [ARIMA, 0.94, 0.98, 0.87]
      - [LSTM, 0.61, 0.66, 0.55]
      - [Transformer, 0.47, 0.52, 0.44]
      - [本文模型, 0.29, 0.33, 0.26]
  - elementId: tb-t1note
    elementType: text
    bounds: [48, 306, 420, 40]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, top]
      lineHeight: 1.6
      text: |-
        注：指标越低越好。本文模型在三个
        数据集上均取得最优，较 Transformer
        平均降低 35%–52%。
  # ── 表 2：消融实验（右侧）──
  - elementId: tb-t2cap
    elementType: text
    bounds: [500, 108, 412, 20]
    content:
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '表 2  消融实验（Electricity，R²）'
  - elementId: tb-t2
    elementType: table
    bounds: [500, 134, 412, 160]
    rows:
      - [组件设置, R²]
      - [完整模型, 0.962]
      - [移除门控融合, 0.917]
      - [移除位置编码, 0.893]
      - [仅单注意力头, 0.931]
  - elementId: tb-t2note
    elementType: text
    bounds: [500, 306, 412, 40]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, top]
      lineHeight: 1.6
      text: |-
        注：指标越高越好。门控融合贡献最大，
        移除后 R² 下降 0.045；位置编码与多头
        结构亦各有显著增益。
  # ── 底部：可复现性说明 ──
  - elementId: tb-repro
    elementType: text
    bounds: [48, 380, 864, 20]
    content:
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '可复现性：实验环境为单卡 A100（40GB），训练时长约 2 小时；代码与数据划分脚本见项目主页。'
