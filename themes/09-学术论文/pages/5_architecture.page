pageType: content
background:
  type: solid
  color: "#FFFFFF"
elements:
  # ── 页眉（统一）──
  - elementId: ar-topbar
    elementType: shape
    bounds: [0, 0, 960, 4]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: ar-head
    elementType: text
    bounds: [48, 22, 400, 26]
    content:
      fontSize: 13
      bold: true
      color: "$primary-deep"
      align: [left, middle]
      text: '2 方法 · 2.1 模型架构'
  - elementId: ar-page
    elementType: text
    bounds: [860, 22, 52, 26]
    content:
      fontSize: 12
      color: "$primary"
      align: [right, middle]
      text: '05'
  - elementId: ar-underline
    elementType: shape
    bounds: [48, 52, 864, 1]
    shapeName: rect
    fill: {color: "$line"}
  - elementId: ar-foot
    elementType: text
    bounds: [48, 512, 420, 18]
    content:
      fontSize: 10
      color: "$muted"
      align: [left, middle]
      text: 'Attention-based Time Series Forecasting'
  - elementId: ar-foot2
    elementType: text
    bounds: [640, 512, 272, 18]
    content:
      fontSize: 10
      color: "$muted"
      align: [right, middle]
      text: 'ICML 2026'
  # ── 小节标题 2.1 ──
  - elementId: ar-s1bar
    elementType: shape
    bounds: [48, 76, 4, 18]
    shapeName: rect
    fill: {color: "$accent"}
  - elementId: ar-s1
    elementType: text
    bounds: [60, 74, 400, 22]
    content:
      fontSize: 14
      bold: true
      color: "$primary"
      align: [left, middle]
      text: '2.1  模型架构'
  # ── 模型架构图（形状：模块 / 数据流 / 残差连接）──
  # 输入层
  - elementId: ar-in
    elementType: shape
    bounds: [48, 196, 150, 56]
    shapeName: roundRect
    adjustments: [10000]
    fill: {color: "#FFFFFF"}
    border: {width: 1, color: "$primary"}
  - elementId: ar-in-t
    elementType: text
    bounds: [48, 196, 150, 56]
    content:
      fontSize: 12
      bold: true
      color: "$primary"
      align: [center, middle]
      text: '输入序列'
  # 箭头 1（输入 → 编码器，中心线 y=224）
  - elementId: ar-a1
    elementType: shape
    bounds: [198, 218, 44, 12]
    shapeName: rightArrow
    adjustments: [55000, 35000]
    fill: {color: "$primary"}
  # 编码器容器（中心与输入/输出对齐，内部横排两模块）
  - elementId: ar-enc
    elementType: shape
    bounds: [242, 168, 240, 112]
    shapeName: roundRect
    adjustments: [8000]
    fill: {color: "#FFFFFF"}
    border: {width: 1, color: "$line"}
  - elementId: ar-enc-label
    elementType: text
    bounds: [256, 172, 212, 18]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, middle]
      text: '编码器 Encoder ×2'
  # 多头注意力层（容器内左模块）
  - elementId: ar-mha
    elementType: shape
    bounds: [256, 198, 106, 44]
    shapeName: roundRect
    adjustments: [10000]
    fill: {color: "$primary-tint"}
  - elementId: ar-mha-t
    elementType: text
    bounds: [256, 198, 106, 44]
    content:
      fontSize: 11
      bold: true
      color: "$primary"
      align: [center, middle]
      text: '多头注意力'
  # 前馈网络层（容器内右模块）
  - elementId: ar-ffn
    elementType: shape
    bounds: [374, 198, 94, 44]
    shapeName: roundRect
    adjustments: [10000]
    fill: {color: "$primary-tint"}
  - elementId: ar-ffn-t
    elementType: text
    bounds: [374, 198, 94, 44]
    content:
      fontSize: 11
      bold: true
      color: "$primary"
      align: [center, middle]
      text: '前馈网络'
  # 箭头 2（编码器 → 门控融合）
  - elementId: ar-a2
    elementType: shape
    bounds: [482, 218, 44, 12]
    shapeName: rightArrow
    adjustments: [55000, 35000]
    fill: {color: "$primary"}
  # 门控融合层（主色实心块，全图唯一强调）
  - elementId: ar-gate
    elementType: shape
    bounds: [526, 196, 150, 56]
    shapeName: roundRect
    adjustments: [10000]
    fill: {color: "$primary"}
  - elementId: ar-gate-t
    elementType: text
    bounds: [526, 196, 150, 56]
    content:
      fontSize: 13
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: '门控融合层'
  # 箭头 3（门控融合 → 输出）
  - elementId: ar-a3
    elementType: shape
    bounds: [676, 218, 44, 12]
    shapeName: rightArrow
    adjustments: [55000, 35000]
    fill: {color: "$primary"}
  # 输出层
  - elementId: ar-out
    elementType: shape
    bounds: [720, 196, 148, 56]
    shapeName: roundRect
    adjustments: [10000]
    fill: {color: "#FFFFFF"}
    border: {width: 1, color: "$primary"}
  - elementId: ar-out-t
    elementType: text
    bounds: [720, 196, 148, 56]
    content:
      fontSize: 12
      bold: true
      color: "$primary"
      align: [center, middle]
      text: '预测值 ŷ'
  # 残差连接（折线旁路：输入框顶部引出 → 上方横穿 → 拐入输出框顶部，末端箭头）
  - elementId: ar-resid1
    elementType: line
    bounds: [123, 140, 1, 56]
    viewBox: [1, 56]
    points: "0,0 0,56"
    border: {style: dash, width: 1, color: "$primary"}
  - elementId: ar-resid2
    elementType: line
    bounds: [123, 140, 671, 1]
    viewBox: [671, 1]
    points: "0,0 671,0"
    border: {style: dash, width: 1, color: "$primary"}
  - elementId: ar-resid3
    elementType: line
    bounds: [794, 140, 1, 56]
    viewBox: [1, 56]
    points: "0,0 0,56"
    border: {style: dash, width: 1, color: "$primary"}
    arrow: [null, "arrow"]
  - elementId: ar-resid-label
    elementType: text
    bounds: [408, 122, 120, 14]
    content:
      fontSize: 10
      color: "$muted"
      align: [center, middle]
      text: '残差连接'
  # ── 图注 ──
  - elementId: ar-caption
    elementType: text
    bounds: [48, 332, 700, 20]
    content:
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '图 1  基于门控融合的注意力预测模型架构'
  # ── 组件说明（行首小方块 + 文字）──
  - elementId: ar-n1
    elementType: shape
    bounds: [52, 368, 8, 8]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: ar-n1t
    elementType: text
    bounds: [70, 362, 830, 22]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: '编码器堆叠 2 层：多头注意力捕获长程依赖，前馈网络完成非线性变换'
  - elementId: ar-n2
    elementType: shape
    bounds: [52, 398, 8, 8]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: ar-n2t
    elementType: text
    bounds: [70, 392, 830, 22]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: '门控融合动态加权多尺度特征，抑制噪声分量'
  - elementId: ar-n3
    elementType: shape
    bounds: [52, 428, 8, 8]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: ar-n3t
    elementType: text
    bounds: [70, 422, 830, 22]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: '输出层为线性回归头，直接预测下一时刻取值'
