pageType: cover
background:
  type: solid
  color: "#FFFFFF"
elements:
  # 顶部粗线（学术刊物风格）
  - elementId: cv-line
    elementType: shape
    bounds: [0, 0, 960, 4]
    shapeName: rect
    fill: {color: "$primary"}
  # 会议/期刊标签
  - elementId: cv-conf
    elementType: text
    bounds: [80, 70, 300, 22]
    content:
      fontSize: 12
      bold: true
      color: "$accent"
      align: [left, middle]
      text: 'ICML 2026 · 论文汇报'
  # 右上论文编号框（细边框，投稿标识）
  - elementId: cv-paperbox
    elementType: shape
    bounds: [756, 66, 124, 28]
    shapeName: rect
    fill: {color: "#FFFFFF"}
    border: {width: 1, color: "$line"}
  - elementId: cv-paper
    elementType: text
    bounds: [756, 66, 124, 28]
    content:
      fontSize: 11
      color: "$muted"
      align: [center, middle]
      text: 'Paper #1234'
  # 标题
  - elementId: cv-title
    elementType: text
    bounds: [80, 128, 800, 130]
    content:
      fontSize: 38
      bold: true
      color: "$primary-deep"
      align: [left, top]
      lineHeight: 1.35
      text: |-
        基于注意力机制的时间序列
        预测研究
  # 英文副标题
  - elementId: cv-en
    elementType: text
    bounds: [80, 282, 700, 24]
    content:
      fontSize: 14
      color: "$muted"
      align: [left, middle]
      text: 'Attention-based Time Series Forecasting'
  # 分隔线
  - elementId: cv-divider
    elementType: shape
    bounds: [80, 330, 480, 1]
    shapeName: rect
    fill: {color: "$line"}
  # 作者与单位
  - elementId: cv-author
    elementType: text
    bounds: [80, 358, 600, 26]
    content:
      fontSize: 14
      color: "$text"
      align: [left, middle]
      text: '张三，李四，王五'
  - elementId: cv-affil
    elementType: text
    bounds: [80, 390, 600, 22]
    content:
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: 'XX 大学 计算机科学与技术学院'
  # 底部日期
  - elementId: cv-date
    elementType: text
    bounds: [80, 470, 400, 20]
    content:
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '2025 年 8 月'
