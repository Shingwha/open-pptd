pageType: chapter
background:
  type: solid
  color: "#FFFFFF"
elements:
  # 左侧深蓝竖条（章节页视觉锚点）
  - elementId: ch-bar
    elementType: shape
    bounds: [0, 0, 220, 540]
    shapeName: rect
    fill: {color: "$primary-deep"}
  - elementId: ch-num
    elementType: text
    bounds: [30, 150, 160, 120]
    content:
      fontSize: 96
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: '2'
  - elementId: ch-numlabel
    elementType: text
    bounds: [30, 270, 160, 24]
    content:
      fontSize: 12
      color: "#FFFFFFB3"
      align: [center, middle]
      text: 'CHAPTER'
  # 右侧章节名
  - elementId: ch-title
    elementType: text
    bounds: [280, 170, 560, 80]
    content:
      fontSize: 34
      bold: true
      color: "$primary-deep"
      align: [left, top]
      lineHeight: 1.3
      text: |-
        方法
        门控融合的注意力预测框架
  - elementId: ch-desc
    elementType: text
    bounds: [280, 272, 560, 24]
    content:
      fontSize: 13
      color: "$muted"
      align: [left, middle]
      text: '本章介绍模型总体架构与核心注意力机制'
  # 小节列表（2.1 / 2.2 / 2.3）
  - elementId: ch-sep1
    elementType: shape
    bounds: [280, 322, 600, 1]
    shapeName: rect
    fill: {color: "$line"}
  - elementId: ch-s1
    elementType: text
    bounds: [280, 336, 600, 26]
    content:
      fontSize: 14
      color: "$text"
      align: [left, middle]
      text: '2.1  模型架构 —— 编码器-解码器与门控融合'
  - elementId: ch-sep2
    elementType: shape
    bounds: [280, 372, 600, 1]
    shapeName: rect
    fill: {color: "$line"}
  - elementId: ch-s2
    elementType: text
    bounds: [280, 386, 600, 26]
    content:
      fontSize: 14
      color: "$text"
      align: [left, middle]
      text: '2.2  注意力机制 —— 多头注意力与缩放点积'
  - elementId: ch-sep3
    elementType: shape
    bounds: [280, 422, 600, 1]
    shapeName: rect
    fill: {color: "$line"}
  - elementId: ch-s3
    elementType: text
    bounds: [280, 436, 600, 26]
    content:
      fontSize: 14
      color: "$text"
      align: [left, middle]
      text: '2.3  训练目标 —— 均方误差与优化器'
  # 页脚
  - elementId: ch-foot
    elementType: text
    bounds: [48, 512, 420, 18]
    content:
      fontSize: 10
      color: "$muted"
      align: [left, middle]
      text: 'Attention-based Time Series Forecasting'
