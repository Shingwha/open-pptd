pageType: content
background:
  type: solid
  color: "#FFFFFF"
elements:
  # ── 页眉（统一）──
  - elementId: in-topbar
    elementType: shape
    bounds: [0, 0, 960, 4]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: in-head
    elementType: text
    bounds: [48, 22, 400, 26]
    content:
      fontSize: 13
      bold: true
      color: "$primary-deep"
      align: [left, middle]
      text: '1 引言'
  - elementId: in-page
    elementType: text
    bounds: [860, 22, 52, 26]
    content:
      fontSize: 12
      color: "$primary"
      align: [right, middle]
      text: '03'
  - elementId: in-underline
    elementType: shape
    bounds: [48, 52, 864, 1]
    shapeName: rect
    fill: {color: "$line"}
  - elementId: in-foot
    elementType: text
    bounds: [48, 512, 420, 18]
    content:
      fontSize: 10
      color: "$muted"
      align: [left, middle]
      text: 'Attention-based Time Series Forecasting'
  - elementId: in-foot2
    elementType: text
    bounds: [640, 512, 272, 18]
    content:
      fontSize: 10
      color: "$muted"
      align: [right, middle]
      text: 'ICML 2026'
  # ── 1.1 研究贡献（icon + 标题 + 描述，行内细线分隔）──
  - elementId: in-s1bar
    elementType: shape
    bounds: [48, 76, 4, 18]
    shapeName: rect
    fill: {color: "$accent"}
  - elementId: in-s1
    elementType: text
    bounds: [60, 74, 400, 22]
    content:
      fontSize: 14
      bold: true
      color: "$primary"
      align: [left, middle]
      text: '1.1  研究贡献'
  # 贡献 1
  - elementId: in-c1
    elementType: icon
    bounds: [52, 116, 22, 22]
    icon: lightbulb
    fill: {color: "$primary"}
  - elementId: in-c1t
    elementType: text
    bounds: [86, 112, 400, 24]
    content:
      fontSize: 14
      bold: true
      color: "$text"
      align: [left, middle]
      text: '轻量注意力框架'
  - elementId: in-c1d
    elementType: text
    bounds: [86, 136, 820, 22]
    content:
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '提出多头注意力与门控融合结合的预测框架，参数量较 Transformer 减少 62%，训练时间缩短 41%。'
  # 贡献 2
  - elementId: in-c2
    elementType: icon
    bounds: [52, 180, 22, 22]
    icon: sliders
    fill: {color: "$primary"}
  - elementId: in-c2t
    elementType: text
    bounds: [86, 176, 400, 24]
    content:
      fontSize: 14
      bold: true
      color: "$text"
      align: [left, middle]
      text: '自适应位置编码'
  - elementId: in-c2d
    elementType: text
    bounds: [86, 200, 820, 22]
    content:
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '面向电力、交通等多尺度周期数据设计自适应位置编码，长序列（336h）预测误差进一步下降 12%。'
  # 贡献 3
  - elementId: in-c3
    elementType: icon
    bounds: [52, 244, 22, 22]
    icon: box-seam
    fill: {color: "$primary"}
  - elementId: in-c3t
    elementType: text
    bounds: [86, 240, 400, 24]
    content:
      fontSize: 14
      bold: true
      color: "$text"
      align: [left, middle]
      text: '开源实现与基准'
  - elementId: in-c3d
    elementType: text
    bounds: [86, 264, 820, 22]
    content:
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '开源完整实现与三个公开数据集的评测脚本，单卡 A100 两小时可复现全部结果。'
  # ── 1.2 研究流程（4 步：icon + 名称 + 描述）──
  - elementId: in-s2bar
    elementType: shape
    bounds: [48, 316, 4, 18]
    shapeName: rect
    fill: {color: "$accent"}
  - elementId: in-s2
    elementType: text
    bounds: [60, 314, 400, 22]
    content:
      fontSize: 14
      bold: true
      color: "$primary"
      align: [left, middle]
      text: '1.2  研究流程'
  # 步骤 1
  - elementId: in-p1
    elementType: icon
    bounds: [52, 356, 26, 26]
    icon: search
    fill: {color: "$primary"}
  - elementId: in-p1n
    elementType: text
    bounds: [48, 390, 200, 20]
    content:
      fontSize: 13
      bold: true
      color: "$text"
      align: [center, middle]
      text: '问题定义'
  - elementId: in-p1d
    elementType: text
    bounds: [48, 412, 200, 20]
    content:
      fontSize: 11
      color: "$muted"
      align: [center, middle]
      text: '长序列预测与效率瓶颈'
  # 步骤 2
  - elementId: in-p2
    elementType: icon
    bounds: [276, 356, 26, 26]
    icon: clipboard-data
    fill: {color: "$primary"}
  - elementId: in-p2n
    elementType: text
    bounds: [272, 390, 200, 20]
    content:
      fontSize: 13
      bold: true
      color: "$text"
      align: [center, middle]
      text: '数据构建'
  - elementId: in-p2d
    elementType: text
    bounds: [272, 412, 200, 20]
    content:
      fontSize: 11
      color: "$muted"
      align: [center, middle]
      text: '归一化、滑窗与划分'
  # 步骤 3
  - elementId: in-p3
    elementType: icon
    bounds: [504, 356, 26, 26]
    icon: cpu
    fill: {color: "$primary"}
  - elementId: in-p3n
    elementType: text
    bounds: [500, 390, 200, 20]
    content:
      fontSize: 13
      bold: true
      color: "$text"
      align: [center, middle]
      text: '模型训练'
  - elementId: in-p3d
    elementType: text
    bounds: [500, 412, 200, 20]
    content:
      fontSize: 11
      color: "$muted"
      align: [center, middle]
      text: 'MSE 损失 + AdamW 优化'
  # 步骤 4
  - elementId: in-p4
    elementType: icon
    bounds: [732, 356, 26, 26]
    icon: graph-up
    fill: {color: "$primary"}
  - elementId: in-p4n
    elementType: text
    bounds: [728, 390, 200, 20]
    content:
      fontSize: 13
      bold: true
      color: "$text"
      align: [center, middle]
      text: '评估验证'
  - elementId: in-p4d
    elementType: text
    bounds: [728, 412, 200, 20]
    content:
      fontSize: 11
      color: "$muted"
      align: [center, middle]
      text: '多数据集对比与消融'
  # ── 底部：关键结果（纯数字排版）──
  - elementId: in-k1v
    elementType: text
    bounds: [48, 460, 180, 30]
    content:
      fontSize: 24
      bold: true
      color: "$primary"
      align: [left, middle]
      text: '-52%'
  - elementId: in-k1l
    elementType: text
    bounds: [48, 490, 220, 18]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, middle]
      text: 'RMSE 较 Transformer 降低'
  - elementId: in-k2v
    elementType: text
    bounds: [340, 460, 200, 30]
    content:
      fontSize: 24
      bold: true
      color: "$primary"
      align: [left, middle]
      text: '-62%'
  - elementId: in-k2l
    elementType: text
    bounds: [340, 490, 220, 18]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, middle]
      text: '参数量缩减'
  - elementId: in-k3v
    elementType: text
    bounds: [632, 460, 220, 30]
    content:
      fontSize: 24
      bold: true
      color: "$primary"
      align: [left, middle]
      text: '0.96'
  - elementId: in-k3l
    elementType: text
    bounds: [632, 490, 220, 18]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, middle]
      text: 'R² 拟合优度'
