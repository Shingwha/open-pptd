pageType: toc
background:
  type: solid
  color: "#FFFFFF"
elements:
  - elementId: tc-bar
    elementType: shape
    bounds: [0, 0, 960, 6]
    shapeName: rect
    fill: {color: "$primary"}
  - elementId: tc-title
    elementType: text
    bounds: [64, 60, 400, 44]
    content:
      style: "$title"
      fontSize: 30
      color: "$primary"
      align: [left, middle]
      text: 报告提纲
  - elementId: tc-line
    elementType: shape
    bounds: [64, 118, 60, 3]
    shapeName: rect
    fill: {color: "$accent"}
  - elementId: tc-c1
    elementType: shape
    bounds: [64, 150, 400, 76]
    shapeName: rect
    fill: {color: "$primary-soft"}
  - elementId: tc-n1
    elementType: text
    bounds: [84, 164, 56, 48]
    content:
      fontSize: 22
      bold: true
      color: "$primary"
      align: [center, middle]
      text: '01'
  - elementId: tc-name1
    elementType: text
    bounds: [152, 162, 300, 26]
    content:
      style: "$body"
      fontSize: 16
      bold: true
      color: "$primary"
      align: [left, middle]
      text: 年度工作回顾
  - elementId: tc-desc1
    elementType: text
    bounds: [152, 190, 300, 22]
    content:
      style: "$body"
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: 经济指标 · 重点项目 · 民生实事
  - elementId: tc-c2
    elementType: shape
    bounds: [496, 150, 400, 76]
    shapeName: rect
    fill: {color: "$primary-soft"}
  - elementId: tc-n2
    elementType: text
    bounds: [516, 164, 56, 48]
    content:
      fontSize: 22
      bold: true
      color: "$primary"
      align: [center, middle]
      text: '02'
  - elementId: tc-name2
    elementType: text
    bounds: [584, 162, 300, 26]
    content:
      style: "$body"
      fontSize: 16
      bold: true
      color: "$primary"
      align: [left, middle]
      text: 改革创新成效
  - elementId: tc-desc2
    elementType: text
    bounds: [584, 190, 300, 22]
    content:
      style: "$body"
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '数字政务 · 营商环境 · 人才引育'
  - elementId: tc-c3
    elementType: shape
