    shapeName: rect
    fill: {color: "$primary-soft"}
  - elementId: tc-n3
    elementType: text
    bounds: [84, 254, 56, 48]
    content:
      fontSize: 22
      bold: true
      color: "$primary"
      align: [center, middle]
      text: '03'
  - elementId: tc-name3
    elementType: text
    bounds: [152, 252, 300, 26]
    content:
      style: "$body"
      fontSize: 16
      bold: true
      color: "$primary"
      align: [left, middle]
      text: 党风廉政建设
  - elementId: tc-desc3
    elementType: text
    bounds: [152, 280, 300, 22]
    content:
      style: "$body"
      fontSize: 12
      color: "$muted"
      align: [left, middle]
      text: '纪律教育 · 作风建设 · 监督机制'
  - elementId: tc-c4
    elementType: shape
    bounds: [496, 240, 400, 76]
