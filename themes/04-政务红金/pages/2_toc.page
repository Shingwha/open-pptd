    fill: {color: "$primary-soft"}
  - elementId: tc-n4
    elementType: text
    bounds: [516, 254, 56, 48]
    content:
      fontSize: 22
      bold: true
      color: "$primary"
      align: [center, middle]
      text: '04'
  - elementId: tc-name4
    elementType: text
