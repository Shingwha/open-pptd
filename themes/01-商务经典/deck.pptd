version: v2
title: 2026 战略规划与增长路线图
gallery:
  name: 麦肯锡咨询
  style: mckinsey 麦肯锡咨询
  color: navy 墨蓝
  font: 思源宋体标题 + 思源黑体正文
  scene: 战略汇报 / 经营分析 / 投融资路演
theme: mckinsey
fonts:
  latin: EB Garamond
  ea: Noto Sans SC
  title: {latin: EB Garamond, ea: Noto Serif SC}
  subtitle: {latin: EB Garamond, ea: Noto Sans SC}
  body: {latin: EB Garamond, ea: Noto Sans SC}
  quote: {latin: EB Garamond, ea: Noto Serif SC}
  caption: {latin: EB Garamond, ea: Noto Sans SC}
  table: {latin: EB Garamond, ea: Noto Sans SC}
  chart: {latin: EB Garamond, ea: Noto Sans SC}
  # —— 资源表：网络字体（OFL 可再分发），导出自动子集化嵌入 ——
  Noto Serif SC:
    family: Noto Serif SC
    url: "https://raw.githubusercontent.com/google/fonts/main/ofl/notoserifsc/NotoSerifSC%5Bwght%5D.ttf"
    subset: true
  Noto Sans SC:
    family: Noto Sans SC
    url: "https://cdn.jsdelivr.net/gh/google/fonts@main/ofl/notosanssc/NotoSansSC%5Bwght%5D.ttf"
    subset: true
  EB Garamond:
    family: EB Garamond
    url: "https://cdn.jsdelivr.net/gh/google/fonts@main/ofl/ebgaramond/EBGaramond%5Bwght%5D.ttf"
    subset: true
size: [960, 540]
pages:
  - pages/1_cover.page
  - pages/2_agenda.page
  - pages/3_chapter.page
  - pages/4_typography.page
  - pages/5_charts.page
  - pages/6_visuals.page
