pageType: final
background:
  type: solid
  color: "$primary-deep"
elements:
  # —— 顶部亮蓝细条 ——
  - elementId: fn-topbar
    elementType: shape
    bounds: [0, 0, 960, 4]
    shapeName: rect
    fill: {color: "$accent"}
  # —— 中央标题 ——
  - elementId: fn-tag
    elementType: text
    bounds: [380, 118, 200, 20]
    content:
      fontSize: 12
      bold: true
      color: "$accent"
      align: [center, middle]
      text: THANK YOU
  - elementId: fn-title
    elementType: text
    bounds: [240, 152, 480, 56]
    content:
      fontSize: 40
      bold: true
      color: "#FFFFFF"
      align: [center, top]
      fontFamily: "Noto Serif SC"
      text: 感谢聆听
  - elementId: fn-line
    elementType: shape
    bounds: [440, 226, 80, 4]
    shapeName: rect
    fill: {color: "$accent"}
  - elementId: fn-sub
    elementType: text
    bounds: [280, 252, 400, 24]
    content:
      fontSize: 14
      color: "#FFFFFFB3"
      align: [center, middle]
      text: 期待与您继续深入探讨
  # —— 联系方式（图标行 + 文字行） ——
  - elementId: fn-ei
    elementType: icon
    bounds: [310, 338, 20, 20]
    icon: envelope
    fill: {color: "$accent"}
  - elementId: fn-pi
    elementType: icon
    bounds: [470, 338, 20, 20]
    icon: phone
    fill: {color: "$accent"}
  - elementId: fn-gi
    elementType: icon
    bounds: [630, 338, 20, 20]
    icon: globe
    fill: {color: "$accent"}
  - elementId: fn-et
    elementType: text
    bounds: [230, 366, 180, 20]
    content:
      fontSize: 11
      color: "#FFFFFFCC"
      align: [center, middle]
      text: strategy@example.com
  - elementId: fn-pt
    elementType: text
    bounds: [390, 366, 180, 20]
    content:
      fontSize: 11
      color: "#FFFFFFCC"
      align: [center, middle]
      text: +86 138 0000 0000
  - elementId: fn-gt
    elementType: text
    bounds: [550, 366, 180, 20]
    content:
      fontSize: 11
      color: "#FFFFFFCC"
      align: [center, middle]
      text: www.example.com
  # —— 右下同心圆环装饰 ——
  - elementId: fn-ring1
    elementType: shape
    bounds: [736, 376, 136, 136]
    shapeName: ellipse
    border: {style: solid, width: 1, color: "#FFFFFF22"}
  - elementId: fn-ring2
    elementType: shape
    bounds: [788, 428, 56, 56]
    shapeName: ellipse
    border: {style: solid, width: 1, color: "#FFFFFF14"}
  - elementId: fn-dot
    elementType: shape
    bounds: [700, 338, 24, 24]
    shapeName: ellipse
    fill: {color: "#00A0DC40"}
  # —— 底部保密 ——
  - elementId: fn-foot
    elementType: text
    bounds: [120, 500, 720, 18]
    content:
      fontSize: 10
      color: "#FFFFFF80"
      align: [center, middle]
      text: STRICTLY PRIVATE AND CONFIDENTIAL —— 未经许可不得外传
