pageType: content
background:
  type: solid
  color: "#FFFFFF"
elements:
  # —— 页眉 ——
  - elementId: c5-page
    elementType: text
    bounds: [888, 28, 40, 24]
    content:
      fontSize: 13
      bold: true
      color: "$primary"
      align: [right, middle]
      text: '05'
  - elementId: c5-tag
    elementType: text
    bounds: [48, 36, 240, 18]
    content:
      fontSize: 11
      bold: true
      color: "$accent"
      align: [left, middle]
      text: 02 · CHARTS
  - elementId: c5-title
    elementType: text
    bounds: [48, 60, 560, 32]
    content:
      fontSize: 22
      bold: true
      color: "$text"
      align: [left, top]
      fontFamily: "Noto Serif SC"
      text: 数据图表 · 麦肯锡式
  # —— KPI 卡片 ——
  - elementId: c5-k1-bg
    elementType: shape
    bounds: [48, 104, 210, 58]
    shapeName: roundRect
    adjustments: [10000]
    fill: {color: "$primary-soft"}
  - elementId: c5-k1-n
    elementType: text
    bounds: [60, 108, 150, 24]
    content:
      fontSize: 20
      bold: true
      color: "$primary"
      align: [left, top]
      text: 12.8 亿
  - elementId: c5-k1-l
    elementType: text
    bounds: [60, 136, 180, 18]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, middle]
      text: 全年营收 · +22%
  - elementId: c5-k2-bg
    elementType: shape
    bounds: [270, 104, 210, 58]
    shapeName: roundRect
    adjustments: [10000]
    fill: {color: "$primary-soft"}
  - elementId: c5-k2-n
    elementType: text
    bounds: [282, 108, 150, 24]
    content:
      fontSize: 20
      bold: true
      color: "$primary"
      align: [left, top]
      text: 3.2 亿
  - elementId: c5-k2-l
    elementType: text
    bounds: [282, 136, 180, 18]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, middle]
      text: 累计用户 · +38%
  - elementId: c5-k3-bg
    elementType: shape
    bounds: [492, 104, 210, 58]
    shapeName: roundRect
    adjustments: [10000]
    fill: {color: "$primary-soft"}
  - elementId: c5-k3-n
    elementType: text
    bounds: [504, 108, 150, 24]
    content:
      fontSize: 20
      bold: true
      color: "$primary"
      align: [left, top]
      text: 64%
  - elementId: c5-k3-l
    elementType: text
    bounds: [504, 136, 180, 18]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, middle]
      text: 月活 / 累计用户
  - elementId: c5-k4-bg
    elementType: shape
    bounds: [714, 104, 198, 58]
    shapeName: roundRect
    adjustments: [10000]
    fill: {color: "$primary-soft"}
  - elementId: c5-k4-n
    elementType: text
    bounds: [726, 108, 150, 24]
    content:
      fontSize: 20
      bold: true
      color: "$primary"
      align: [left, top]
      text: 91%
  - elementId: c5-k4-l
    elementType: text
    bounds: [726, 136, 180, 18]
    content:
      fontSize: 11
      color: "$muted"
      align: [left, middle]
      text: 年度目标达成率
  # —— 左：柱状图 ——
  - elementId: c5-c1t
    elementType: text
    bounds: [48, 182, 340, 22]
    content:
      fontSize: 14
      bold: true
      color: "$text"
      align: [left, middle]
      text: 月度营收与净利润（万元）
  - elementId: c5-c1s
    elementType: text
    bounds: [300, 182, 172, 22]
    content:
      fontSize: 11
      color: "$muted"
      align: [right, middle]
      text: 柱状图 · 双系列
  - elementId: c5-c1
    elementType: chart
    bounds: [48, 206, 424, 170]
    data:
      cols: [月份, 营收, 净利润]
      rows:
        - [1月, 860, 180]
        - [2月, 920, 210]
        - [3月, 1010, 240]
        - [4月, 1090, 270]
        - [5月, 1180, 300]
        - [6月, 1280, 340]
    series:
      - type: bar
        encode: {category: 月份, y: 营收}
        name: 营收
      - type: bar
        encode: {category: 月份, y: 净利润}
        name: 净利润
  # —— 右上：面积 + 折线 ——
  - elementId: c5-c2t
    elementType: text
    bounds: [500, 182, 340, 22]
    content:
      fontSize: 14
      bold: true
      color: "$text"
      align: [left, middle]
      text: 用户增长趋势（万人）
  - elementId: c5-c2s
    elementType: text
    bounds: [752, 182, 160, 22]
    content:
      fontSize: 11
      color: "$muted"
      align: [right, middle]
      text: 面积 + 折线
  - elementId: c5-c2
    elementType: chart
    bounds: [500, 206, 412, 100]
    data:
      cols: [月份, 用户数, 目标]
      rows:
        - [1月, 1650, 1600]
        - [2月, 1720, 1650]
        - [3月, 1810, 1720]
        - [4月, 1920, 1780]
        - [5月, 2050, 1850]
        - [6月, 2210, 1920]
    series:
      - type: area
        encode: {category: 月份, y: 用户数}
        name: 用户数
      - type: line
        encode: {category: 月份, y: 目标}
        name: 目标
  # —— 右下：环形图 ——
  - elementId: c5-c3t
    elementType: text
    bounds: [500, 324, 340, 22]
    content:
      fontSize: 14
      bold: true
      color: "$text"
      align: [left, middle]
      text: 市场份额构成（%）
  - elementId: c5-c3s
    elementType: text
    bounds: [752, 324, 160, 22]
    content:
      fontSize: 11
      color: "$muted"
      align: [right, middle]
      text: 环形图
  - elementId: c5-c3
    elementType: chart
    bounds: [500, 348, 412, 112]
    data:
      cols: [业务, 占比]
      rows:
        - [企业服务, 38]
        - [专业咨询, 27]
        - [基础服务, 21]
        - [生态合作, 14]
    series:
      - type: doughnut
        encode: {category: 业务, value: 占比}
  # —— 结论条 ——
  - elementId: c5-con-bg
    elementType: shape
    bounds: [48, 478, 864, 26]
    shapeName: rect
    fill: {color: "$primary-soft"}
  - elementId: c5-con-bar
    elementType: shape
    bounds: [48, 478, 4, 26]
    shapeName: rect
    fill: {color: "$accent"}
  - elementId: c5-con-t
    elementType: text
    bounds: [64, 478, 840, 26]
    content:
      fontSize: 12
      color: "$text"
      align: [left, middle]
      text: 结论：企业服务收入占比过半且增速最快，是下一阶段增长的主引擎。
  # —— 骨架：页脚 ——
  - elementId: c5-foot-line
    elementType: line
    bounds: [48, 508, 864, 1]
    viewBox: [864, 1]
    points: "0,0 864,0"
    border: {style: solid, width: 1, color: "$line"}
  - elementId: c5-foot
    elementType: text
    bounds: [48, 516, 420, 14]
    content:
      fontSize: 10
      color: "$muted"
      align: [left, middle]
      text: 麦肯锡咨询 · 风格指南
  - elementId: c5-foot2
    elementType: text
    bounds: [768, 516, 144, 14]
    content:
      fontSize: 10
      color: "$muted"
      align: [right, middle]
      text: CONFIDENTIAL
