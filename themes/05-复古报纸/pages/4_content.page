pageType: content
background:
  type: solid
  color: "#F5EFE0"
elements:
  # —— 刊头（报名 + 期号 + 日期 + 双线）——
  - elementId: ov-mast-name
    elementType: text
    bounds: [330, 24, 300, 32]
    content:
      style: "$title"
      fontSize: 24
      color: "#3D3226"
      align: [center, middle]
      letterSpacing: 4
      text: '老 城 记 忆'
  - elementId: ov-mast-no
    elementType: text
    bounds: [48, 24, 160, 24]
    content:
      fontSize: 12
      color: "#6E6355"
      align: [left, middle]
      text: '第三期 · 文化特辑'
  - elementId: ov-mast-date
    elementType: text
    bounds: [752, 24, 160, 24]
    content:
      fontSize: 12
      color: "#6E6355"
      align: [right, middle]
      text: '2025 年 9 月'
  - elementId: ov-mast-line1
    elementType: shape
    bounds: [48, 62, 864, 2]
    shapeName: rect
    fill: {color: "#3D3226"}
  - elementId: ov-mast-line2
    elementType: shape
    bounds: [48, 68, 864, 1]
    shapeName: rect
    fill: {color: "#8A7B66"}
  # —— 头条（跨栏）——
  - elementId: ov-headline
    elementType: text
    bounds: [48, 92, 864, 40]
    content:
      style: "$title"
      fontSize: 26
      color: "#3D3226"
      align: [center, middle]
      text: '老字号，一座城的味觉年鉴'
  - elementId: ov-headline-line
    elementType: shape
    bounds: [48, 142, 864, 1]
    shapeName: rect
    fill: {color: "#8A7B66"}
  # —— 左栏：正文 ——
  - elementId: ov-l-title
    elementType: text
    bounds: [48, 162, 480, 26]
    content:
      style: "$body"
      fontSize: 16
      bold: true
      color: "#6E1423"
      align: [left, middle]
      text: '同春酱园 · 一百二十八年'
  - elementId: ov-l-body
    elementType: text
    bounds: [48, 198, 480, 170]
    content:
      style: "$body"
      fontSize: 13
      color: "#3D3226"
      align: [left, top]
      lineHeight: 1.75
      text: |
        清光绪二十三年（1897 年），同春酱园在打铜街支起第一口酱缸。四代人守着同一方晒场，春分下酱、三伏翻晒、立冬封坛——一年只出一批酱油。
        
        如今街巷改造，老铺新开。酱园第三代传人把祖传的酱缸编号归档，与档案馆共建「老字号口述史」，让 128 年的味道有了档案。
  - elementId: ov-l-line
    elementType: shape
    bounds: [48, 388, 480, 1]
    shapeName: rect
    fill: {color: "#B8A98E"}
  - elementId: ov-l-note
    elementType: text
    bounds: [48, 402, 480, 60]
    content:
      style: "$body"
      fontSize: 12
      color: "#6E6355"
      align: [left, top]
      lineHeight: 1.7
      text: |
        「酱缸档案」计划将收录全市 46 家老字号的
        口述史、老物件与配方档案，陆续开放查阅。
  # —— 右栏：名录档案卡 ——
  - elementId: ov-r-card
    elementType: shape
    bounds: [572, 162, 340, 282]
    shapeName: rect
    fill: {color: "#FFFFFF66"}
    border: {width: 1, color: "#B8A98E"}
  - elementId: ov-r-title
    elementType: text
    bounds: [596, 180, 292, 26]
    content:
      style: "$body"
      fontSize: 15
      bold: true
      color: "#3D3226"
      align: [left, middle]
      text: '老字号名录（节选）'
  - elementId: ov-r1
    elementType: text
    bounds: [596, 224, 200, 24]
