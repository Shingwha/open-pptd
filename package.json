{
  "name": "open-pptd",
  "version": "3.0.0",
  "type": "module",
  "description": "PPTD 网页编辑器 + 自研零依赖 PPTX writer（skill 运行时不需 npm install）",
  "bin": {
    "open-pptd": "bin/open-pptd.js"
  },
  "exports": {
    ".": "./packages/index.js",
    "./model": "./packages/model/index.js",
    "./renderer": "./packages/renderer/index.js",
    "./writer": "./packages/writer/index.js",
    "./runtime": "./packages/runtime/index.js",
    "./export": "./packages/export/index.js",
    "./server": "./packages/server/index.js",
    "./cli": "./packages/cli/index.js",
    "./editor": "./editor/index.js",
    "./paths": "./packages/paths.js",
    "./config": "./packages/config.js",
    "./measure": "./packages/measure/index.js",
    "./layout": "./packages/layout/index.js",
    "./editor/index.html": "./editor/index.html",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "packages",
    "editor",
    "contract.json",
    "index.html",
    "README.md",
    "assets/icons/registry.json",
    "assets/fonts/registry.json"
  ],
  "scripts": {
    "test": "node tests/run-all.mjs",
    "test:deps": "node tests/regression/dep-graph.mjs",
    "test:formula": "node tests/regression/formula.mjs",
    "test:icon": "node tests/regression/icon.mjs",
    "test:shapes": "node tests/regression/preset-shapes.mjs",
    "test:isolate": "node tests/tools/isolate.mjs",
    "test:incremental": "node tests/e2e/incremental-load.mjs",
    "test:editor": "node tests/e2e/editor-minimal.mjs && node tests/e2e/page-ops.mjs && node tests/e2e/editor-ops.mjs && node tests/e2e/feedback-fixes.mjs && node tests/e2e/add-elements.mjs",
    "test:render": "node tests/e2e/render.mjs",
    "test:fixtures": "node tests/tools/dump-formula-mml.mjs",
    "test:perf": "node tests/perf/editor-perf.mjs",
    "test:skill": "node tests/skill/run.mjs",
    "test:docs": "node tests/docs/run.mjs",
    "pack": "node scripts/pack-release.mjs"
  },
  "license": "MIT"
}
