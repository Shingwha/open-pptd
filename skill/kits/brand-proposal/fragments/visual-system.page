pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: system-title
    elementType: text
    bounds: [64, 40, 832, 60]
    content:
      fontSize: 30
      fontFamily: "Smiley Sans"
      color: "$text"
      bold: true
      lineHeight: 1.15
      align: [left, top]
      text: One blue field, one cropped numeral, no decoration
  - elementId: palette-label
    elementType: text
    bounds: [64, 124, 300, 18]
    content:
      fontSize: 9
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      letterSpacing: 1.6
      align: [left, middle]
      text: PALETTE
  - elementId: swatch-primary
    elementType: shape
    bounds: [64, 146, 100, 64]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: swatch-accent
    elementType: shape
    bounds: [176, 146, 100, 64]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: swatch-text
    elementType: shape
    bounds: [288, 146, 100, 64]
    shapeName: rect
    fill: {type: solid, color: "$text"}
  - elementId: swatch-bg
    elementType: shape
    bounds: [400, 146, 100, 64]
    shapeName: rect
    fill: {type: solid, color: "$bg"}
    border: {style: solid, width: 1, color: "$line"}
  - elementId: swatch-label-primary
    elementType: text
    bounds: [64, 214, 100, 18]
    content:
      fontSize: 9
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      align: [left, middle]
      text: primary
  - elementId: swatch-label-accent
    elementType: text
    bounds: [176, 214, 100, 18]
    content:
      fontSize: 9
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      align: [left, middle]
      text: accent
  - elementId: swatch-label-text
    elementType: text
    bounds: [288, 214, 100, 18]
    content:
      fontSize: 9
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      align: [left, middle]
      text: text
  - elementId: swatch-label-bg
    elementType: text
    bounds: [400, 214, 100, 18]
    content:
      fontSize: 9
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      align: [left, middle]
      text: ground
  - elementId: type-label
    elementType: text
    bounds: [560, 124, 200, 18]
    content:
      fontSize: 9
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      letterSpacing: 1.6
      align: [left, middle]
      text: TYPE
  - elementId: type-specimen
    elementType: text
    bounds: [560, 142, 140, 82]
    content:
      fontSize: 64
      fontFamily: "Smiley Sans"
      color: "$text"
      align: [left, top]
      text: Aa
  - elementId: type-note
    elementType: text
    bounds: [712, 146, 184, 80]
    content:
      fontSize: 10
      fontFamily: "Microsoft YaHei"
      color: "$text"
      lineHeight: 1.45
      align: [left, top]
      text: |
        <p>Display · Smiley Sans 64/72</p>
        <p>Body · MiSans 16/24</p>
        <p>Labels · 9, tracking 1.6</p>
  - elementId: motif-label
    elementType: text
    bounds: [64, 266, 200, 18]
    content:
      fontSize: 9
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      letterSpacing: 1.6
      align: [left, middle]
      text: MOTIF
  - elementId: motif-numeral
    elementType: text
    bounds: [64, 284, 190, 100]
    content:
      fontSize: 84
      fontFamily: "Smiley Sans"
      color: "$primary"
      lineHeight: 1
      align: [left, top]
      text: "01"
  - elementId: motif-note
    elementType: text
    bounds: [64, 388, 200, 42]
    content:
      fontSize: 10
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      lineHeight: 1.4
      align: [left, top]
      text: "Fixed at the top-left; the numeral changes by launch, the crop does not."
  - elementId: rules-label
    elementType: text
    bounds: [300, 266, 200, 18]
    content:
      fontSize: 9
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      letterSpacing: 1.6
      align: [left, middle]
      text: RULES
  - elementId: rules-list
    elementType: text
    bounds: [300, 286, 596, 138]
    content:
      fontSize: 12
      fontFamily: "Microsoft YaHei"
      color: "$text"
      lineHeight: 1.55
      align: [left, top]
      text: |
        <p><strong>1.</strong> Ground ≥ 60% of any page; primary ≤ 10%.</p>
        <p><strong>2.</strong> One typeface for display, one for body; no exceptions.</p>
        <p><strong>3.</strong> Images: one subject, high contrast, no collage.</p>
        <p><strong>4.</strong> The numeral is the only recurring decoration.</p>
        <p><strong>5.</strong> No gradients, shadows, or second accent.</p>
  - elementId: system-credit
    elementType: text
    bounds: [64, 500, 832, 18]
    content:
      fontSize: 9
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      align: [left, middle]
      text: "Palette and type are proposal decisions; product photography to be commissioned separately."
