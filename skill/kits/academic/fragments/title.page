pageType: cover
background:
  type: solid
  color: "$bg"
elements:
  - elementId: cover-field
    elementType: shape
    bounds: [688, 0, 272, 540]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: cover-kicker
    elementType: text
    bounds: [64, 72, 480, 24]
    content:
      fontSize: 12
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      letterSpacing: 2
      align: [left, middle]
      text: THESIS DEFENSE · 2026
  - elementId: cover-title
    elementType: text
    bounds: [64, 132, 560, 170]
    content:
      fontSize: 46
      fontFamily: "Source Han Serif CN"
      color: "$text"
      bold: true
      lineHeight: 1.12
      align: [left, top]
      text: |
        Separating mechanism
        from exposure in
        long-run outcomes
  - elementId: cover-subtitle
    elementType: text
    bounds: [64, 326, 520, 52]
    content:
      fontSize: 17
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      lineHeight: 1.4
      align: [left, top]
      text: A 12-year panel study of 48 districts, with pre-registered measures and replication.
  - elementId: cover-author
    elementType: text
    bounds: [64, 414, 520, 60]
    content:
      fontSize: 13
      fontFamily: "Microsoft YaHei"
      color: "$text"
      lineHeight: 1.5
      align: [left, top]
      text: |
        <p><strong>Lin Wei</strong> · School of Social Sciences</p>
        <p>Committee: Prof. A. Chen, Prof. M. Ito, Dr. R. Okafor</p>
  - elementId: cover-date
    elementType: text
    bounds: [64, 486, 520, 20]
    content:
      fontSize: 11
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      align: [left, middle]
      text: 12 June 2026 · Room B204
  - elementId: cover-index
    elementType: text
    bounds: [744, 440, 160, 64]
    content:
      fontSize: 44
      fontFamily: "Source Han Serif CN"
      color: "#FFFFFF"
      align: [right, bottom]
      text: "01"
