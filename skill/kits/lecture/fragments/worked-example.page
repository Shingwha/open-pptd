pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: ex-kicker
    elementType: text
    bounds: [64, 40, 420, 20]
    content:
      fontSize: 11
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      letterSpacing: 2
      align: [left, middle]
      text: WORKED EXAMPLE · CH. 4
  - elementId: ex-title
    elementType: text
    bounds: [64, 68, 832, 44]
    content:
      fontSize: 30
      fontFamily: "MiSans"
      color: "$text"
      bold: true
      lineHeight: 1.2
      align: [left, middle]
      text: Why the unit check catches the error
  - elementId: ex-prompt-panel
    elementType: shape
    bounds: [64, 132, 392, 180]
    shapeName: rect
    fill: {type: solid, color: "$primarySoft"}
  - elementId: ex-prompt-label
    elementType: text
    bounds: [84, 146, 352, 18]
    content:
      fontSize: 11
      fontFamily: "Microsoft YaHei"
      color: "$primary"
      letterSpacing: 1.6
      align: [left, middle]
      text: PROMPT
  - elementId: ex-prompt-text
    elementType: text
    bounds: [84, 172, 352, 124]
    content:
      fontSize: 16
      fontFamily: "Microsoft YaHei"
      color: "$text"
      lineHeight: 1.5
      align: [left, top]
      text: A pump moves 12 L/min. How long does it take to fill a 0.8 m³ tank? Round to the nearest minute.
  - elementId: ex-move-label
    elementType: text
    bounds: [488, 132, 408, 18]
    content:
      fontSize: 11
      fontFamily: "Microsoft YaHei"
      color: "$primary"
      letterSpacing: 1.6
      align: [left, middle]
      text: THE EXPERT MOVE
  - elementId: ex-move-1
    elementType: text
    bounds: [488, 162, 408, 52]
    content:
      fontSize: 16
      fontFamily: "Microsoft YaHei"
      color: "$text"
      lineHeight: 1.45
      align: [left, top]
      text: 01  Convert cubic metres to litres before dividing.
  - elementId: ex-move-2
    elementType: text
    bounds: [488, 222, 408, 52]
    content:
      fontSize: 16
      fontFamily: "Microsoft YaHei"
      color: "$text"
      lineHeight: 1.45
      align: [left, top]
      text: 02  Write the unit beside every number in the chain.
  - elementId: ex-move-3
    elementType: text
    bounds: [488, 282, 408, 52]
    content:
      fontSize: 16
      fontFamily: "Microsoft YaHei"
      color: "$text"
      lineHeight: 1.45
      align: [left, top]
      text: "03  Sanity-check the size: 800 L ÷ 12 L/min ≈ 67 min."
  - elementId: ex-result-panel
    elementType: shape
    bounds: [64, 340, 832, 88]
    shapeName: rect
    fill: {type: solid, color: "#FFFFFF"}
    border: {style: solid, width: 1, color: "$line"}
  - elementId: ex-result-label
    elementType: text
    bounds: [84, 352, 120, 18]
    content:
      fontSize: 11
      fontFamily: "Microsoft YaHei"
      color: "$primary"
      letterSpacing: 1.6
      align: [left, middle]
      text: RESULT
  - elementId: ex-result-text
    elementType: text
    bounds: [84, 376, 792, 40]
    content:
      fontSize: 19
      fontFamily: "Microsoft YaHei"
      color: "$text"
      lineHeight: 1.4
      align: [left, middle]
      text: "0.8 m³ = 800 L → 800 ÷ 12 ≈ 67 minutes (1 h 07 min)."
  - elementId: ex-note
    elementType: text
    bounds: [64, 444, 760, 36]
    content:
      fontSize: 13
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      lineHeight: 1.4
      align: [left, top]
      text: "Simplified example: the tank starts empty and the flow rate is constant."
  - elementId: ex-source
    elementType: text
    bounds: [64, 504, 760, 18]
    content:
      fontSize: 11
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      align: [left, middle]
      text: "Source: course notes §4.2, worked problem 3; rounded to two significant figures."
  - elementId: ex-page
    elementType: text
    bounds: [900, 504, 28, 18]
    content:
      fontSize: 11
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      align: [right, middle]
      text: "04"
