pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: actions-title
    elementType: text
    bounds: [64, 44, 832, 56]
    content:
      fontSize: 30
      fontFamily: "MiSans"
      color: "$text"
      bold: true
      lineHeight: 1.2
      align: [left, top]
      text: Three moves close the renewal gap by Q4
  - elementId: actions-table
    elementType: table
    bounds: [64, 124, 832, 300]
    columnWidths: [0.4, 0.18, 0.16, 0.26]
    rowHeights: [0.16, 0.168, 0.168, 0.168, 0.168, 0.168]
    style: "$default"
    rows:
      - - text: "Action"
        - text: "Owner"
        - text: "Due"
        - text: "Done when"
      - - text: "Cap Q3 discounts at 8%"
        - text: "CFO"
        - text: "15 Jul 2026"
        - text: "Policy live in CRM"
      - - text: "Run EMEA renewal sprint"
        - text: "VP Sales"
        - text: "31 Aug 2026"
        - text: "12 of 15 renewals signed"
      - - text: "Rebuild pipeline coverage to 2.5×"
        - text: "CRO"
        - text: "30 Sep 2026"
        - text: "Coverage ≥2.5× at month end"
      - - text: "Publish margin bridge by account"
        - text: "FP&A"
        - "2026-07-10"
        - text: "Monthly review deck"
      - - text: "Close EMEA pricing exception log"
        - text: "Sales Ops"
        - text: "31 Jul 2026"
        - text: "Zero open exceptions"
  - elementId: actions-note
    elementType: text
    bounds: [64, 440, 832, 44]
    content:
      fontSize: 13
      fontFamily: "Microsoft YaHei"
      color: "$text"
      lineHeight: 1.4
      align: [left, top]
      text: "Resource needed: one temporary analyst in FP&A for six weeks. Dependency: CRM policy change must ship before the sprint starts."
  - elementId: actions-source
    elementType: text
    bounds: [64, 500, 832, 18]
    content:
      fontSize: 9
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      align: [left, middle]
      text: "Source: Q2 FY2026 review, actions agreed 24 June 2026; owners confirmed by the operating committee."
