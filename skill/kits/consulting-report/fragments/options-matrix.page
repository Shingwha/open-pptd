pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: matrix-title
    elementType: text
    bounds: [64, 44, 832, 64]
    content:
      fontSize: 28
      fontFamily: "MiSans"
      color: "$text"
      bold: true
      lineHeight: 1.22
      align: [left, top]
      text: Partnership wins on speed and risk; direct entry wins only on long-run margin
  - elementId: options-table
    elementType: table
    bounds: [64, 128, 832, 288]
    columnWidths: [0.28, 0.24, 0.24, 0.24]
    rowHeights: [0.16, 0.168, 0.168, 0.168, 0.168, 0.168]
    style: "$default"
    rows:
      - - text: "Criterion"
        - text: "Direct entry"
        - text: "Partner (recommended)"
        - text: "No entry"
      - - text: "Time to revenue"
        - text: "24–30 months"
        - text: "9–12 months"
        - text: "0"
      - - text: "Capital at risk"
        - text: "High (USD 18m)"
        - text: "Low (USD 4m)"
        - text: "None"
      - - text: "Control of brand"
        - text: "Full"
        - text: "Shared"
        - text: "—"
      - - text: "Long-run margin"
        - text: "22–26%"
        - text: "15–18%"
        - text: "0"
      - - text: "Reversal cost"
        - text: "High"
        - text: "Moderate"
        - text: "Low"
  - elementId: matrix-reading
    elementType: text
    bounds: [64, 434, 832, 44]
    content:
      fontSize: 13
      fontFamily: "Microsoft YaHei"
      color: "$text"
      lineHeight: 1.4
      align: [left, top]
      text: "Decisive criterion: time to revenue under a 12-month board mandate. Partnership gives 80% of the long-run margin at 22% of the capital and one-third of the time."
  - elementId: matrix-source
    elementType: text
    bounds: [64, 498, 832, 18]
    content:
      fontSize: 9
      fontFamily: "Microsoft YaHei"
      color: "$muted"
      align: [left, middle]
      text: "Source: client P&L (FY2023–FY2025); partner term sheet (June 2026); author's model. Margins are EBIT ranges, not forecasts."
