pageType: content
background: {type: solid, color: "#FFFFFF"}
elements:
  - elementId: t1
    elementType: text
    bounds: [60, 60, 400, 40]
    content:
      style: "$title"
      text: 柱状图
  - elementId: c1
    elementType: chart
    bounds: [60, 140, 800, 340]
    data:
      cols: [月份, 营收, 成本]
      rows:
        - [1月, 860, 620]
        - [2月, 920, 640]
        - [3月, 980, 700]
        - [4月, 1050, 720]
    series:
      - type: bar
        encode: {x: 月份, y: 营收}
        name: 营收
      - type: bar
        encode: {x: 月份, y: 成本}
        name: 成本
