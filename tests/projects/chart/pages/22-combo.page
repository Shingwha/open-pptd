pageType: content
background: {type: solid, color: "#FFFFFF"}
elements:
  - elementId: t1
    elementType: text
    bounds: [60, 40, 500, 40]
    content:
      style: "$title"
      text: 组合图表（多类型混排 + 双轴）
  - elementId: c1
    elementType: chart
    bounds: [60, 110, 400, 350]
    data:
      cols: [月份, 销售额, 增长率]
      rows:
        - [1月, 860, 0.12]
        - [2月, 920, 0.07]
        - [3月, 980, 0.065]
        - [4月, 1050, 0.071]
    series:
      - type: bar
        encode: {x: 月份, y: 销售额}
        name: 销售额
      - type: line
        encode: {x: 月份, y: 增长率}
        name: 增长率
        lineColor: "#EF4444"
        lineStyle: dash
        marker: {shape: circle, size: 5}
        dataLabels: {content: value, numberFormat: "0.0%"}
        yAxisIndex: 1
    yAxis:
      - {title: 销售额}
      - {title: 增长率, label: {numberFormat: "0%"}, max: 0.2}
    title: {text: "柱+线双轴", fontSize: 12}
  - elementId: c2
    elementType: chart
    bounds: [500, 110, 380, 350]
    data:
      cols: [季度, 线上, 线下, 占比]
      rows:
        - [Q1, 120, 80, 0.4]
        - [Q2, 132, 95, 0.42]
        - [Q3, 101, 110, 0.478]
        - [Q4, 134, 120, 0.472]
    series:
      - type: bar
        encode: {x: 季度, y: 线上}
        name: 线上
        stack: value
      - type: bar
        encode: {x: 季度, y: 线下}
        name: 线下
        stack: value
      - type: line
        encode: {x: 季度, y: 占比}
        name: 线上占比
        lineColor: "#10B981"
        marker: {shape: diamond, size: 6}
        yAxisIndex: 1
    yAxis:
      - {}
      - {min: 0, max: 0.6, label: {numberFormat: "0%"}}
    title: {text: "堆叠柱+占比线", fontSize: 12}
