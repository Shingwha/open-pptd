pageType: content
background: {type: solid, color: "#FFFFFF"}
elements:
  - elementId: t1
    elementType: text
    bounds: [60, 40, 500, 40]
    content:
      style: "$title"
      text: chartEx 样式与轴标题（I27/I28 锁形态）
  # 瀑布：标题/图例样式透传（I27）+ 轴标题映射（I28）
  - elementId: c1
    elementType: chart
    bounds: [60, 110, 270, 350]
    data:
      cols: [月份, 变动, isTotal]
      rows:
        - [期初, 120, true]
        - [Q1, 35, false]
        - [Q2, -20, false]
        - [Q3, 45, false]
        - [期末, 180, true]
    series:
      - type: waterfall
        encode: {category: 月份, value: 变动, isTotal: isTotal}
        name: 现金流
    title: {text: "现金流瀑布", fontSize: 13, color: "#1D4ED8"}
    legend: {position: bottom, fontSize: 10, color: "#374151"}
    xAxis: {title: {text: 报告期}}
    yAxis: {title: {text: 金额（万元）}}
  # treemap：标题/图例样式透传（I27）
  - elementId: c2
    elementType: chart
    bounds: [350, 110, 270, 350]
    data:
      cols: [节点, 值, 父]
      rows:
        - [总部, 100, null]
        - [研发, 40, 总部]
        - [市场, 35, 总部]
        - [运营, 25, 总部]
    series:
      - type: treemap
        encode: {category: 节点, value: 值, parent: 父}
        name: 预算
        levels: 2
        fill: "#2563EB"
    title: {text: "预算树图", fontSize: 12, color: "#7C3AED"}
    legend: {position: top}
  # sunburst：标题样式透传（I27）
  - elementId: c3
    elementType: chart
    bounds: [640, 110, 270, 350]
    data:
      cols: [节点, 值, 父]
      rows:
        - [全系, 90, null]
        - [硬件, 50, 全系]
        - [软件, 40, 全系]
    series:
      - type: sunburst
        encode: {category: 节点, value: 值, parent: 父}
        name: 产品
        levels: 2
        fill: "#0EA5E9"
    title: {text: "产品旭日", fontSize: 12, fontFamily: "SimHei"}
