pageType: content
background: {type: solid, color: "#FFFFFF"}
elements:
  - elementId: t1
    elementType: text
    bounds: [60, 40, 400, 40]
    content:
      style: "$title"
      text: 次轴（yAxisIndex=1 → 右侧数值轴）
  - elementId: c1
    elementType: chart
    bounds: [60, 100, 800, 380]
    data:
      cols: [月份, 营收, 增长率]
      rows:
        - [1月, 860, 12]
        - [2月, 920, 15]
        - [3月, 980, 8]
        - [4月, 1050, 20]
    series:
      - type: bar
        encode: {x: 月份, y: 营收}
        name: 营收（万元）
        fill: "$primary"
      - type: line
        encode: {x: 月份, y: 增长率}
        name: 增长率（%）
        yAxisIndex: 1
        lineColor: "#EF4444"
        marker: {shape: circle, size: 5}
        lineStyle: dash
    yAxis:
      - {type: value, title: 营收（万元）}
      - {type: value, title: 增长率（%）, max: 100}
    dataLabels: {content: value, fontSize: 9}
