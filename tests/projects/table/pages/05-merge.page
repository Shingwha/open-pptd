pageType: content
background: {type: solid, color: "#FFFFFF"}
elements:
  - elementId: t1
    elementType: text
    bounds: [60, 36, 600, 40]
    content:
      style: "$title"
      text: 合并单元格（rowSpan / colSpan，官方省略规则）
  - elementId: t2
    elementType: text
    bounds: [60, 80, 500, 24]
    content:
      style: "$caption"
      text: 左上 2×2 合并：row1 被占位省略 → 只剩 1 个元素（官方示例）
  - elementId: tb1
    elementType: table
    bounds: [60, 108, 700, 220]
    columnWidths: [0.34, 0.33, 0.33]
    style: "$default"
    rows:
      # Row 0: top-left 2×2 merge + C1（合并覆盖 (0,1)，row0 只有 2 项）
      - - text: "合并单元格（2×2）"
          fill: {type: solid, color: "$accent"}
          rowSpan: 2
          colSpan: 2
        - text: "C1"
      # Row 1: (1,0) 与 (1,1) 被合并覆盖 → 只剩 (1,2)
      - - text: "C2"
      # Row 2: 全三列
      - - text: "A3"
        - text: "B3"
        - text: "C3"
  - elementId: t3
    elementType: text
    bounds: [60, 336, 500, 24]
    content:
      style: "$caption"
      text: 跨 3 列表头分组 + 左列跨 2 行
  - elementId: tb2
    elementType: table
    bounds: [60, 364, 700, 140]
    columnWidths: [0.34, 0.33, 0.33]
    style: "$default"
    rows:
      - - text: "分组标题（跨 3 列）"
          fill: {type: solid, color: "$primary"}
          color: "#FFFFFF"
          bold: true
          colSpan: 3
      # 左列 (1,0) 跨 2 行 → row1 覆盖 (1,0)，row1 还剩 (1,1)(1,2)
      - - text: "左列（跨 2 行）"
          rowSpan: 2
          fill: {type: solid, color: "$primarySoft"}
        - text: "数据 1"
        - text: "数据 2"
      # row2 的 (2,0) 被覆盖 → 只剩 (2,1)(2,2)
      - - text: "数据 3"
        - text: "数据 4"
