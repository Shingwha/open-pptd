version: v2
title: 组件隔离测试（每页一个组件类型）
size: [960, 540]
theme:
  colors:
    primary: "#2563EB"
    accent: "#F59E0B"
    text: "#1F2937"
    muted: "#6B7280"
    bg: "#FFFFFF"
  textStyles:
    title:
      fontSize: 28
      color: "$primary"
      bold: true
pages:
  - pages/01-text-basic.page
  - pages/02-text-rich.page
  - pages/03-text-list.page
  - pages/04-text-link.page
  - pages/05-formula.page
  - pages/06-text-effects.page
  - pages/07-text-transform.page
  - pages/08-icon.page
  - pages/09-shape.page
  - pages/10-line.page
  - pages/11-image.page
  - pages/12-table.page
  - pages/13-chart-bar.page
  - pages/14-chart-pie.page
