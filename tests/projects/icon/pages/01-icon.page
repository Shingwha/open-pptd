pageType: content
background: {type: solid, color: "#FFFFFF"}
elements:
  - elementId: t1
    elementType: text
    bounds: [60, 60, 500, 40]
    content:
      style: "$title"
      text: 图标（Font Awesome Free）
  - elementId: i-solid
    elementType: icon
    bounds: [60, 140, 64, 64]
    iconName: "fas:lightbulb"
    fill: {type: solid, color: "$primary"}
  - elementId: i-brand
    elementType: icon
    bounds: [150, 140, 64, 64]
    iconName: "fab:github"
    fill: {type: solid, color: "$text"}
  - elementId: i-regular
    elementType: icon
    bounds: [240, 140, 64, 64]
    iconName: "far:heart"
    fill: {type: solid, color: "$danger"}
  - elementId: i-gradient
    elementType: icon
    bounds: [330, 130, 80, 80]
    iconName: "fas:rocket"
    fill:
      type: gradient
      gradientType: linear
      angle: 45
      stops:
        - {position: 0, color: "$primary"}
        - {position: 1, color: "$accent"}
  - elementId: i-alias
    elementType: icon
    bounds: [440, 140, 64, 64]
    iconName: "fas:home"
    fill: {type: solid, color: "$success"}
