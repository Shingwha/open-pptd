version: v2
title: "图标组件测试（bs: / fas: / far: / fab:）"
size: [960, 540]
theme:
  colors:
    primary: "#2563EB"
    accent: "#F59E0B"
    text: "#1F2937"
    muted: "#6B7280"
    bg: "#FFFFFF"
    success: "#16A34A"
    warning: "#D97706"
    danger: "#DC2626"
    primarySoft: "#EFF6FF"
  textStyles:
    title:
      fontSize: 22
      color: "$primary"
      bold: true
pages:
  - pages/01-icon.page
  - pages/02-colors.page
